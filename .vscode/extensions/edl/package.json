{
  "name": "edl",
  "displayName": "EDL (English Description Language)",
  "description": "Syntax highlighting for MIXR EDL configuration files",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "edl",
        "aliases": [
          "EDL",
          "edl"
        ],
        "extensions": [
          ".edl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "edl",
        "scopeName": "source.edl",
        "path": "./syntaxes/edl.tmLanguage.json"
      }
    ]
  }
}
