<?xml version="1.0"?>
<!--
  Partida automatica dos motores (aeronave a pistao).

  POR QUE ISTO EXISTE: o JSBSimModel do MIXR nunca escreve
  'propulsion/set-running' nem mexe em magneto/mistura/partida (confirmado
  com `strings libmixr_models.so`). Numa TURBINA isso passa despercebido,
  porque o FGTurbine parte com o vento relativo em voo; num motor a PISTAO
  o resultado e uma aeronave planando desde o primeiro frame (medido:
  thrust = 0 lb, velocidade caindo de 160 para 80 kts em 40 s, com o
  altitude hold empinando o nariz para compensar).

  Como models::JSBSimModel e 'final' e nao expoe a FGFDMExec, nao da para
  corrigir por heranca. A alavanca que sobra e a DATA da aeronave.

  Escrever 'propulsion/set-running' aqui nao serve: um canal do FCS roda a
  cada frame e reinicializaria o motor sempre (medido: empuxo oscilando
  entre valores negativos e 900 lb). O que este canal faz e o mesmo que um
  piloto faria e que e IDEMPOTENTE: magnetos em "both", mistura rica e
  partida acionada. Com a helice em moulinet a 140 kts, o motor pega e
  permanece rodando.
-->
<system name="engine-autostart">
  <channel name="Autostart">

    <fcs_function name="propulsion/magneto-auto-0">
      <function><value>3.0</value></function>
      <output>propulsion/magneto_cmd</output>
    </fcs_function>

    <fcs_function name="propulsion/starter-auto">
      <function><value>1.0</value></function>
      <output>propulsion/starter_cmd</output>
    </fcs_function>

    <fcs_function name="propulsion/mixture-auto-0">
      <function><value>1.0</value></function>
      <output>fcs/mixture-cmd-norm[0]</output>
    </fcs_function>

    <fcs_function name="propulsion/mixture-auto-1">
      <function><value>1.0</value></function>
      <output>fcs/mixture-cmd-norm[1]</output>
    </fcs_function>

    <fcs_function name="propulsion/running-auto-0">
      <function><value>1.0</value></function>
      <output>propulsion/engine[0]/set-running</output>
    </fcs_function>

    <fcs_function name="propulsion/running-auto-1">
      <function><value>1.0</value></function>
      <output>propulsion/engine[1]/set-running</output>
    </fcs_function>

  </channel>
</system>
