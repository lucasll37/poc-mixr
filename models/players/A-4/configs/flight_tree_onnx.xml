<!--
  A arvore de DEPLOY da politica de RL.

  A de PRODUCAO (flight_tree.xml) fica intocada, de proposito: esta e um
  arquivo a mais, apontado por 'treeFile:' de um cenario que queira rodar a
  politica treinada em vez das regras escritas a mao. Trocar de politica e
  trocar arquivo - nao recompilar.

  O Fallback tem DOIS ramos, e a ordem importa:

    1) OnnxPolicy - a politica treinada. Se o .onnx carregar e inferir, ela
       comanda e o Fallback para aqui.
    2) Patrol     - a rede de seguranca. So roda se a politica FALHAR
       (arquivo ausente, forma errada, erro de inferencia). Sem ela, uma
       politica quebrada deixaria a aeronave sem comando nenhum.

  Note o que NAO esta aqui: o piso anti-CFIT. ACHADO POR AUDITORIA,
  CORRIGIDO (nao redescobrir): este comentario afirmava que um
  AltitudeSafetyBehavior sempre concorre por VOTO no UbfArbiter do cenario
  (90 contra os 50 do BtBehavior) protegendo esta arvore - nao e mais
  verdade para o consumidor atual (src/poc/onnx-policy, que tambem carrega
  este arquivo por copia). O cenario de producao dele NAO declara mais
  UbfArbiter/AltitudeSafetyBehavior, so ( BtBehavior ) direto. Enquanto o
  .onnx carrega e infere com sucesso, A REDE tem a ultima palavra sobre
  altitude; uma politica ruim NAO e mais contida por um piso independente.
  `terrainClearance:` do proprio BtBehavior so entra em jogo se o .onnx
  FALHAR ao carregar e o Fallback cair no ramo Patrol abaixo.

  O caminho do modelo e o de INSTALACAO (dist/share/mixr-plugins/flight/), a
  mesma convencao do proprio flight_tree.xml e do rootDir: do JSBSim.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="root">

      <OnnxPolicy model="./dist/share/mixr-plugins/flight/policy_example.onnx"
                  normalized="true"
                  label="ONNX"/>

      <Patrol/>

    </Fallback>
  </BehaviorTree>
  <TreeNodesModel>
        <Action ID="OnnxPolicy">
            <input_port name="label" type="std::string" default="ONNX">rotulo no dump e no quadro</input_port>
            <input_port name="normalized" type="bool" default="1">true: saida em [-1,1], desnormalizada aqui (export do SB3)</input_port>
            <input_port name="model" type="std::string">caminho do .onnx da politica</input_port>
        </Action>
        <Condition ID="OnnxScore">
            <input_port name="above" type="bool" default="1">true: SUCCESS se saida &gt; limiar; false: se saida &lt; limiar</input_port>
            <input_port name="index" type="int" default="0">qual saida do modelo comparar</input_port>
            <input_port name="threshold" type="double" default="0.500000">limiar de comparacao</input_port>
            <input_port name="model" type="std::string">caminho do .onnx (entrada float32[1,28], ver ObservationFields.hpp)</input_port>
        </Condition>
        <Action ID="Navigate"/>
        <Action ID="SupportAlert"/>
        <Action ID="ReportAndEvade"/>
        <Action ID="ReturnToBase"/>
        <Action ID="PyDecide">
            <input_port name="label" type="std::string" default="PY">rotulo no dump e no quadro</input_port>
            <input_port name="script" type="std::string">caminho do .py que define decide(obs)</input_port>
        </Action>
        <Condition ID="FuelLow">
            <input_port name="margin" type="double" default="0.000000">margem somada a reserva de combustivel (fracao 0..1)</input_port>
        </Condition>
        <Condition ID="ContactDetected"/>
        <Action ID="Patrol"/>
        <Condition ID="AlertReceived"/>
    </TreeNodesModel>
</root>
