<?xml version="1.0"?>
<!--

  Autopilot do A-4 desta PoC-mixr, adaptado de aircraft/c310/c310ap.xml.

  POR QUE ESTE ARQUIVO EXISTE: mixr::models::JSBSimModel comanda a aeronave
  escrevendo em 'ap/heading_hold'/'ap/heading_setpoint',
  'ap/altitude_hold'/'ap/altitude_setpoint' e
  'ap/airspeed_hold'/'ap/airspeed_setpoint' (JSBSimModel.cpp) - e so os
  amarra (propMgr->HasNode(...)) se essas propriedades ja existirem no
  modelo JSBSim, isto e, se a aeronave tiver um <autopilot> proprio. O A-4
  distribuido de fabrica (Aeromatic) nao tem nenhum - por isso este
  arquivo, no MESMO papel que c310ap.xml ja cumpre para o Cessna 310.

  A estrutura dos canais de rolagem/proa e GENERICA (opera sobre
  attitude/phi-rad, attitude/heading-true-rad - nenhuma delas e especifica
  de airframe) e foi mantida como no c310ap.xml. O que muda, e por isso:

  1. Canal de altitude: a lei "ROC = 25.70 - h/833.33" do c310ap.xml
     modela o desempenho de SUBIDA do Cessna 310 (max ~1542 ft/min ao
     nivel do mar, chegando a zero por volta de 21.400 ft) - literal
     demais para copiar. Trocada por uma lei equivalente calibrada no J52
     (~11.200 lb de empuxo militar / ~22.500 lb de peso maximo): ROC
     (ft/seg) = 130 - h/380, ~7800 ft/min ao nivel do mar chegando a zero
     por volta de 49.400 ft (bem acima do teto pratico real do A-4,
     ~42.250 ft - de proposito: e so o ponto em que a LEI do autopilot
     para de comandar subida, nao um limite fisico da celula).
  2. Ganhos de arfagem/rolagem MENORES que os do c310ap.xml: o A-4 cruza a
     ~350-430 kt contra ~160-190 kt do C-310, e a autoridade de um
     profundor/aileron (momento gerado por grau de deflexao) cresce com a
     pressao dinamica (~V^2) - os MESMOS ganhos do c310ap.xml sobre esta
     celula, mais rapida, oscilavam (medido rodando). Ver a nota grande
     abaixo, "LIMITE CONHECIDO", para o ajuste fino que isso ainda exige.
  3. Motor UNICO (J52), nao par - o canal de autothrottle perdeu o
     'ap/throttle-command-right' que espelhava o comando pro motor[1] do
     C-310 (aqui nao existe motor[1]).
  4. Um SAS (stability augmentation system) que o c310ap.xml NAO tem:
     amortecedores de taxa em rolagem/arfagem (fcs/roll-rate-damper,
     fcs/pitch-rate-damper) e um nivelador de asas sempre ativo
     (fcs/wing-leveler-always-on) - nenhum gateado por ap/heading_hold ou
     ap/altitude_hold. Ver "LIMITE CONHECIDO" abaixo para o porque.

  As mesmas ressalvas do c310ap.xml aplicam: 'gear/unit[2]/WOW' e
  'gear/unit/WOW' so importam em solo, e nenhum cenario desta PoC-mixr
  pousa - o ramo "no ar" (WOW == 0) e o unico exercitado.

  LIMITE CONHECIDO, medido rodando, nao redescoberto: os coeficientes
  latero-direcionais do proprio A4.xml (Clb=-0.1 Cnr=-0.15 Clr=0.15
  Cnb=0.12) violam o criterio classico de estabilidade em espiral
  (Clb*Cnr < Clr*Cnb) - uma instabilidade em espiral REAL do dado
  aerodinamico Aeromatic, nao um bug de wiring. Somado a JSBSimModel::
  reset() nao rodar FGTrim (a aeronave nasce destrimada), a celula
  diverge em rolagem/arfagem em poucos segundos SEM o SAS acima, mesmo
  com o piloto automatico inteiro desligado (confirmado isolando: mesma
  divergencia com headingHoldMode/altitudeHoldMode/velocityHoldMode todos
  false). Duas configuracoes de ganho foram medidas, e nenhuma resolve as
  duas pontas ao mesmo tempo:
    (a) nivelador forte (-10) + heading-pi fraco (kp=0.5) satura o
        nivelador e a aeronave praticamente NAO CONSEGUE mais virar -
        confirmado rodando o cenario com intruso: bt=EVADE/BREAK dispara
        certinho, mas o rumo mal se move (90 -> 89 em 40 s).
    (b) heading-pi mais forte (os valores ATUAIS deste arquivo) faz a
        aeronave virar de verdade (bt=EVADE tira ~15 graus em 40 s; o
        teste 'plugin-hotswap', que troca o SENTIDO da curva de patrulha,
        enxerga a diferenca) as custas de nao suprimir a espiral por
        tempo indefinido - numa perna de patrulha reta e longa (45-60 s
        de producao), o banco AINDA cresce lentamente depois de ~60-90 s.
  Escolhido (b): um piloto automatico que nao vira e pior que um que
  deriva devagar. Recalibrar o SAS (ou reexportar a aeronave com Clr/Cnb
  ajustados para estabilidade em espiral positiva) fica registrado como
  trabalho futuro. O determinismo (mesmo resultado em 1/2/4 threads) NAO
  e afetado por nenhuma das duas configuracoes - e a mesma fisica
  deterministica rodando, so calibrada diferente.
-->
<autopilot name="A-4 Autopilot">

<!-- INTERFACE PROPERTIES -->

  <property>ap/attitude_hold</property>
  <property>ap/altitude_hold</property>
  <property>ap/heading_hold</property>
  <property>ap/yaw_damper</property>
  <property>ap/active-waypoint</property>
  <property>ap/altitude_setpoint</property>
  <property>ap/heading_setpoint</property>
  <property>ap/heading-setpoint-select</property>
  <property>ap/aileron_cmd</property>
  <property>ap/elevator_cmd</property>
  <property>ap/rudder_cmd</property>
  <property>ap/airspeed_setpoint</property>
  <property>ap/airspeed_hold</property>
  <property>ap/throttle-cmd-norm</property>

<!--
=====================================================
ROLL CHANNEL
=====================================================
-->

<!-- Wing leveler -->

<channel name="AP roll wing leveler">

  <switch name="fcs/wing-leveler-ap-on-off">
    <default value="-1"/>
    <test value="0">
      ap/attitude_hold == 1
    </test>
  </switch>

  <pid name="fcs/roll-ap-error-pid">
    <input>attitude/phi-rad</input>
    <kp> ap/roll-pid-kp </kp>
    <ki> ap/roll-pid-ki </ki>
    <kd> ap/roll-pid-kd </kd>
    <trigger> fcs/wing-leveler-ap-on-off </trigger>
  </pid>

  <switch name="fcs/roll-ap-autoswitch">
    <default value="0.0"/>
    <test value="-fcs/roll-ap-error-pid">
      ap/attitude_hold == 1
    </test>
  </switch>

  <pure_gain name="fcs/roll-ap-aileron-command-normalizer">
     <input>fcs/roll-ap-autoswitch</input>
     <gain>-1</gain>
  </pure_gain>

</channel>

<!-- Heading hold -->

<channel name="AP Roll Heading Hold">

  <switch name="fcs/heading-setpoint-selector">
    <default value="ap/heading_setpoint"/>
    <test value="guidance/wp-heading-deg">
      ap/heading-setpoint-select == 1
    </test>
  </switch>

  <pure_gain name="fcs/heading-true-degrees">
    <input>attitude/heading-true-rad</input>
    <gain>57.3</gain> <!-- convert to degrees -->
  </pure_gain>

  <summer name="fcs/heading-error">
    <input> -fcs/heading-true-degrees</input>
    <input> fcs/heading-setpoint-selector </input>
  </summer>

  <switch name="fcs/heading-error-bias-switch">
    <default value="0.0"/>
    <test value="360.0">
      fcs/heading-error lt -180
    </test>
    <test value="-360.0">
      fcs/heading-error gt 180
    </test>
  </switch>

  <summer name="fcs/heading-corrected">
    <input> fcs/heading-error-bias-switch </input>
    <input> fcs/heading-error </input>
    <clipto>
      <min>-30</min>
      <max> 30</max>
    </clipto>
  </summer>

  <pure_gain name="fcs/heading-command">
    <input> fcs/heading-corrected </input>
    <gain> 0.01745 </gain>
  </pure_gain>

  <lag_filter name="fcs/heading-roll-error-lag">
    <input> fcs/heading-command </input>
    <c1> 0.15 </c1>
  </lag_filter>

  <summer name="fcs/heading-roll-error">
    <input> fcs/heading-roll-error-lag </input>
    <input> -attitude/phi-rad </input>
  </summer>

  <switch name="fcs/heading-roll-error-switch">
    <default value="0.0"/>
    <test value="fcs/heading-roll-error">
      ap/heading_hold == 1
    </test>
  </switch>

  <pid name="fcs/heading-pi-controller">
    <input> fcs/heading-roll-error-switch </input>
    <kp> 2.0 </kp>
    <ki> 0.06 </ki>
    <kd> 0.3 </kd>
  </pid>

  <switch name="fcs/roll-command-selector">
    <default value="0.0"/>
    <test value="fcs/heading-pi-controller">
      ap/heading_hold == 1
      gear/unit[2]/WOW == 0
    </test>
    <test value="fcs/roll-ap-aileron-command-normalizer">
      ap/attitude_hold == 1
      gear/unit[2]/WOW == 0
    </test>
    <output>fcs/heading-hold-aileron-cmd</output>
  </switch>

  <!--
  AMORTECEDOR DE ROLAGEM (SAS), SEMPRE ATIVO - nao gateado por
  ap/heading_hold nem ap/attitude_hold. Descoberto rodando, nao previsto:
  esta celula (leve, controles potentes, velocidade alta -> muita pressao
  dinamica) diverge em rolagem mesmo com TODOS os modos de piloto
  automatico desligados e os tres comandos zerados - ou seja, e uma
  propriedade do AIRFRAME nao-trimado (JSBSimModel::reset() roda RunIC()
  mas nao FGTrim; o Cessna 310 tolera isso pelo proprio amortecimento
  aerodinamico, este A-4 nao). A correcao certa seria trimar no reset, mas
  JSBSimModel e 'final' - a alavanca que sobra e amortecer ativamente a
  taxa de rolagem, um SAS classico de caca a jato, direto no aileron,
  independente de qualquer modo de piloto automatico.
  -->
  <pure_gain name="fcs/roll-rate-damper">
    <input> velocities/p-rad_sec </input>
    <gain> -0.6 </gain>
  </pure_gain>

  <!--
  NIVELADOR DE ASAS, SEMPRE ATIVO - o amortecedor de rolagem acima so
  reage a TAXA (p), sem memoria de angulo: sozinho ele elimina a
  ACELERACAO da divergencia mas deixa a celula estabilizar numa taxa de
  rolagem constante e nao-nula (medido rodando: ~0.2 rad/s sustentado,
  banco crescendo linear sem limite). O 'wing leveler' que ja existia no
  arquivo (fcs/roll-ap-error-pid/fcs/roll-ap-autoswitch) so contribui
  quando ap/attitude_hold == 1, que este projeto nunca liga - por isso um
  regulador novo e mais simples, sem gate nenhum: mola proporcional pura
  puxando o angulo de banco de volta a zero, somada ao heading-hold e ao
  amortecedor de taxa acima.
  -->
  <pure_gain name="fcs/wing-leveler-always-on">
    <input> attitude/phi-rad </input>
    <gain> -0.8 </gain>
  </pure_gain>

  <summer name="fcs/aileron-cmd-final">
    <input> fcs/heading-hold-aileron-cmd </input>
    <input> fcs/roll-rate-damper </input>
    <input> fcs/wing-leveler-always-on </input>
    <clipto>
      <min>-1.0</min>
      <max> 1.0</max>
    </clipto>
    <output>ap/aileron_cmd</output>
  </summer>

  <switch name="fcs/roll-command-selector-steering">
    <default value="0.0"/>
    <test value="fcs/heading-pi-controller">
      ap/heading_hold == 1
      gear/unit/WOW == 1
    </test>
    <output>fcs/steer-cmd-norm</output>
  </switch>

</channel>

<!--
=====================================================
PITCH CHANNEL
=====================================================
-->

<!-- Altitude hold -->

<channel name="AP Pitch Altitude hold">

  <summer name="fcs/altitude-error">
    <input> ap/altitude_setpoint </input>
    <input> -position/h-sl-ft </input>
    <clipto>
      <min>-100</min>
      <max> 100</max>
    </clipto>
  </summer>

  <lag_filter name="fcs/alt-error-lag">
    <input> fcs/altitude-error </input>
    <c1> 1 </c1>
  </lag_filter>

  <!--
  Lei de subida do A-4 (J52, ~11.200 lb / ~22.500 lb max): ao nivel do
  mar, 100% de erro (clipado acima) produz 130 ft/seg (~7800 ft/min) de
  ROC comandado, decaindo linearmente ate zero por volta de 49.400 ft.
  Ver a nota no cabecalho deste arquivo para o "porque" dos numeros.
  -->
  <fcs_function name="fcs/hdot-command">
    <input>fcs/alt-error-lag</input>
    <function>
      <quotient>
        <difference>
          <value>130.0</value>
          <quotient>
            <property>position/h-sl-ft</property>
            <value>380.0</value>
          </quotient>
        </difference>
        <value>100.0</value>
      </quotient>
    </function>
  </fcs_function>

  <summer name="fcs/hdot-error">
    <input>fcs/hdot-command</input>
    <input>-velocities/h-dot-fps</input>
  </summer>

  <switch name="fcs/ap-alt-hold-switch">
    <default value="0.0"/>
    <test value="fcs/hdot-error">
      ap/altitude_hold == 1
    </test>
  </switch>

  <!--
  Deadband de anti-windup contra o curso do profundor do A-4 (A4.xml:
  fcs/elevator-pos-rad em [-0.35, 0.30] rad = [-20.1, 17.2] graus, contra
  [-14, 4] graus do c310 - faixa mais ampla e menos assimetrica).
  -->
  <deadband name="fcs/windup-trigger">
    <input> fcs/elevator-pos-deg </input>
    <width>34.0</width>
  </deadband>

  <integrator name="fcs/integral">
    <input> fcs/ap-alt-hold-switch </input>
    <trigger> fcs/windup-trigger </trigger>
    <c1> 0.00012 </c1>
  </integrator>

  <pure_gain name="fcs/proportional">
    <input> fcs/ap-alt-hold-switch </input>
    <gain> 0.0025 </gain>
  </pure_gain>

  <summer name="fcs/control-summer">
    <input> fcs/integral </input>
    <input> fcs/proportional </input>
    <clipto>
      <min>-1.0</min>
      <max> 1.0</max>
    </clipto>
  </summer>

  <pure_gain name="fcs/elevator">
    <input> fcs/control-summer </input>
    <gain> -1.0 </gain>
  </pure_gain>

  <!--
  AMORTECEDOR DE ARFAGEM (SAS), SEMPRE ATIVO - mesmo raciocinio do
  amortecedor de rolagem acima: o A-4 nao-trimado diverge em arfagem por
  conta propria, sem nenhum comando de piloto automatico. Nao gateado por
  ap/altitude_hold.
  -->
  <pure_gain name="fcs/pitch-rate-damper">
    <input> velocities/q-rad_sec </input>
    <gain> 2.5 </gain>
  </pure_gain>

  <pure_gain name="fcs/pitch-attitude-restore">
    <input> attitude/theta-rad </input>
    <gain> 4.0 </gain>
  </pure_gain>

  <summer name="fcs/elevator-cmd-final">
    <input> fcs/elevator </input>
    <input> fcs/pitch-rate-damper </input>
    <input> fcs/pitch-attitude-restore </input>
    <clipto>
      <min>-1.0</min>
      <max> 1.0</max>
    </clipto>
    <output>ap/elevator_cmd</output>
  </summer>

</channel>

<!--
=====================================================
YAW CHANNEL
=====================================================
-->

<!-- Yaw Damper -->

<channel name="Yaw Damper">

   <scheduled_gain name="ap/rudder_control">
      <input> aero/beta-rad </input>
      <table>
        <independentVar lookup="row">velocities/ve-kts</independentVar>
         <tableData>
            30      0.00
            60    -40.00
         </tableData>
      </table>
      <gain>ap/yaw_damper</gain>
      <clipto>
        <min>-1.0</min>
        <max> 1.0</max>
      </clipto>
      <output> ap/rudder_cmd </output>
   </scheduled_gain>

</channel>


<!-- ===========================================================================
     Autothrottle. Mesma razao de ser do canal em c310ap.xml (o A-4 de
     fabrica DECLARA ap/airspeed_setpoint/ap/airspeed_hold mas nao tem
     canal que os implemente) - aqui com UM motor so (J52), nao dois.
     =========================================================================== -->
<channel name="AP Autothrottle">

  <fcs_function name="ap/airspeed-error-kts">
    <function>
      <difference>
        <property>ap/airspeed_setpoint</property>
        <property>velocities/vc-kts</property>
      </difference>
    </function>
  </fcs_function>

  <pid name="ap/throttle-pid">
    <input>ap/airspeed-error-kts</input>
    <kp> 0.010 </kp>
    <ki> 0.0025 </ki>
    <kd> 0.000 </kd>
    <clipto> <min> -1.0 </min> <max> 1.0 </max> </clipto>
  </pid>

  <summer name="ap/throttle-command">
    <input> ap/throttle-pid </input>
    <bias> 0.60 </bias>
    <clipto> <min> 0.0 </min> <max> 1.0 </max> </clipto>
    <output> fcs/throttle-cmd-norm[0] </output>
  </summer>

</channel>

</autopilot>
