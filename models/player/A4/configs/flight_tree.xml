<!--
  Subprojeto 13 - single-thread

  Arvore de comportamento de UM caca. Ela e a politica interna do
  xnative::BtBehavior, que por sua vez e um AbstractBehavior do UBF nativo -
  ou seja, esta arvore concorre POR VOTO com outros comportamentos dentro
  do UbfArbiter declarado no scenario.edl (hoje, com o
  AltitudeSafetyBehavior, que tem voto maior e so age se a aeronave furar
  o piso de altitude).

  Prioridade (Fallback, de cima para baixo):
    1) combustivel abaixo da reserva      -> volta para a base
    2) manobra de evasao valendo          -> quebra E AVISA os outros
    3) alerta recebido de outro caca      -> vai apoiar no ponto avisado
    4) caso contrario                     -> patrulha

  Os itens 2 e 3 sao os dois lados da interacao entre players: quem viu
  transmite (AlertDatalink, fase 1) e quem recebeu reage (fase 3 do frame
  seguinte). Nenhum no fala diretamente com outro aviao.

  ATENCAO AO ITEM 2 - ele NAO e "estou vendo o intruso agora". Os itens 2
  e 3 comandam sentidos OPOSTOS sobre o mesmo objeto (fugir dele / ir ate
  ele), e a propria quebra tira o intruso do setor do radar (+-30 graus,
  contra uma quebra de 110): a pista pisca, e sem tempo minimo de
  permanencia os dois ramos alternam para sempre - observado no Tacview
  como aeronaves "batendo asa", +-25 graus de banco a cada ~12 s.

  Por isso ContactDetected consulta domain::ThreatPolicy::engaged(), que
  continua true por 'evadeHold' segundos depois de a pista sumir. A
  histerese e do MODELO, nao da arvore: trocar o XML nao a desliga.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="root">

      <Sequence name="rtb_sequence">
        <FuelLow margin="0.05"/>
        <ReturnToBase/>
      </Sequence>

      <Sequence name="engage_sequence">
        <ContactDetected/>
        <ReportAndEvade/>
      </Sequence>

      <Sequence name="support_sequence">
        <AlertReceived/>
        <SupportAlert/>
      </Sequence>

      <Patrol/>

    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
        <Action ID="OnnxPolicy">
            <input_port name="label" type="std::string" default="ONNX">rotulo no dump e no quadro</input_port>
            <input_port name="normalized" type="bool" default="1">true: saida em [-1,1], desnormalizada aqui (export do SB3)</input_port>
            <input_port name="model" type="std::string">caminho do .onnx da politica</input_port>
        </Action>
        <Condition ID="OnnxScore">
            <input_port name="above" type="bool" default="1">true: SUCCESS se saida &gt; limiar; false: se saida &lt; limiar</input_port>
            <input_port name="index" type="int" default="0">qual saida do modelo comparar</input_port>
            <input_port name="threshold" type="double" default="0.500000">limiar de comparacao</input_port>
            <input_port name="model" type="std::string">caminho do .onnx (entrada float32[1,28], ver ObservationFields.hpp)</input_port>
        </Condition>
        <Action ID="SupportAlert"/>
        <Action ID="Navigate"/>
        <Action ID="LaunchMissile"/>
        <Condition ID="LaunchEnvelope"/>
        <Action ID="ReportAndEvade"/>
        <Action ID="ReturnToBase"/>
        <Action ID="PyDecide">
            <input_port name="label" type="std::string" default="PY">rotulo no dump e no quadro</input_port>
            <input_port name="script" type="std::string">caminho do .py que define decide(obs)</input_port>
        </Action>
        <Condition ID="FuelLow">
            <input_port name="margin" type="double" default="0.000000">margem somada a reserva de combustivel (fracao 0..1)</input_port>
        </Condition>
        <Condition ID="ContactDetected"/>
        <Action ID="Patrol"/>
        <Condition ID="AlertReceived"/>
    </TreeNodesModel>
</root>
