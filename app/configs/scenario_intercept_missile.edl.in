//
// dashboard -- cenario "Intercepto + Missil"
//
// scenario_intercept.edl.in + falcon1 carregando UM missil guiado (mesmo
// molde de src/poc/dis/single-thread/configs/scenario_missile_demo.edl.in) --
// lancamento/detonacao/destruicao, otimo pra demonstrar pausar/frear bem no
// meio do engajamento. Carrega os DOIS plugins: libflight_tc.so (os 7 nomes
// de sempre, incluindo FlightAgentTC) e libmissile.so (so "GuidedMissile")
// -- ver CLAUDE.md, secao "Demo: missil guiado", para o "porque" de serem
// dois plugins e nao um so.
//
// @NUM_TC_THREADS@ e substituido pelo main.cpp antes do parse.
//

( ClockStation

   tcPriority: 0.5

   ownship: falcon1

   components: {

      plugins: ( PluginLoader
         searchPaths: {
            "./dist/lib/mixr-plugins/"
         }
         modules: {
            ( PluginModule
               file:     "libflight_tc.so"
               provides: { AlertDatalink TacticalAlert ThreadTagProbe FlightAgentTC
                           FlightState BtBehavior AltitudeSafetyBehavior
                           RLBridgeBehavior FlightAction }
            )
            ( PluginModule
               file:     "libmissile.so"
               provides: { GuidedMissile MissileThreadTagProbe }
            )
         }
      )

   } // components (plugins)

   // Esqueleto compartilhado com scenario_patrol.edl.in/
   // scenario_intercept.edl.in -- ver
   // app/configs/fragments/tacview_recorder.edl.frag e
   // app::generateScenario() (ScenarioTemplate.cpp).
   @include:tacview_recorder.edl.frag@

   simulation: ( WorldModel

      numTcThreads: @NUM_TC_THREADS@

      latitude:  -22.25
      longitude: -42.48

      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         falcon1: ( Aircraft
            id: 101
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 5.0 )
            initYPos:     ( NauticalMiles 0.0 )
            initAlt:      ( Meters 1750.0 )
            initHeading:  ( Degrees 90 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )

               // ---------------------------------------------------------
               // O MISSIL -- mesmo molde de scenario_missile_demo.edl.in.
               // UM so, na unica estacao deste StoresMgr. GuidedMissile vem
               // do plugin libmissile.so (ver plugins: acima); StoresMgr
               // (SimpleStoresMgr, ver a armadilha do nome de fabrica no
               // CLAUDE.md) e nativo do MIXR.
               // ---------------------------------------------------------
               stores: ( StoresMgr
                  numStations: 1
                  stores: {
                     1: ( GuidedMissile
                        id: 501
                        side: blue
                        type: "AIM1"
                        signature: ( SigSphere radius: 0.3 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 45 )
                        lethalRange: ( Meters 30 )
                        maxBurstRng: ( Meters 150 )
                        components: {
                           dynamicsModel: ( JSBSimModel
                              rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"
                              model:   "aim1"
                              debugLevel: 0
                           )
                           // sem agente (so guiagem propria) -- sem isto o
                           // missil mostraria '-' na coluna 'thread' da aba
                           // Players, mesma razao do bandit1 (CLAUDE.md).
                           // Nome DIFERENTE do gemeo do flight de proposito:
                           // o registro de plugins recusa a carga se dois
                           // .so's no mesmo processo declararem a MESMA
                           // classe de fabrica.
                           threadTagProbe: ( MissileThreadTagProbe )
                        }
                     )
                  }
               )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior
                           vote: 90
                           minAltitude:      ( Meters 1200 )
                           recoverAltitude:  ( Meters 1750 )
                           recoverSpeed:     160.0
                           minClearance:     ( Meters 400 )
                           recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior
                           vote: 50
                           treeFile: "./models/player/flight/configs/flight_tree_missile_demo.xml"
                           patrolHeading:  ( Degrees 90 )
                           legTime:        ( Seconds 60 )
                           legTurn:        ( Degrees 90 )
                           patrolAltitude: ( Meters 1750 )
                           patrolSpeed:    160.0
                           rtbAltitude:    ( Meters 2050 )
                           rtbSpeed:       170.0
                           arrivalRadius:  ( NauticalMiles 2.0 )
                           fuelReserve:    0.35
                           breakTurn:      ( Degrees 110 )
                           evadeClimb:     ( Meters 700 )
                           evadeSpeed:     185.0
                           terrainClearance: ( Meters 800 )
                           evadeHold:      ( Seconds 30 )
                           supportSpeed:   180.0
                           // Envelope de lancamento -- ver a armadilha confirmada
                           // rodando no CLAUDE.md ("Demo: missil guiado"): o primeiro
                           // contato nesta geometria acontece a ~13.6 NM, e
                           // ReportAndEvade FOGE do contato assim que ele aparece --
                           // um launchMaxRange menor que isso nunca dispara.
                           launchMinRange: ( NauticalMiles 0.8 )
                           launchMaxRange: ( NauticalMiles 20.0 )
                           launchCone:     ( Degrees 60 )
                        )
                     }
                  )
               )
            }
         )

         falcon2: ( Aircraft
            id: 102
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 0.0 )
            initYPos:     ( NauticalMiles 5.0 )
            initAlt:      ( Meters 1850.0 )
            initHeading:  ( Degrees 180 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 1850 )
                           recoverSpeed: 160.0
                           minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading: ( Degrees 180 )  legTime: ( Seconds 60 )
                           legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 1850 )
                           patrolSpeed: 160.0  rtbAltitude: ( Meters 2100 )  rtbSpeed: 170.0
                           arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                           evadeSpeed: 185.0  supportSpeed: 180.0
                           evadeHold: ( Seconds 30 )
                           terrainClearance: ( Meters 800 )
                        )
                     }
                  )
               )
            }
         )

         falcon3: ( Aircraft
            id: 103
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles -5.0 )
            initYPos:     ( NauticalMiles  0.0 )
            initAlt:      ( Meters 2050.0 )
            initHeading:  ( Degrees 270 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.5  maxBankAngle: 33.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2050 )
                           recoverSpeed: 160.0
                           minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading: ( Degrees 270 )  legTime: ( Seconds 45 )
                           legTurn: ( Degrees 120 )  patrolAltitude: ( Meters 2050 )
                           patrolSpeed: 165.0  rtbAltitude: ( Meters 2150 )  rtbSpeed: 170.0
                           arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 130 )  evadeClimb: ( Meters 750 )
                           evadeSpeed: 190.0  supportSpeed: 185.0
                           evadeHold: ( Seconds 30 )
                           terrainClearance: ( Meters 800 )
                        )
                     }
                  )
               )
            }
         )

         falcon4: ( Aircraft
            id: 104
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles  0.0 )
            initYPos:     ( NauticalMiles -5.0 )
            initAlt:      ( Meters 2100.0 )
            initHeading:  ( Degrees 0 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2100 )
                           recoverSpeed: 160.0
                           minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading: ( Degrees 0 )  legTime: ( Seconds 60 )
                           legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 2100 )
                           patrolSpeed: 160.0  rtbAltitude: ( Meters 2200 )  rtbSpeed: 170.0
                           arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                           evadeSpeed: 185.0  supportSpeed: 180.0
                           evadeHold: ( Seconds 30 )
                           terrainClearance: ( Meters 800 )
                        )
                     }
                  )
               )
            }
         )


         // ------------------------------------------------------------------
         // bandit1 -- LOCAL neste cenario (sem 'networks:', ver o topo do
         // arquivo). Mesmo bloco de tests/scenario/make_fixture.py (modo
         // 'intruder') / src/poc/dis/bandit/configs/scenario.edl.
         // ------------------------------------------------------------------
         bandit1: ( Aircraft
            id: 201
            side: red
            type: "C310"
            signature: ( SigSphere radius: 4.0 )
            initXPos:     ( NauticalMiles 12.0 )
            initYPos:     ( NauticalMiles 12.0 )
            initAlt:      ( Meters 2400.0 )
            initHeading:  ( Degrees 225 )
            initVelocity: 92.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               // bandit1 nao tem agente (e' so pilotado pelo Autopilot acima) --
               // sem isto, a coluna 'thread' da aba Players do app fica '-' pra
               // sempre (ver CLAUDE.md, secao xnative::ThreadTagProbe): so
               // reporta a thread do pool T/C que esta processando o player,
               // sem decidir nada.
               threadTagProbe: ( ThreadTagProbe )
            }
         )

      } // players

   ) // simulation

) // station
