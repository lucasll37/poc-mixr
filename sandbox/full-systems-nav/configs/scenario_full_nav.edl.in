//
// full-systems-nav -- o player maximo, navegando de verdade
//
// E o cenario DEFAULT desta poc, alcancado via '-folder <pasta>' do ./app
// (nome da subpasta: "full-systems-nav"):
//
//    ./build/app/src/app -folder ./sandbox -scenario full-systems-nav
//
// POR QUE O ARQUIVO NAO SE CHAMA scenario.edl.in:
// tests/guard/check_falcons_estrutura.sh varre esse nome por glob e exige
// falcon1..4 com o MESMO esqueleto de slots. Este cenario tem UM player so,
// chamado "a4" -- mesmo recurso que built-in_mixr_1 e bandit ja usam
// (nomes proprios de arquivo, fora do glob).
//
// PERGUNTA QUE ESTE ARQUIVO RESPONDE: da para montar o player mais
// elaborado que o framework permite (ver src/poc/built-in_mixr_1) E fazer
// ele voar de verdade pela navegacao nativa -- Route/Steerpoint, com as
// Action de cada ponto disparando -- em vez de uma arvore de patrulha
// geometrica?
//
// "a4" carrega OS MESMOS 53 componentes nativos de falcon1 em
// built-in_mixr_1/configs/scenario_max_player.edl.in (copiados daqui, byte
// a byte, exceto onde a diferenca de proposito exige mudar algo -- ver
// abaixo). O agente e o MESMO ( FlightAgentTC ) dentro do proprio player
// (fase 3 do frame de tempo critico) que built-in_mixr_1 ja usa -- a
// diferenca inteira desta poc esta em UMA linha: o treeFile aponta para
// flight_tree_nav.xml (um no so, ( Navigate ), sem Patrol/RTB/Evade por
// baixo -- ver o cabecalho daquele XML) em vez de flight_tree.xml.
//
// O QUE "NAVEGAR DE VERDADE" SIGNIFICA AQUI: em built-in_mixr_1 a arvore de
// PRODUCAO pilota o aviao (patrulha geometrica, evasao, retorno), e a
// ( Route ) so serve pra disparar as Action dos steerpoints que o circuito
// da arvore passa perto -- por isso o bandit1 daquele cenario fica a 30 NM,
// para dar tempo da volta fechar antes que a arvore abandone o circuito
// (ver a armadilha 8 do README de built-in_mixr_1). Aqui NAO HA bandit,
// NAO HA arvore de patrulha: quem decide o rumo, a cada tick, e a leitura
// direta do Route/Steerpoint nativo (Navigation::getTrueBrgDeg(),
// Steerpoint::getCmdAltitudeM()/getCmdAirspeedKts()) -- o aviao voa a rota
// inteira, sempre, com wrap:true fechando o circuito para sempre.
//
// SUBSISTEMAS (os DEZ que Player::updateSystemPointers() resolve por TIPO,
// mais o que nao e primario -- mesma tabela do README de built-in_mixr_1):
//
//   1) DynamicsModel  -> ( JSBSimModel )         6-DOF
//   2) Pilot          -> ( Autopilot )           leis de controle
//   3) Navigation     -> ( Ins ) + ( Gps ) + ( Route ) + ( Steerpoint )
//                        + ( Bullseye ) + as 4 ( Action* )
//   4) Datalink       -> ( AlertDatalink )       (unica classe NAO nativa;
//                        inerte aqui -- nao ha outro aviao para alertar)
//   5) Radio          -> ( CommRadio ) + ( Iff )
//   6) Gimbal         -> ( Gimbal ) + ( StabilizingGimbal ) + 6 ( Antenna )
//                        + ( IrSeeker )
//   7) RfSensor       -> ( SensorMgr ) + ( Tws ) ( Stt ) ( Sar ) ( Gmti )
//                        ( Rwr ) ( Jammer )
//   8) IrSystem       -> ( IrSensor )
//   9) OnboardComputer-> ( AirTrkMgr ) ( RwrTrkMgr ) ( GmtiTrkMgr )
//                        ( AirAngleOnlyTrkMgr )
//  10) StoresMgr      -> ( StoresMgr ) + 11 estacoes: ( AamMissile )
//                        ( AgmMissile ) ( Sam ) ( Bomb ) ( Chaff ) ( Flare )
//                        ( Decoy ) ( Gun )+( Bullet ) ( FuelTank )
//                        ( AvionicsPod )
//  + ( CollisionDetect ) no fim de components: (nao e sistema primario)
//  + assinatura RF ( SigSwitch ) com ( SigSphere )/( SigPlate )/( SigAzEl )
//    e assinatura IR ( IrSignature ) + ( IrSphere )
//
// Sensores/armas ficam estruturalmente completos mas ociosos -- sem outro
// aviao no cenario, o TWS/STT/GMTI/SAR/RWR nunca tem contato e o
// StoresMgr nunca libera nada pelo caminho do UBF (so pelas Action dos
// steerpoints, que usam a rota nativa direto -- ver abaixo). E deliberado:
// o ponto desta poc e a NAVEGACAO, nao o combate.
//
// O QUE FICA HERMETICO: sem 'networks:' (mesmo motivo do
// tests/scenario/make_fixture.py), porta Tacview propria (1240) e arquivos
// de dados proprios -- roda ao lado das outras seis pocs sem disputar porta
// nem sobrescrever gravacao.
//
// ARMADILHAS JA CONFIRMADAS EM built-in_mixr_1, e que valem AQUI TAMBEM
// (nao redescobrir -- ver o README daquela poc para o texto completo):
//
//   * ActionDecoyRelease::process() conta 'interval' em relogio de PAREDE,
//     nao tempo simulado -- em -deterministic um ( Seconds 1.0 ) vira
//     minutos de tempo simulado entre um decoy e o seguinte.
//   * ActionWeaponRelease ignora o slot 'station' -- sempre libera a
//     primeira ( Bomb ) livre da lista.
//   * Table2.data e LISTA DE LISTAS, uma sublista por ponto de y.
//   * sarLatitude/targetLatitude sao base::LatLon, nao base::Angle.
//   * dataLogTime: em CADA store liberavel, ou o flyout nunca aparece no
//     Tacview.
//
// PROPRIA DESTA POC: como nao ha arvore de patrulha "escapando" do
// circuito, as quatro Action dos steerpoints disparam A CADA VOLTA --
// decoy, imageamento SAR, troca de camuflagem e liberacao de bomba se
// repetem indefinidamente enquanto o cenario roda (wrap:true).
//

( ClockStation

   tcPriority: 0.5

   ownship: a4

   components: {

      plugins: ( PluginLoader
         searchPaths: {
            "./dist/lib/mixr-plugins/"
         }
         modules: {
            ( PluginModule
               file:     "libflight.so"
               provides: { AlertDatalink TacticalAlert ThreadTagProbe FlightAgentTC
                           FlightState BtBehavior AltitudeSafetyBehavior
                           RLBridgeBehavior FlightAction }
            )
         }
      )

      msgFeed: ( MsgFeed
         trackManager: twsTrkMgr
         maxPlayers:   16
         healthEvery:  ( Seconds 10 )
         sinks: {
            ( MsgFileSink
               fileName: "./sandbox/full-systems-nav/data/messages/mission_@RUN_ID@.jsonl"
               flushEvery: ( Seconds 2 ) )
         }
         messages: {
            ( MsgReport name: telemetria  players: { }
               labels: { player side mode }
               fields: { latDeg lonDeg altMslM altAglM hdgDeg speedKts fuelFrac }
               every: ( Seconds 1.0 ) )
         }
      )

   } // components

   dataRecorder: ( ExposedDataRecorder
      eventName: "full-systems-nav"
      enabledList: [ 43 42 ]
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 1240
               callsign: "poc-mixr/full-systems-nav"
               fileName: "./sandbox/full-systems-nav/data/recordings/mission_@RUN_ID@.acmi"
               modelMap: { a4: "A-4E" }
               typeMap:  { a4: "Air+FixedWing" }
               colorMap: { a4: "Blue" }
            )
         }
      )
   )

   simulation: ( WorldModel

      numTcThreads: @NUM_TC_THREADS@

      latitude:  -22.25
      longitude: -42.48

      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         // ==============================================================
         // a4 -- o player maximo, voando a navegacao nativa
         // ==============================================================
         a4: ( Aircraft
            id: 101
            side: blue
            type: "A4"

            // ASSINATURA RF COMUTAVEL -- identica a built-in_mixr_1. Sem
            // outro aviao para medir contra, e so estrutural aqui, mas o
            // camouflageType ainda muda de verdade quando wp3 dispara
            // ( ActionCamouflageType ).
            camouflageType: 0
            signature: ( SigSwitch
               components: {
                  limpo: ( SigSphere radius: 3.0 )
                  placa: ( SigPlate a: ( Meters 6.0 ) b: ( Meters 2.0 ) )
                  const: ( SigConstant rcs: ( SquareMeters 2.5 ) )
                  died:  ( SigDihedralCR  a: ( Meters 1.5 ) b: ( Meters 1.5 ) )
                  tried: ( SigTrihedralCR a: ( Meters 1.5 ) b: ( Meters 1.5 ) )
                  azel:  ( SigAzEl
                     inDegrees: true
                     inDecibel: true
                     table: ( Table2
                        x: [ -180.0  -90.0  0.0  90.0  180.0 ]
                        y: [  -30.0    0.0  30.0 ]
                        data: { [  3.0   8.0  12.0   8.0   3.0 ]
                                [  5.0  10.0  15.0  10.0   5.0 ]
                                [  3.0   8.0  12.0   8.0   3.0 ] }
                     )
                  )
               }
            )

            irSignature: ( IrSignature
               baseHeatSignature: 320.0
               emissivity:          0.75
               effectiveArea:     ( SquareMeters 3.0 )
               irShapeSignature:  ( IrSphere radius: ( Meters 2.0 ) )
            )

            initXPos:     ( NauticalMiles 5.0 )
            initYPos:     ( NauticalMiles 0.0 )
            initAlt:      ( Meters 1750.0 )
            initHeading:  ( Degrees 90 )
            // 350 kt, nao 180: e a faixa de cruzeiro deste JSBSimModel "A4"
            // (mesma ordem de grandeza de patrolSpeed/rtbSpeed/evadeSpeed/
            // supportSpeed na arvore de producao, 350-420 kt) -- iniciar
            // muito abaixo disso e a mesma armadilha das velocidades dos
            // steerpoints abaixo (ver o comentario em wp1).
            initVelocity: 350.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true

            components: {

               // --- 1) DynamicsModel ------------------------------------
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"
                  model:   "A4"
                  debugLevel: 0
               )

               // --- 2) Pilot --------------------------------------------
               // navMode FALSE mesmo esta poc sendo sobre navegacao: quem
               // atua e o UBF (via FlightAction), nao o
               // Autopilot::processModeNavigation() nativo -- ver o
               // cabecalho de flight_tree_nav.xml para o raciocinio
               // completo. Com navMode:true o Autopilot leria a MESMA
               // Navigation por um segundo caminho e disputaria o comando
               // com a arvore a cada frame.
               pilot: ( Autopilot
                  navMode: false
                  headingHoldMode:  true
                  altitudeHoldMode: true
                  velocityHoldMode: true
                  maxRateOfTurnDps: 6.0
                  maxBankAngle:    45.0
                  maxPitchAngle:   20.0
                  maxClimbRateMps:  40.0
                  maxAcceleration:  6.0
               )

               // --- 3) Navigation ---------------------------------------
               // ( Ins ) E uma ( Navigation ), e o ( Gps ) aninhado tambem
               // -- por isso o Gps entra como FILHO, nao como irmao.
               //
               // As quatro Action disparam TODA VOLTA aqui (sem arvore de
               // patrulha abandonando o circuito, como em
               // built-in_mixr_1): decoy, SAR, camuflagem e bomba se
               // repetem a cada wrap da rota.
               nav: ( Ins
                  bullseye: ( Bullseye
                     latitude:  ( Degrees -22.25 )
                     longitude: ( Degrees -42.48 )
                  )
                  route: ( Route
                     to: 1
                     autoSequence: true
                     autoSeqDistance: ( NauticalMiles 1.5 )
                     wrap: true
                     components: {
                        // 'airspeed:' de cada steerpoint aqui e um comando de
                        // VOO de verdade -- ( Navigate ) le
                        // Steerpoint::getCmdAirspeedKts() e manda para o
                        // Autopilot via velocityHoldMode. Diferente de
                        // built-in_mixr_1 (onde a arvore de PRODUCAO pilota via
                        // patrolSpeed:350 e este campo do steerpoint nunca e
                        // lido para voar -- so serve de metadado), aqui o
                        // valor tem de estar na faixa que o JSBSimModel "A4"
                        // sustenta em voo nivelado (~350 kt, a mesma ordem de
                        // patrolSpeed/rtbSpeed/evadeSpeed/supportSpeed da
                        // arvore de producao). Medido rodando: comandar 160 kt
                        // (copiado sem pensar do valor so-decorativo de
                        // built-in_mixr_1) faz a aeronave nao conseguir manter
                        // altitude E velocidade ao mesmo tempo -- as duas caem
                        // continuamente por ~200s simulados ate colidir com o
                        // terreno, com rumo FIXO (nada a ver com guiagem/
                        // curva -- confirmado isolando a variavel).
                        wp1: ( Steerpoint
                           stptType: DEST
                           xPos: ( Meters 9290 )
                           yPos: ( Meters 3000 )
                           altitude: ( Meters 1750 )
                           airspeed: 350.0
                           description: "ponto 1 -- solta decoy ao passar"
                           action: ( ActionDecoyRelease
                              numToLaunch: 1
                              interval: ( Seconds 1.0 )
                           )
                        )
                        wp2: ( Steerpoint
                           stptType: TGT
                           xPos: ( Meters 6000 )
                           yPos: ( Meters 7370 )
                           altitude: ( Meters 1900 )
                           airspeed: 370.0
                           description: "ponto 2 -- imageamento SAR"
                           action: ( ActionImagingSar
                              sarLatitude:  ( LatLon direction: "s" degrees: 22 minutes: 12 )
                              sarLongitude: ( LatLon direction: "w" degrees: 42 minutes: 24 )
                              sarElevation: ( Meters 900 )
                              resolution:   ( Meters 3 )
                              imageSize:    512
                           )
                        )
                        wp3: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters 3230 )
                           yPos: ( Meters 4000 )
                           altitude: ( Meters 1750 )
                           airspeed: 350.0
                           description: "ponto 3 -- troca a camuflagem (RCS)"
                           action: ( ActionCamouflageType camouflageType: 1 )
                        )
                        wp4: ( Steerpoint
                           stptType: IP
                           xPos: ( Meters 6000 )
                           yPos: ( Meters 1600 )
                           altitude: ( Meters 1600 )
                           airspeed: 360.0
                           description: "ponto 4 -- liberacao de arma na estacao 1"
                           action: ( ActionWeaponRelease
                              targetLatitude:  ( LatLon direction: "s" degrees: 22 minutes: 18 )
                              targetLongitude: ( LatLon direction: "w" degrees: 42 minutes: 33 )
                              targetElevation: ( Meters 900 )
                              station: 5
                           )
                        )
                     }
                  )
                  components: {
                     gps: ( Gps )
                  }
               )

               // --- 4) Datalink -----------------------------------------
               datalink: ( AlertDatalink
                  holdTime: ( Seconds 25 )
                  trackManagerName: twsTrkMgr
                  maxRange: ( NauticalMiles 100 )
               )

               // --- 5) Radio --------------------------------------------
               comm1: ( CommRadio
                  radioID: 1
                  numChannels: 4
                  channels: { ( MegaHertz 225.0 ) ( MegaHertz 243.0 )
                              ( MegaHertz 251.0 ) ( MegaHertz 300.0 ) }
                  channel: 1
                  maxDetectRange: ( NauticalMiles 120 )
                  powerPeak: ( Watts 10.0 )
                  frequency: ( MegaHertz 225.0 )
                  bandwidth: ( KiloHertz 25.0 )
                  components: {
                     iff: ( Iff
                        radioID: 2
                        powerPeak: ( Watts 5.0 )
                        frequency: ( MegaHertz 1030.0 )
                        bandwidth: ( MegaHertz 2.0 )
                        mode1: 3
                        mode2: 4096
                        mode3a: 1200
                        enableMode1: true
                        enableMode2: true
                        enableMode3a: true
                        enableModeC: true
                     )
                  }
               )

               // --- 6) Gimbal -------------------------------------------
               antennas: ( Gimbal
                  components: {

                     ant_tws: ( Antenna
                        polarization: horizontal
                        gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]
                        maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth:   ( Degrees 60 )
                        commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]
                        searchVolume: [ 1.0472 0.05 ]
                        numBars: 2
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_stt: ( Antenna
                        polarization: horizontal
                        gain: ( dB 44 )
                        initPosition: [ 0 0 ]
                        maxRates: [ 1.5 1.5 ]
                        maxPlayersOfInterest: 4
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 30.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_gmti: ( Antenna
                        polarization: vertical
                        gain: ( dB 38 )
                        initPosition: [ 0 -0.35 ]
                        maxRates: [ 0.8727 0.8727 ]
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { ground ship }
                        maxRange2PlayersOfInterest: ( NauticalMiles 30.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_rwr: ( Antenna
                        polarization: vertical
                        gain: ( dB 3 )
                        initPosition: [ 0 0 ]
                        maxPlayersOfInterest: 16
                        playerOfInterestTypes: { air ground ship }
                        maxRange2PlayersOfInterest: ( NauticalMiles 80.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 180.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_jam: ( Antenna
                        polarization: vertical
                        gain: ( dB 20 )
                        initPosition: [ 3.1416 0 ]
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air ground }
                        maxRange2PlayersOfInterest: ( NauticalMiles 60.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 120.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     estab: ( StabilizingGimbal
                        stabilizingMode: roll
                        components: {
                           ant_sar: ( Antenna
                              polarization: vertical
                              gain: ( dB 40 )
                              initPosition: [ 0 -0.5 ]
                              maxPlayersOfInterest: 4
                              playerOfInterestTypes: { ground }
                              maxRange2PlayersOfInterest: ( NauticalMiles 20.0 )
                              maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                              localPlayersOfInterestOnly: false
                              useWorldCoordinates: false
                           )
                        }
                     )

                     irst: ( IrSeeker
                        initPosition: [ 0 0 ]
                        maxRates: [ 1.0 1.0 ]
                        searchVolume: [ 0.5236 0.1745 ]
                        numBars: 2
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 25.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 45.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )
                  }
               )

               // --- 7) RfSensor -----------------------------------------
               sensors: ( SensorMgr
                  components: {

                     tws: ( Tws
                        trackManagerName: twsTrkMgr
                        antennaName: ant_tws
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 2.0 )
                        PRF:        ( Hertz 500.0 )
                        pulseWidth: ( MilliSeconds 0.01 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 80 ]
                        initRangeIdx: 2
                     )

                     stt: ( Stt
                        trackManagerName: twsTrkMgr
                        antennaName: ant_stt
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 1.0 )
                        PRF:        ( Hertz 2000.0 )
                        pulseWidth: ( MilliSeconds 0.005 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 ]
                        initRangeIdx: 2
                     )

                     gmti: ( Gmti
                        trackManagerName: gmtiTrkMgr
                        antennaName: ant_gmti
                        powerPeak:  ( KiloWatts 150.0 )
                        frequency:  ( GigaHertz 9.5 )
                        bandwidth:  ( MegaHertz 500.0 )
                        PRF:        ( Hertz 1000.0 )
                        pulseWidth: ( MilliSeconds 0.008 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 30 ]
                        initRangeIdx: 1
                     )

                     sar: ( Sar
                        antennaName: ant_sar
                        powerPeak:  ( KiloWatts 150.0 )
                        frequency:  ( GigaHertz 9.5 )
                        bandwidth:  ( MegaHertz 500.0 )
                        PRF:        ( Hertz 1500.0 )
                        pulseWidth: ( MilliSeconds 0.004 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        chipSize: 512
                     )

                     rwr: ( Rwr
                        trackManagerName: rwrTrkMgr
                        antennaName: ant_rwr
                        disableEmissions: true
                        frequency:  ( GigaHertz 6.0 )
                        bandwidth:  ( GigaHertz 10.0 )
                        threshold:  ( dB 0.0 )
                     )

                     jam: ( Jammer
                        antennaName: ant_jam
                        powerPeak: ( Watts 500.0 )
                        frequency: ( GigaHertz 3.0 )
                        bandwidth: ( GigaHertz 1.0 )
                        disableEmissions: true
                     )
                  }
               )

               // --- 8) IrSystem -----------------------------------------
               irsystem: ( IrSensor
                  seekerName: irst
                  trackManagerName: irTrkMgr
                  lowerWavelength: 3.0
                  upperWavelength: 5.0
                  nei: 0.00001
                  threshold: 1.0
                  IFOV: 0.0003
                  sensorType: "contrast"
                  maximumRange: ( NauticalMiles 25 )
               )

               // --- 9) OnboardComputer ----------------------------------
               obc: ( OnboardComputer
                  components: {
                     twsTrkMgr: ( AirTrkMgr
                        maxTracks: 20   alpha: 1.0  beta: 0.5  gamma: 0.0
                        positionGate: 1500  rangeGate: 500  velocityGate: 10
                        firstTrackId: 1000
                     )
                     rwrTrkMgr: ( RwrTrkMgr
                        maxTracks: 20   alpha: 2.0  beta: 0.0  gamma: 0.0
                        firstTrackId: 2000
                     )
                     gmtiTrkMgr: ( GmtiTrkMgr
                        maxTracks: 20   alpha: 1.0  beta: 0.5  gamma: 0.0
                        firstTrackId: 3000
                     )
                     irTrkMgr: ( AirAngleOnlyTrkMgr
                        maxTracks: 20   alpha: 1.0  beta: 0.5  gamma: 0.0
                        azimuthBin:   ( Degrees 5 )
                        elevationBin: ( Degrees 5 )
                        firstTrackId: 4000
                     )
                  }
               )

               // --- 10) StoresMgr ---------------------------------------
               stores: ( StoresMgr
                  numStations: 11
                  stores: {
                     1: ( AamMissile
                        id: 501  side: blue  type: "AIM-9"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 30 )
                        maxBurstRng: ( Meters 150 )  maxGimbal: ( Degrees 45 )
                     )
                     2: ( AamMissile
                        id: 502  side: blue  type: "AIM-9"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 30 )
                        maxBurstRng: ( Meters 150 )  maxGimbal: ( Degrees 45 )
                     )
                     3: ( AgmMissile
                        id: 503  side: blue  type: "AGM-65"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 90 )  lethalRange: ( Meters 40 )
                        maxBurstRng: ( Meters 200 )
                     )
                     4: ( Sam
                        id: 504  side: blue  type: "SAM-demo"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 30 )
                     )
                     5: ( Bomb
                        id: 505  side: blue  type: "MK-82"
                        signature: ( SigSphere radius: 0.3 )
                        dataLogTime: ( Seconds 0.1 )
                        arming: free_fall
                        noseFuze: true  tailFuze: true
                        fuzeAltitude: ( Meters 0 )
                        dragIndex: 0.0006
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 50 )
                     )
                     6: ( Chaff
                        id: 506  side: blue  type: "chaff"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 20 )  dragIndex: 0.02
                     )
                     7: ( Flare
                        id: 507  side: blue  type: "flare"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 20 )  dragIndex: 0.02
                     )
                     8: ( Decoy
                        id: 508  side: blue  type: "decoy"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 30 )  dragIndex: 0.01
                     )
                     9: ( Gun
                        type: "M61A1"
                        rounds: 510
                        rate: 6000
                        burstRate: 10
                        position: [ 2.0 0.0 -0.3 ]
                        bulletType: ( Bullet
                           id: 509  side: blue  type: "20mm"
                           maxTOF: ( Seconds 6 )  lethalRange: ( Meters 3 )
                        )
                     )
                     10: ( FuelTank
                        type: "tanque-ventral"
                        jettisonable: true
                        fuelWt:   1200.0
                        capacity: 1200.0
                     )
                     11: ( AvionicsPod
                        type: "pod-recon"
                        jettisonable: false
                     )
                  }
               )

               // --- extra: deteccao de colisao --------------------------
               colisao: ( CollisionDetect
                  collisionRange: ( Meters 100 )
                  maxPlayers: 20
                  playerTypes: { air }
                  maxRange2Players: ( NauticalMiles 5.0 )
                  maxAngle2Players: ( Degrees 180.0 )
                  localOnly: false
                  useWorldCoordinates: false
                  sendCrashEvents: false
               )

               // --- o AGENTE: UBF completo, arvore de UM no so ----------
               // Componente do PLAYER (nao da Station), decidindo na FASE 3
               // do frame de tempo critico -- o mesmo padrao usado por
               // built-in_mixr_1 e por todo cenario deste repositorio.
               // state/behavior sao os mesmos
               // tres papeis do UBF de producao (percepcao/decisao/
               // atuacao): so a arvore dentro do behavior muda.
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( BtBehavior
                     treeFile: "./dist/share/mixr-plugins/flight/flight_tree_nav.xml"
                  )
               )
            }
         )

      } // players

   ) // simulation

) // station
