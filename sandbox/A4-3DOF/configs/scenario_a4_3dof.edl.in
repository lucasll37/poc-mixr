                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 30 ]
                        initRangeIdx: 1
                     )

                     sar: ( Sar
                        antennaName: ant_sar
                        powerPeak:  ( KiloWatts 150.0 )
                        frequency:  ( GigaHertz 9.5 )
                        bandwidth:  ( MegaHertz 500.0 )
