               // --- extra: deteccao de colisao --------------------------
               colisao: ( CollisionDetect
                  collisionRange: ( Meters 100 )
                  maxPlayers: 20
                  playerTypes: { air }
                  maxRange2Players: ( NauticalMiles 5.0 )
                  maxAngle2Players: ( Degrees 180.0 )
                  localOnly: false
                  useWorldCoordinates: false
                  sendCrashEvents: false
               )

               // --- o AGENTE: UBF completo, arvore de UM no so ----------
               // Componente do PLAYER (nao da Station), decidindo na FASE 3
               // do frame de tempo critico -- o mesmo padrao usado por
               // built-in_mixr_1 e por todo cenario deste repositorio.
               // state/behavior sao os mesmos
               // tres papeis do UBF de producao (percepcao/decisao/
               // atuacao): so a arvore dentro do behavior muda.
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( BtBehavior
                     treeFile: "./dist/share/mixr-plugins/flight/flight_tree_nav.xml"
                  )
               )
            }
         )

         a4_3: ( Aircraft
            id: 103
            side: blue
            type: "A4"

            // ASSINATURA RF COMUTAVEL -- identica a built-in_mixr_1. Sem
            // outro aviao para medir contra, e so estrutural aqui, mas o
            // camouflageType ainda muda de verdade quando wp3 dispara
            // ( ActionCamouflageType ).
            camouflageType: 0
            signature: ( SigSwitch
               components: {
                  limpo: ( SigSphere radius: 3.0 )
                  placa: ( SigPlate a: ( Meters 6.0 ) b: ( Meters 2.0 ) )
                  const: ( SigConstant rcs: ( SquareMeters 2.5 ) )
                  died:  ( SigDihedralCR  a: ( Meters 1.5 ) b: ( Meters 1.5 ) )
                  tried: ( SigTrihedralCR a: ( Meters 1.5 ) b: ( Meters 1.5 ) )
                  azel:  ( SigAzEl
                     inDegrees: true
                     inDecibel: true
                     table: ( Table2
                        x: [ -180.0  -90.0  0.0  90.0  180.0 ]
                        y: [  -30.0    0.0  30.0 ]
                        data: { [  3.0   8.0  12.0   8.0   3.0 ]
                                [  5.0  10.0  15.0  10.0   5.0 ]
                                [  3.0   8.0  12.0   8.0   3.0 ] }
                     )
                  )
               }
            )

            irSignature: ( IrSignature
               baseHeatSignature: 320.0
               emissivity:          0.75
               effectiveArea:     ( SquareMeters 3.0 )
               irShapeSignature:  ( IrSphere radius: ( Meters 2.0 ) )
            )

            // POSICAO/ATITUDE INICIAL SOBRE A PERNA DE ENTRADA, nao num ponto
            // solto no meio do circuito. Comecar DENTRO do circuito de 10
            // steerpoints declarado abaixo, apontando para outro lado, faz a
            // perseguicao pura do ( Navigate ) orbitar o primeiro ponto sem
            // nunca alcanca-lo: com 24 km de raio de circuito contra ~5,5 km
            // de raio de curva da aeronave (ver a nota "POR QUE 24 km DE
            // RAIO" no bloco da rota), o alvo cai dentro do proprio circulo
            // de curva e a rota nunca sequencia. Aqui o aviao nasce 4 km
            // ANTES de wp1, em cima da perna wp10->wp1, ja no rumo dela
            // (072), ja na altitude comandada por wp1 (5000 ft) e ja na
            // velocidade de cruzeiro: nao ha transiente de juncao nenhum.
            initXPos:     ( Meters -18122 )
            initYPos:     ( Meters 8090 )
            initAlt:      ( Feet 13000 )
            initHeading:  ( Degrees 54 )
            // initVelocityKts, nao initVelocity: 'initVelocity' e METROS POR
            // SEGUNDO (Player.cpp:75 -- "initVelocity: Initial Velocity:
            // meters/sec"), e o slot em KNOTS e outro (Player.cpp:76,
            // 'initVelocityKts'). Com 'initVelocity: 350.0' a aeronave nascia
            // a 350 m/s = 680 kt (medido: mach 0.97 no frame 100) e passava os
            // primeiros ~60 s desacelerando para a faixa comandada pelos
            // steerpoints -- transiente gratuito, agora removido. 280 kt e a
            // velocidade VERDADEIRA que o escalonamento de subida dos
            // steerpoints mantem do piso ao teto do perfil (~145 m/s; ver o
            // bloco da rota), entao a aeronave ja nasce estabilizada nela.
            initVelocityKts: 262.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true

            components: {

               // --- 1) DynamicsModel ------------------------------------
               // RacModel: cinematico, "3DOF" informal -- ver o cabecalho
               // deste arquivo para a justificativa do rotulo e de cada
               // numero abaixo.
               //   cmdAltitude/cmdHeading/cmdSpeed = os mesmos initAlt/
               //     initHeading/initVelocityKts DESTE player (13000 ft /
               //     54 deg / 262 kt) -- estado inicial coerente com a pose
               //     real de partida; o Autopilot sobrescreve isso a cada
               //     frame de qualquer forma (os tres hold modes sao true).
               //     cmdAltitude e base::Distance e cmdSpeed e em NOS.
               //   maxg/maxAccel = os proprios defaults compilados da
               //     classe (RacModel.hpp: gMax{4.0}, maxAccel{10.0}) --
               //     sem precedente de uso no repo, usa-se o default do
               //     autor da classe em vez de inventar numero novo.
               //   minSpeed/speedMaxG = em M/S (ver a armadilha de unidade
               //     no cabecalho), escolhidos para a faixa de ~135 m/s
               //     (262 kt) que os steerpoints desta rota comandam:
               //     minSpeed abaixo dela para gmax ficar > 1 G (com
               //     V < minSpeed a rampa produz gmax < 1 e a curva
               //     degrada), speedMaxG no default compilado da classe.
               dynamicsModel: ( RacModel
                  minSpeed:    100.0
                  speedMaxG:   250.0
                  maxg:        4.0
                  maxAccel:    10.0
                  cmdAltitude: ( Feet 13000 )
                  cmdHeading:  ( Degrees 54 )
                  cmdSpeed:    262.0
               )

               // --- 2) Pilot --------------------------------------------
               // navMode FALSE mesmo esta poc sendo sobre navegacao: quem
               // atua e o UBF (via FlightAction), nao o
               // Autopilot::processModeNavigation() nativo -- ver o
               // cabecalho de flight_tree_nav.xml para o raciocinio
               // completo. Com navMode:true o Autopilot leria a MESMA
               // Navigation por um segundo caminho e disputaria o comando
               // com a arvore a cada frame.
               pilot: ( Autopilot
                  navMode: false
                  headingHoldMode:  true
                  altitudeHoldMode: true
                  velocityHoldMode: true
                  maxRateOfTurnDps: 6.0
                  maxBankAngle:    45.0
                  maxPitchAngle:   20.0
                  maxClimbRateMps:  40.0
                  maxAcceleration:  6.0
               )

               // --- 3) Navigation ---------------------------------------
               // ( Ins ) E uma ( Navigation ), e o ( Gps ) aninhado tambem
               // -- por isso o Gps entra como FILHO, nao como irmao.
               //
               // As quatro Action disparam TODA VOLTA aqui (sem arvore de
               // patrulha abandonando o circuito, como em
               // built-in_mixr_1): decoy, SAR, camuflagem e bomba se
               // repetem a cada wrap da rota.
               nav: ( Ins
                  bullseye: ( Bullseye
                     latitude:  ( Degrees -22.25 )
                     longitude: ( Degrees -42.48 )
                  )
                  route: ( Route
                     to: 1
                     autoSequence: true
                     autoSeqDistance: ( NauticalMiles 2.0 )
                     wrap: true
                     components: {
                        // ============================================================
                        // FIGURA-DE-OITO DE 20 STEERPOINTS, OITO AERONAVES EMPILHADAS
                        // ============================================================
                        // A rota nao e um circuito convexo: e um OITO fechado, com 10
                        // curvas para a DIREITA seguidas de 10 para a ESQUERDA. Como se
                        // constroi, e por que fecha exatamente:
                        //
                        //   rumo das cordas do lobo LESTE:  t + 18 + 36k   (k = 0..9)
                        //   rumo das cordas do lobo OESTE:  t - 18 - 36k   (k = 0..9)
                        //
                        // As dez direcoes de um decagono somam ZERO, entao CADA lobo
                        // fecha sozinho no ponto de cruzamento -- o erro de fechamento do
                        // poligono inteiro e de 0,000 m, nao um valor "pequeno o
                        // bastante". E nas DUAS juncoes o rumo e CONTINUO (o lobo leste
                        // termina em t-18 e o oeste comeca em t-18; o oeste termina em
                        // t+18 e o leste comeca em t+18): a aeronave ATRAVESSA o
                        // cruzamento em linha reta, como num oito de verdade.
                        //
                        // ARMADILHA DA CONSTRUCAO INGENUA, batida antes de chegar nesta:
                        // fazer os dois lobos partirem do cruzamento com o MESMO rumo
                        // tambem fecha e tambem alterna o lado da curva -- mas ai os dois
                        // compartilham a perna inteira que sai dali (wp1 e wp11 caem no
                        // MESMO ponto), e o resultado nao e um oito: sao duas voltas
                        // sobre o mesmo trecho. O deslocamento de meia-perna (o "+18/-18"
                        // acima) e o que separa os dois casos.
                        //
                        // wp10 e wp20 sao o MESMO ponto no mapa (o cruzamento). E
                        // proposital: a aeronave passa por ali duas vezes por volta, em
                        // alturas diferentes do perfil (15000 e 13000 ft na a4_1).
                        //
                        // ONDE O OITO FOI POSTO -- escolhido por VARREDURA DE TERRENO,
                        // nao a olho. 207 colocacoes cabem inteiras no tile SRTM
                        // (S23W043) e foram pontuadas pelo relevo mais alto sob as 20
                        // pernas; a vencedora poe o cruzamento em (-24000, 0) m com
                        // t = 36 graus. O ganho nao e so folga: os dois lobos caem sobre
                        // relevos MUITO diferentes, e e isso que da sentido ao perfil.
                        //   lobo LESTE  (wp1..wp9):   relevo de 5 a 250 m -- litoral e
                        //                             mar, praticamente plano.
                        //   lobo OESTE  (wp11..wp19): relevo de 300 a 1338 m -- a serra.
                        // Por isso a aeronave desce ao piso do perfil no lobo leste e so
                        // pode descer ate 8000 ft no lobo oeste. O perfil nao foi colado
                        // por cima da geografia: saiu dela.
                        //
                        // PERFIL DE ALTITUDE (a4_1, a mais baixa da pilha), em pes:
                        //   wp1..wp10  11000  9000  7000  5000  4000  6000  8000 10000 12000 14000
                        //   wp11..wp20 15000 13000 11000  9000  8000 10000 12000 14000 15000 13000
                        // Sao DUAS descidas-e-subidas completas por volta, uma por lobo:
                        // 11000 -> 4000 -> 15000 no lobo leste (11000 ft de amplitude) e
                        // 15000 -> 8000 -> 15000 no oeste (7000 ft). A a4_8 voa o mesmo
                        // perfil 7000 ft acima: 11000..22000 ft.
                        //
                        // POR QUE O DEGRAU MAXIMO E DE 2000 ft POR PERNA, e nao mais --
                        // MEDIDO, nao escolhido por gosto. A versao anterior deste perfil
                        // tinha dente-de-serra de +-4000 ft com periodo de UMA perna
                        // (~110 s) no lobo alto; rodando, a malha de altitude nao
                        // acompanha: a aeronave achatava em torno de 12500 ft (a4_1) /
                        // 18900 ft (a4_8) e ficava 2200 a 3100 ft atras do comando ponto
                        // a ponto -- ou seja, o perfil "mais acentuado" no papel virava
                        // um perfil MENOS variado no ar. Com as rampas espalhadas por
                        // varias pernas o erro na passagem cai para a casa das centenas
                        // de pes, inclusive na a4_8 subindo a 22000 ft. Amplitude total
                        // preservada; o que mudou foi a taxa.
                        //
                        // A PILHA DE OITO AERONAVES. a4_1..a4_8 sao identicas (mesmo
                        // player maximo, mesmo agent:, mesma arvore) e cumprem a MESMA
                        // rota; a unica diferenca e um deslocamento de +1000 ft por
                        // aeronave em TODOS os 20 steerpoints. Elas nascem na mesma
                        // posicao horizontal, empilhadas -- separacao VERTICAL.
                        //
                        //   * O 'airspeed:' de cada steerpoint e recalculado POR
                        //     AERONAVE, e e isso que impede a pilha de se desmanchar. A
                        //     malha de velocidade do a4ap.xml fecha contra
                        //     velocities/vc-kts (velocidade CALIBRADA), enquanto quem
                        //     define a geometria da curva e a VERDADEIRA. Comandar a
                        //     mesma calibrada nas oito faria a a4_8, 7000 ft acima, voar
                        //     ~13% mais rapido em verdadeira e escapar da formacao em uma
                        //     volta. Cada steerpoint carrega a calibrada que da 262 kt
                        //     VERDADEIROS (135 m/s) na altitude DAQUELE ponto -- por isso
                        //     os numeros de airspeed diferem entre a4_1 e a4_8 no mesmo
                        //     wp.
                        //   * ESTE 'airspeed:' CALIBRADO NAO TEM EFEITO AQUI. O
                        //     numero foi herdado de A4-6DOF sem mudanca (a unica
                        //     diferenca deste cenario e o dynamicsModel:), mas o
                        //     RacModel trata o valor comandado como velocidade
                        //     VERDADEIRA -- converte por NM2M/3600 e compara com
                        //     Player::getTotalVelocity() (RacModel.cpp:280).
                        //     Resultado: as oito comandam verdadeiras um pouco
                        //     diferentes entre si e a pilha se estica ao longo da
                        //     rota em vez de ficar alinhada. Para colar a formacao
                        //     sob este modelo, os vinte 'airspeed:' teriam de voltar
                        //     a ser o MESMO valor (262) nas oito -- mudanca de
                        //     cenario, fora do escopo desta variante.
                        //   * ( CollisionDetect ) tem collisionRange: 100 m e
                        //     sendCrashEvents: false. 1000 ft = 305 m, entao a pilha nem
                        //     entra no alcance de deteccao -- e mesmo que entrasse, nao
                        //     ha CRASH_EVENT vindo dali.
                        //
                        // POR QUE PERNAS DE 14 km (lobos de 22,7 km de raio) -- MEDIDO
                        // RODANDO, e o mesmo limite que ja dimensionava a rota anterior.
                        // maxBankAngle/maxRateOfTurnDps do ( Autopilot ) acima sao
                        // INERTES com ( JSBSimModel ): os dois chegam a
                        // JSBSimModel::setCommandedHeadingD(h,,) como parametros SEM NOME
                        // e sao descartados (Autopilot.hpp:66-71 documenta a ressalva).
                        // Quem manda e o autopiloto do proprio airframe,
                        // data/jsbsim/aircraft/A4/a4ap.xml: erro de rumo limitado a +-30
                        // graus, ganho 1:1 de erro para inclinacao, e um nivelador de asa
                        // (-0.8*phi) sempre ligado que na pratica segura o banco em ~25
                        // graus. A 135 m/s isso da raio de curva de ~4,8 km e uma
                        // REVERSAO de banco que leva ~30 s. Em circuito apertado a
                        // aeronave passa do rumo da perna seguinte em 40 a 100 graus,
                        // oscila com periodo de ~200 s e termina orbitando um steerpoint
                        // que caiu dentro do proprio circulo de curva -- para de
                        // sequenciar e nunca fecha a volta. Medido na rota anterior:
                        // R = 12 km travava em 8 dos 10 pontos; perna de 14,8 km fechava
                        // volta atras de volta. Aqui a perna e de 14 km, ~2,9 vezes o
                        // raio de curva -- a mesma folga ja medida como suficiente.
                        //
                        // O PARAGRAFO ACIMA E SOBRE ( JSBSimModel ), a linha de base
                        // da familia -- aqui o dynamicsModel: e ( RacModel ), e a
                        // conta muda de dono: maxBankAngle/maxRateOfTurnDps
                        // continuam inertes, mas nao pelo motivo do JSBSim (o
                        // autopiloto do airframe); quem limita e a rampa de G do
                        // proprio RacModel. Com minSpeed: 100 e speedMaxG: 250 (m/s,
                        // ver a armadilha de unidade no cabecalho), a 135 m/s a
                        // rampa da gmax ~1,7 G, ou seja ~7 graus/s e raio de curva de
                        // ~1,1 km -- CALCULADO pela formula de updateRAC(), nao
                        // medido em voo. E cerca de um quarto dos ~4,8 km do JSBSim,
                        // entao a perna de 14 km dimensionada para o caso mais
                        // folgado continua com margem de sobra; a antecipacao de
                        // 2 NM abaixo passa a cortar mais canto do que o necessario,
                        // sem prejuizo para o sequenciamento.
                        //
                        // autoSeqDistance: 2.0 NM (3,7 km) e a antecipacao de curva --
                        // o dobro do r*tan(18 graus) = 1,6 km que a geometria pediria,
                        // dobrado para cobrir o atraso de rolagem acima. A aeronave corta
                        // o canto de cada vertice: comportamento normal de ponto de
                        // passagem (fly-by), nao de sobrevoo.
                        //
                        // NAO HA LANCAMENTO DE ARMA NENHUM nesta rota -- ver a nota no
                        // cabecalho do arquivo. Sobraram tres Action: decoy no piso do
                        // perfil (wp5), imageamento SAR (wp9) e troca de camuflagem
                        // (wp15).
                        //
                        // 'airspeed:' de cada steerpoint e um comando de VOO de verdade
                        // -- ( Navigate ) le Steerpoint::getCmdAirspeedKts() e manda para
                        // o Autopilot via velocityHoldMode. Diferente de built-in_mixr_1
                        // (onde a arvore de PRODUCAO pilota via patrolSpeed:350 e este
                        // campo do steerpoint nunca e lido para voar -- so serve de
                        // metadado), aqui o valor tem efeito. Piso pratico ja medido, e
                        // que continua valendo: comandar 160 kt faz a aeronave nao
                        // conseguir manter altitude E velocidade ao mesmo tempo -- as
                        // duas caem continuamente por ~200 s simulados ate colidir com o
                        // terreno, com rumo FIXO (nada a ver com guiagem/curva --
                        // confirmado isolando a variavel).
                        //
                        // CAMPOS NATIVOS ADICIONAIS por steerpoint -- sca/magvar/pta.
                        // Vocabulario extra que mixr::models::Steerpoint ja aceita
                        // (Steerpoint.hpp) alem de xPos/yPos/altitude/airspeed/description/
                        // action, sem mudar NENHUM comportamento de voo: os tres sao
                        // recalculados TODO frame por Steerpoint::compute()
                        // (Steerpoint.cpp), mas nenhum consumidor deste repositorio
                        // (FlightState.cpp/NavigateAction.cpp/libs/xmsg) le o resultado.
                        // Ficam aqui por completude do vocabulario EDL, nao por efeito
                        // medido -- confirmado lendo o fonte antes de escrever:
                        //   sca (Safe Clearance Altitude, pes): piso de referencia 1000 ft
                        //     abaixo da altitude comandada de cada ponto. Steerpoint::
                        //     compute() calcula 'scaWarn = altitudeAtualFt < sca' TODO
                        //     frame, mas Steerpoint::isWarnSCA() nao e lido por getter
                        //     nenhum neste repositorio.
                        //   magvar (declinacao magnetica, graus): -21.5, ordem de grandeza
                        //     real para a regiao do Rio de Janeiro/SE do Brasil nesta
                        //     decada (nao deriva de um modelo geomagnetico exato -- so
                        //     evita o caso DEGENERADO magvar=0, que faz
                        //     getMagBrgDeg()==getTrueBrgDeg() sempre). NavigateAction so
                        //     consome o bearing VERDADEIRO (navTrueBrgDeg), entao isto nao
                        //     muda a rota voada.
                        //   pta (Planned Time of Arrival, segundos): distancia acumulada
                        //     em linha reta desde a posicao inicial, dividida pela
                        //     velocidade VERDADEIRA de cruzeiro (135 m/s) -- 30 s em wp1,
                        //     2045 s em wp20. E um limite INFERIOR, nao previsao fina: a
                        //     aeronave serpenteia em torno da perna ideal e percorre mais
                        //     que a linha reta. wrap:true faz o ETA crescer sem o PTA
                        //     acompanhar, entao elt (Early/Late Time) fica "atrasado" nas
                        //     voltas seguintes -- esperado, nao um defeito.
                        //
                        // stptType cobre 6 dos 7 valores do enum nativo
                        // (Steerpoint.hpp: enum StptType { DEST, MARK, FIX, OAP, IP,
                        // TGT, TGT_GRP }): os seis se repetem ao longo dos 20 pontos. O
                        // setimo, TGT_GRP, NAO E ALCANCAVEL POR EDL -- existe no enum,
                        // mas Steerpoint::setSlotStptType() (Steerpoint.cpp:325-340) so
                        // reconhece as SEIS strings acima e recusa qualquer outra com
                        // "invalid steerpoint type"; escrever TGT_GRP no .edl derruba o
                        // slot, nao seleciona o tipo.
                        wp1: ( Steerpoint
                           stptType: DEST
                           xPos: ( Meters -15771 )
                           yPos: ( Meters 11326 )
                           altitude: ( Feet 13000 )
                           airspeed: 215.0
                           sca: ( Feet 12000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 30 )
                           description: "ponto 1 -- entrada do lobo LESTE (curvas a direita), inicio da descida"
                        )
                        wp2: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters -15771 )
                           yPos: ( Meters 25326 )
                           altitude: ( Feet 11000 )
                           airspeed: 220.0
                           sca: ( Feet 10000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 135 )
                           description: "ponto 2 -- descida sobre o litoral"
                        )
                        wp3: ( Steerpoint
                           stptType: MARK
                           xPos: ( Meters -24000 )
                           yPos: ( Meters 36652 )
                           altitude: ( Feet 9000 )
                           airspeed: 230.0
                           sca: ( Feet 8000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 235 )
                           description: "ponto 3 -- descida sobre o litoral"
                        )
                        wp4: ( Steerpoint
                           stptType: OAP
                           xPos: ( Meters -37315 )
                           yPos: ( Meters 40979 )
                           altitude: ( Feet 7000 )
                           airspeed: 235.0
                           sca: ( Feet 6000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 340 )
                           description: "ponto 4 -- piso do perfil (4000 ft), relevo quase plano"
                        )
                        wp5: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters -50630 )
                           yPos: ( Meters 36652 )
                           altitude: ( Feet 6000 )
                           airspeed: 240.0
                           sca: ( Feet 5000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 445 )
                           description: "ponto 5 -- piso do perfil, solta decoy"
                           action: ( ActionDecoyRelease
                              numToLaunch: 1
                              interval: ( Seconds 1.0 )
                           )
                        )
                        wp6: ( Steerpoint
                           stptType: MARK
                           xPos: ( Meters -58859 )
                           yPos: ( Meters 25326 )
                           altitude: ( Feet 8000 )
                           airspeed: 230.0
                           sca: ( Feet 7000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 550 )
                           description: "ponto 6 -- inicio da subida longa"
                        )
                        wp7: ( Steerpoint
                           stptType: OAP
                           xPos: ( Meters -58859 )
                           yPos: ( Meters 11326 )
                           altitude: ( Feet 10000 )
                           airspeed: 225.0
                           sca: ( Feet 9000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 655 )
                           description: "ponto 7 -- subida"
                        )
                        wp8: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters -50630 )
                           yPos: ( Meters 0 )
                           altitude: ( Feet 12000 )
                           airspeed: 220.0
                           sca: ( Feet 11000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 755 )
                           description: "ponto 8 -- subida"
                        )
                        wp9: ( Steerpoint
                           stptType: TGT
                           xPos: ( Meters -37315 )
                           yPos: ( Meters -4326 )
                           altitude: ( Feet 14000 )
                           airspeed: 210.0
                           sca: ( Feet 13000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 860 )
                           description: "ponto 9 -- imageamento SAR"
                           action: ( ActionImagingSar
                              sarLatitude:  ( LatLon direction: "s" degrees: 22 minutes: 40 )
                              sarLongitude: ( LatLon direction: "w" degrees: 42 minutes: 12 )
                              sarElevation: ( Meters 20 )
                              resolution:   ( Meters 3 )
                              imageSize:    512
                           )
                        )
                        wp10: ( Steerpoint
                           stptType: IP
                           xPos: ( Meters -24000 )
                           yPos: ( Meters 0 )
                           altitude: ( Feet 16000 )
                           airspeed: 205.0
                           sca: ( Feet 15000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 965 )
                           description: "ponto 10 -- CRUZAMENTO do oito, no teto do perfil (15000 ft)"
                        )
                        wp11: ( Steerpoint
                           stptType: DEST
                           xPos: ( Meters -10685 )
                           yPos: ( Meters 4326 )
                           altitude: ( Feet 17000 )
                           airspeed: 200.0
                           sca: ( Feet 16000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1070 )
                           description: "ponto 11 -- entrada do lobo OESTE (curvas a esquerda), sobre a serra"
                        )
                        wp12: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters 2630 )
                           yPos: ( Meters 0 )
                           altitude: ( Feet 15000 )
                           airspeed: 210.0
                           sca: ( Feet 14000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1170 )
                           description: "ponto 12 -- descida sobre a serra"
                        )
                        wp13: ( Steerpoint
                           stptType: MARK
                           xPos: ( Meters 10859 )
                           yPos: ( Meters -11326 )
                           altitude: ( Feet 13000 )
                           airspeed: 215.0
                           sca: ( Feet 12000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1275 )
                           description: "ponto 13 -- descida sobre a serra"
                        )
                        wp14: ( Steerpoint
                           stptType: OAP
                           xPos: ( Meters 10859 )
                           yPos: ( Meters -25326 )
                           altitude: ( Feet 11000 )
                           airspeed: 220.0
                           sca: ( Feet 10000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1380 )
                           description: "ponto 14 -- descida sobre a serra"
                        )
                        wp15: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters 2630 )
                           yPos: ( Meters -36652 )
                           altitude: ( Feet 10000 )
                           airspeed: 225.0
                           sca: ( Feet 9000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1485 )
                           description: "ponto 15 -- piso do lobo alto (8000 ft), troca a camuflagem (RCS)"
                           action: ( ActionCamouflageType camouflageType: 1 )
                        )
                        wp16: ( Steerpoint
                           stptType: MARK
                           xPos: ( Meters -10685 )
                           yPos: ( Meters -40979 )
                           altitude: ( Feet 12000 )
                           airspeed: 220.0
                           sca: ( Feet 11000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1590 )
                           description: "ponto 16 -- subida"
                        )
                        wp17: ( Steerpoint
                           stptType: OAP
                           xPos: ( Meters -24000 )
                           yPos: ( Meters -36652 )
                           altitude: ( Feet 14000 )
                           airspeed: 210.0
                           sca: ( Feet 13000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1690 )
                           description: "ponto 17 -- subida"
                        )
                        wp18: ( Steerpoint
                           stptType: FIX
                           xPos: ( Meters -32229 )
                           yPos: ( Meters -25326 )
                           altitude: ( Feet 16000 )
                           airspeed: 205.0
                           sca: ( Feet 15000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1795 )
                           description: "ponto 18 -- subida"
                        )
                        wp19: ( Steerpoint
                           stptType: TGT
                           xPos: ( Meters -32229 )
                           yPos: ( Meters -11326 )
                           altitude: ( Feet 17000 )
                           airspeed: 200.0
                           sca: ( Feet 16000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 1900 )
                           description: "ponto 19 -- teto do lobo oeste"
                        )
                        wp20: ( Steerpoint
                           stptType: IP
                           xPos: ( Meters -24000 )
                           yPos: ( Meters 0 )
                           altitude: ( Feet 15000 )
                           airspeed: 210.0
                           sca: ( Feet 14000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 2005 )
                           description: "ponto 20 -- CRUZAMENTO do oito, fechando a volta"
                        )
                     }
                  )
                  components: {
                     gps: ( Gps )
                  }
               )

               // --- 4) Datalink -----------------------------------------
               datalink: ( AlertDatalink
                  holdTime: ( Seconds 25 )
                  trackManagerName: twsTrkMgr
                  maxRange: ( NauticalMiles 100 )
               )

               // --- 5) Radio --------------------------------------------
               comm1: ( CommRadio
                  radioID: 1
                  numChannels: 4
                  channels: { ( MegaHertz 225.0 ) ( MegaHertz 243.0 )
                              ( MegaHertz 251.0 ) ( MegaHertz 300.0 ) }
                  channel: 1
                  maxDetectRange: ( NauticalMiles 120 )
                  powerPeak: ( Watts 10.0 )
                  frequency: ( MegaHertz 225.0 )
                  bandwidth: ( KiloHertz 25.0 )
                  components: {
                     iff: ( Iff
                        radioID: 2
                        powerPeak: ( Watts 5.0 )
                        frequency: ( MegaHertz 1030.0 )
                        bandwidth: ( MegaHertz 2.0 )
                        mode1: 3
                        mode2: 4096
                        mode3a: 1200
                        enableMode1: true
                        enableMode2: true
                        enableMode3a: true
                        enableModeC: true
                     )
                  }
               )

               // --- 6) Gimbal -------------------------------------------
               antennas: ( Gimbal
                  components: {

                     ant_tws: ( Antenna
                        polarization: horizontal
                        gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]
                        maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth:   ( Degrees 60 )
                        commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]
                        searchVolume: [ 1.0472 0.05 ]
                        numBars: 2
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_stt: ( Antenna
                        polarization: horizontal
                        gain: ( dB 44 )
                        initPosition: [ 0 0 ]
                        maxRates: [ 1.5 1.5 ]
                        maxPlayersOfInterest: 4
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 30.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_gmti: ( Antenna
                        polarization: vertical
                        gain: ( dB 38 )
                        initPosition: [ 0 -0.35 ]
                        maxRates: [ 0.8727 0.8727 ]
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { ground ship }
                        maxRange2PlayersOfInterest: ( NauticalMiles 30.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_rwr: ( Antenna
                        polarization: vertical
                        gain: ( dB 3 )
                        initPosition: [ 0 0 ]
                        maxPlayersOfInterest: 16
                        playerOfInterestTypes: { air ground ship }
                        maxRange2PlayersOfInterest: ( NauticalMiles 80.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 180.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     ant_jam: ( Antenna
                        polarization: vertical
                        gain: ( dB 20 )
                        initPosition: [ 3.1416 0 ]
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air ground }
                        maxRange2PlayersOfInterest: ( NauticalMiles 60.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 120.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )

                     estab: ( StabilizingGimbal
                        stabilizingMode: roll
                        components: {
                           ant_sar: ( Antenna
                              polarization: vertical
                              gain: ( dB 40 )
                              initPosition: [ 0 -0.5 ]
                              maxPlayersOfInterest: 4
                              playerOfInterestTypes: { ground }
                              maxRange2PlayersOfInterest: ( NauticalMiles 20.0 )
                              maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                              localPlayersOfInterestOnly: false
                              useWorldCoordinates: false
                           )
                        }
                     )

                     irst: ( IrSeeker
                        initPosition: [ 0 0 ]
                        maxRates: [ 1.0 1.0 ]
                        searchVolume: [ 0.5236 0.1745 ]
                        numBars: 2
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 25.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 45.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )
                  }
               )

               // --- 7) RfSensor -----------------------------------------
               sensors: ( SensorMgr
                  components: {

                     tws: ( Tws
                        trackManagerName: twsTrkMgr
                        antennaName: ant_tws
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 2.0 )
                        PRF:        ( Hertz 500.0 )
                        pulseWidth: ( MilliSeconds 0.01 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 80 ]
                        initRangeIdx: 2
                     )

                     stt: ( Stt
                        trackManagerName: twsTrkMgr
                        antennaName: ant_stt
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 1.0 )
                        PRF:        ( Hertz 2000.0 )
                        pulseWidth: ( MilliSeconds 0.005 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 ]
                        initRangeIdx: 2
                     )

                     gmti: ( Gmti
                        trackManagerName: gmtiTrkMgr
                        antennaName: ant_gmti
                        powerPeak:  ( KiloWatts 150.0 )
                        frequency:  ( GigaHertz 9.5 )
                        bandwidth:  ( MegaHertz 500.0 )
                        PRF:        ( Hertz 1000.0 )
                        pulseWidth: ( MilliSeconds 0.008 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 30 ]
                        initRangeIdx: 1
                     )

                     sar: ( Sar
                        antennaName: ant_sar
                        powerPeak:  ( KiloWatts 150.0 )
                        frequency:  ( GigaHertz 9.5 )
                        bandwidth:  ( MegaHertz 500.0 )
                        PRF:        ( Hertz 1500.0 )
                        pulseWidth: ( MilliSeconds 0.004 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        chipSize: 512
                     )

                     rwr: ( Rwr
                        trackManagerName: rwrTrkMgr
                        antennaName: ant_rwr
                        disableEmissions: true
                        frequency:  ( GigaHertz 6.0 )
                        bandwidth:  ( GigaHertz 10.0 )
                        threshold:  ( dB 0.0 )
                     )

                     jam: ( Jammer
                        antennaName: ant_jam
                        powerPeak: ( Watts 500.0 )
                        frequency: ( GigaHertz 3.0 )
                        bandwidth: ( GigaHertz 1.0 )
                        disableEmissions: true
                     )
                  }
               )

               // --- 8) IrSystem -----------------------------------------
               irsystem: ( IrSensor
                  seekerName: irst
                  trackManagerName: irTrkMgr
                  lowerWavelength: 3.0
                  upperWavelength: 5.0
                  nei: 0.00001
                  threshold: 1.0
                  IFOV: 0.0003
                  sensorType: "contrast"
                  maximumRange: ( NauticalMiles 25 )
               )

               // --- 9) OnboardComputer ----------------------------------
               obc: ( OnboardComputer
                  components: {
                     twsTrkMgr: ( AirTrkMgr
                        maxTracks: 20   alpha: 1.0  beta: 0.5  gamma: 0.0
                        positionGate: 1500  rangeGate: 500  velocityGate: 10
                        firstTrackId: 1000
                     )
                     rwrTrkMgr: ( RwrTrkMgr
                        maxTracks: 20   alpha: 2.0  beta: 0.0  gamma: 0.0
                        firstTrackId: 2000
                     )
                     gmtiTrkMgr: ( GmtiTrkMgr
                        maxTracks: 20   alpha: 1.0  beta: 0.5  gamma: 0.0
                        firstTrackId: 3000
                     )
                     irTrkMgr: ( AirAngleOnlyTrkMgr
                        maxTracks: 20   alpha: 1.0  beta: 0.5  gamma: 0.0
                        azimuthBin:   ( Degrees 5 )
                        elevationBin: ( Degrees 5 )
                        firstTrackId: 4000
                     )
                  }
               )

               // --- 10) StoresMgr ---------------------------------------
               stores: ( StoresMgr
                  numStations: 11
                  stores: {
                     1: ( AamMissile
                        id: 501  side: blue  type: "AIM-9"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 30 )
                        maxBurstRng: ( Meters 150 )  maxGimbal: ( Degrees 45 )
                     )
                     2: ( AamMissile
                        id: 502  side: blue  type: "AIM-9"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 30 )
                        maxBurstRng: ( Meters 150 )  maxGimbal: ( Degrees 45 )
                     )
                     3: ( AgmMissile
                        id: 503  side: blue  type: "AGM-65"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 90 )  lethalRange: ( Meters 40 )
                        maxBurstRng: ( Meters 200 )
                     )
                     4: ( Sam
                        id: 504  side: blue  type: "SAM-demo"
                        signature: ( SigSphere radius: 0.2 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 30 )
                     )
                     5: ( Bomb
                        id: 505  side: blue  type: "MK-82"
                        signature: ( SigSphere radius: 0.3 )
                        dataLogTime: ( Seconds 0.1 )
                        arming: free_fall
                        noseFuze: true  tailFuze: true
                        fuzeAltitude: ( Meters 0 )
                        dragIndex: 0.0006
                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 50 )
                     )
                     6: ( Chaff
                        id: 506  side: blue  type: "chaff"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 20 )  dragIndex: 0.02
                     )
                     7: ( Flare
                        id: 507  side: blue  type: "flare"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 20 )  dragIndex: 0.02
                     )
                     8: ( Decoy
                        id: 508  side: blue  type: "decoy"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 30 )  dragIndex: 0.01
                     )
                     9: ( Gun
                        type: "M61A1"
                        rounds: 510
                        rate: 6000
                        burstRate: 10
                        position: [ 2.0 0.0 -0.3 ]
                        bulletType: ( Bullet
                           id: 509  side: blue  type: "20mm"
                           maxTOF: ( Seconds 6 )  lethalRange: ( Meters 3 )
                        )
                     )
                     10: ( FuelTank
                        type: "tanque-ventral"
                        jettisonable: true
                        fuelWt:   1200.0
                        capacity: 1200.0
                     )
                     11: ( AvionicsPod
                        type: "pod-recon"
                        jettisonable: false
                     )
                  }
               )

               // --- extra: deteccao de colisao --------------------------
               colisao: ( CollisionDetect
                  collisionRange: ( Meters 100 )
                  maxPlayers: 20
                  playerTypes: { air }
                  maxRange2Players: ( NauticalMiles 5.0 )
                  maxAngle2Players: ( Degrees 180.0 )
                  localOnly: false
                  useWorldCoordinates: false
                  sendCrashEvents: false
               )

               // --- o AGENTE: UBF completo, arvore de UM no so ----------
               // Componente do PLAYER (nao da Station), decidindo na FASE 3
               // do frame de tempo critico -- o mesmo padrao usado por
               // built-in_mixr_1 e por todo cenario deste repositorio.
               // state/behavior sao os mesmos
               // tres papeis do UBF de producao (percepcao/decisao/
               // atuacao): so a arvore dentro do behavior muda.
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( BtBehavior
                     treeFile: "./dist/share/mixr-plugins/flight/flight_tree_nav.xml"
                  )
               )
            }
         )

         a4_4: ( Aircraft
            id: 104
            side: blue
            type: "A4"

            // ASSINATURA RF COMUTAVEL -- identica a built-in_mixr_1. Sem
            // outro aviao para medir contra, e so estrutural aqui, mas o
            // camouflageType ainda muda de verdade quando wp3 dispara
            // ( ActionCamouflageType ).
            camouflageType: 0
            signature: ( SigSwitch
               components: {
                  limpo: ( SigSphere radius: 3.0 )
                  placa: ( SigPlate a: ( Meters 6.0 ) b: ( Meters 2.0 ) )
                  const: ( SigConstant rcs: ( SquareMeters 2.5 ) )
                  died:  ( SigDihedralCR  a: ( Meters 1.5 ) b: ( Meters 1.5 ) )
                  tried: ( SigTrihedralCR a: ( Meters 1.5 ) b: ( Meters 1.5 ) )
                  azel:  ( SigAzEl
                     inDegrees: true
                     inDecibel: true
                     table: ( Table2
                        x: [ -180.0  -90.0  0.0  90.0  180.0 ]
                        y: [  -30.0    0.0  30.0 ]
                        data: { [  3.0   8.0  12.0   8.0   3.0 ]
                                [  5.0  10.0  15.0  10.0   5.0 ]
                                [  3.0   8.0  12.0   8.0   3.0 ] }
                     )
                  )
               }
            )

            irSignature: ( IrSignature
               baseHeatSignature: 320.0
               emissivity:          0.75
               effectiveArea:     ( SquareMeters 3.0 )
               irShapeSignature:  ( IrSphere radius: ( Meters 2.0 ) )
            )

            // POSICAO/ATITUDE INICIAL SOBRE A PERNA DE ENTRADA, nao num ponto
            // solto no meio do circuito. Comecar DENTRO do circuito de 10
            // steerpoints declarado abaixo, apontando para outro lado, faz a
            // perseguicao pura do ( Navigate ) orbitar o primeiro ponto sem
            // nunca alcanca-lo: com 24 km de raio de circuito contra ~5,5 km
            // de raio de curva da aeronave (ver a nota "POR QUE 24 km DE
            // RAIO" no bloco da rota), o alvo cai dentro do proprio circulo
            // de curva e a rota nunca sequencia. Aqui o aviao nasce 4 km
            // ANTES de wp1, em cima da perna wp10->wp1, ja no rumo dela
            // (072), ja na altitude comandada por wp1 (5000 ft) e ja na
            // velocidade de cruzeiro: nao ha transiente de juncao nenhum.
            initXPos:     ( Meters -18122 )
            initYPos:     ( Meters 8090 )
            initAlt:      ( Feet 14000 )
            initHeading:  ( Degrees 54 )
            // initVelocityKts, nao initVelocity: 'initVelocity' e METROS POR
            // SEGUNDO (Player.cpp:75 -- "initVelocity: Initial Velocity:
            // meters/sec"), e o slot em KNOTS e outro (Player.cpp:76,
            // 'initVelocityKts'). Com 'initVelocity: 350.0' a aeronave nascia
            // a 350 m/s = 680 kt (medido: mach 0.97 no frame 100) e passava os
            // primeiros ~60 s desacelerando para a faixa comandada pelos
            // steerpoints -- transiente gratuito, agora removido. 280 kt e a
            // velocidade VERDADEIRA que o escalonamento de subida dos
            // steerpoints mantem do piso ao teto do perfil (~145 m/s; ver o
            // bloco da rota), entao a aeronave ja nasce estabilizada nela.
            initVelocityKts: 262.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true

            components: {

               // --- 1) DynamicsModel ------------------------------------
               // RacModel: cinematico, "3DOF" informal -- ver o cabecalho
               // deste arquivo para a justificativa do rotulo e de cada
               // numero abaixo.
               //   cmdAltitude/cmdHeading/cmdSpeed = os mesmos initAlt/
               //     initHeading/initVelocityKts DESTE player (14000 ft /
               //     54 deg / 262 kt) -- estado inicial coerente com a pose
               //     real de partida; o Autopilot sobrescreve isso a cada
               //     frame de qualquer forma (os tres hold modes sao true).
               //     cmdAltitude e base::Distance e cmdSpeed e em NOS.
               //   maxg/maxAccel = os proprios defaults compilados da
               //     classe (RacModel.hpp: gMax{4.0}, maxAccel{10.0}) --
               //     sem precedente de uso no repo, usa-se o default do
               //     autor da classe em vez de inventar numero novo.
               //   minSpeed/speedMaxG = em M/S (ver a armadilha de unidade
               //     no cabecalho), escolhidos para a faixa de ~135 m/s
               //     (262 kt) que os steerpoints desta rota comandam:
               //     minSpeed abaixo dela para gmax ficar > 1 G (com
               //     V < minSpeed a rampa produz gmax < 1 e a curva
               //     degrada), speedMaxG no default compilado da classe.
               dynamicsModel: ( RacModel
                  minSpeed:    100.0
                  speedMaxG:   250.0
                  maxg:        4.0
                  maxAccel:    10.0
                  cmdAltitude: ( Feet 14000 )
                  cmdHeading:  ( Degrees 54 )
                  cmdSpeed:    262.0
               )

               // --- 2) Pilot --------------------------------------------
               // navMode FALSE mesmo esta poc sendo sobre navegacao: quem
               // atua e o UBF (via FlightAction), nao o
               // Autopilot::processModeNavigation() nativo -- ver o
               // cabecalho de flight_tree_nav.xml para o raciocinio
               // completo. Com navMode:true o Autopilot leria a MESMA
               // Navigation por um segundo caminho e disputaria o comando
               // com a arvore a cada frame.
               pilot: ( Autopilot
                  navMode: false
                  headingHoldMode:  true
                  altitudeHoldMode: true
                  velocityHoldMode: true
                  maxRateOfTurnDps: 6.0
                  maxBankAngle:    45.0
                  maxPitchAngle:   20.0
                  maxClimbRateMps:  40.0
                  maxAcceleration:  6.0
               )

               // --- 3) Navigation ---------------------------------------
               // ( Ins ) E uma ( Navigation ), e o ( Gps ) aninhado tambem
               // -- por isso o Gps entra como FILHO, nao como irmao.
               //
               // As quatro Action disparam TODA VOLTA aqui (sem arvore de
               // patrulha abandonando o circuito, como em
               // built-in_mixr_1): decoy, SAR, camuflagem e bomba se
               // repetem a cada wrap da rota.
               nav: ( Ins
                  bullseye: ( Bullseye
                     latitude:  ( Degrees -22.25 )
                     longitude: ( Degrees -42.48 )
                  )
                  route: ( Route
                     to: 1
                     autoSequence: true
                     autoSeqDistance: ( NauticalMiles 2.0 )
                     wrap: true
                     components: {
                        // ============================================================
                        // FIGURA-DE-OITO DE 20 STEERPOINTS, OITO AERONAVES EMPILHADAS
                        // ============================================================
                        // A rota nao e um circuito convexo: e um OITO fechado, com 10
                        // curvas para a DIREITA seguidas de 10 para a ESQUERDA. Como se
                        // constroi, e por que fecha exatamente:
                        //
                        //   rumo das cordas do lobo LESTE:  t + 18 + 36k   (k = 0..9)
                        //   rumo das cordas do lobo OESTE:  t - 18 - 36k   (k = 0..9)
                        //
                        // As dez direcoes de um decagono somam ZERO, entao CADA lobo
                        // fecha sozinho no ponto de cruzamento -- o erro de fechamento do
                        // poligono inteiro e de 0,000 m, nao um valor "pequeno o
                        // bastante". E nas DUAS juncoes o rumo e CONTINUO (o lobo leste
                        // termina em t-18 e o oeste comeca em t-18; o oeste termina em
                        // t+18 e o leste comeca em t+18): a aeronave ATRAVESSA o
                        // cruzamento em linha reta, como num oito de verdade.
                        //
                        // ARMADILHA DA CONSTRUCAO INGENUA, batida antes de chegar nesta:
                        // fazer os dois lobos partirem do cruzamento com o MESMO rumo
                        // tambem fecha e tambem alterna o lado da curva -- mas ai os dois
                        // compartilham a perna inteira que sai dali (wp1 e wp11 caem no
                        // MESMO ponto), e o resultado nao e um oito: sao duas voltas
                        // sobre o mesmo trecho. O deslocamento de meia-perna (o "+18/-18"
                        // acima) e o que separa os dois casos.
                        //
                        // wp10 e wp20 sao o MESMO ponto no mapa (o cruzamento). E
                        // proposital: a aeronave passa por ali duas vezes por volta, em
                        // alturas diferentes do perfil (15000 e 13000 ft na a4_1).
                        //
                        // ONDE O OITO FOI POSTO -- escolhido por VARREDURA DE TERRENO,
                        // nao a olho. 207 colocacoes cabem inteiras no tile SRTM
                        // (S23W043) e foram pontuadas pelo relevo mais alto sob as 20
                        // pernas; a vencedora poe o cruzamento em (-24000, 0) m com
                        // t = 36 graus. O ganho nao e so folga: os dois lobos caem sobre
                        // relevos MUITO diferentes, e e isso que da sentido ao perfil.
                        //   lobo LESTE  (wp1..wp9):   relevo de 5 a 250 m -- litoral e
                        //                             mar, praticamente plano.
                        //   lobo OESTE  (wp11..wp19): relevo de 300 a 1338 m -- a serra.
                        // Por isso a aeronave desce ao piso do perfil no lobo leste e so
                        // pode descer ate 8000 ft no lobo oeste. O perfil nao foi colado
                        // por cima da geografia: saiu dela.
                        //
                        // PERFIL DE ALTITUDE (a4_1, a mais baixa da pilha), em pes:
                        //   wp1..wp10  11000  9000  7000  5000  4000  6000  8000 10000 12000 14000
                        //   wp11..wp20 15000 13000 11000  9000  8000 10000 12000 14000 15000 13000
                        // Sao DUAS descidas-e-subidas completas por volta, uma por lobo:
                        // 11000 -> 4000 -> 15000 no lobo leste (11000 ft de amplitude) e
                        // 15000 -> 8000 -> 15000 no oeste (7000 ft). A a4_8 voa o mesmo
                        // perfil 7000 ft acima: 11000..22000 ft.
                        //
                        // POR QUE O DEGRAU MAXIMO E DE 2000 ft POR PERNA, e nao mais --
                        // MEDIDO, nao escolhido por gosto. A versao anterior deste perfil
                        // tinha dente-de-serra de +-4000 ft com periodo de UMA perna
                        // (~110 s) no lobo alto; rodando, a malha de altitude nao
                        // acompanha: a aeronave achatava em torno de 12500 ft (a4_1) /
                        // 18900 ft (a4_8) e ficava 2200 a 3100 ft atras do comando ponto
                        // a ponto -- ou seja, o perfil "mais acentuado" no papel virava
                        // um perfil MENOS variado no ar. Com as rampas espalhadas por
                        // varias pernas o erro na passagem cai para a casa das centenas
                        // de pes, inclusive na a4_8 subindo a 22000 ft. Amplitude total
                        // preservada; o que mudou foi a taxa.
                        //
                        // A PILHA DE OITO AERONAVES. a4_1..a4_8 sao identicas (mesmo
                        // player maximo, mesmo agent:, mesma arvore) e cumprem a MESMA
                        // rota; a unica diferenca e um deslocamento de +1000 ft por
                        // aeronave em TODOS os 20 steerpoints. Elas nascem na mesma
                        // posicao horizontal, empilhadas -- separacao VERTICAL.
                        //
                        //   * O 'airspeed:' de cada steerpoint e recalculado POR
                        //     AERONAVE, e e isso que impede a pilha de se desmanchar. A
                        //     malha de velocidade do a4ap.xml fecha contra
                        //     velocities/vc-kts (velocidade CALIBRADA), enquanto quem
                        //     define a geometria da curva e a VERDADEIRA. Comandar a
                        //     mesma calibrada nas oito faria a a4_8, 7000 ft acima, voar
                        //     ~13% mais rapido em verdadeira e escapar da formacao em uma
                        //     volta. Cada steerpoint carrega a calibrada que da 262 kt
                        //     VERDADEIROS (135 m/s) na altitude DAQUELE ponto -- por isso
                        //     os numeros de airspeed diferem entre a4_1 e a4_8 no mesmo
                        //     wp.
                        //   * ESTE 'airspeed:' CALIBRADO NAO TEM EFEITO AQUI. O
                        //     numero foi herdado de A4-6DOF sem mudanca (a unica
                        //     diferenca deste cenario e o dynamicsModel:), mas o
                        //     RacModel trata o valor comandado como velocidade
                        //     VERDADEIRA -- converte por NM2M/3600 e compara com
                        //     Player::getTotalVelocity() (RacModel.cpp:280).
                        //     Resultado: as oito comandam verdadeiras um pouco
                        //     diferentes entre si e a pilha se estica ao longo da
                        //     rota em vez de ficar alinhada. Para colar a formacao
                        //     sob este modelo, os vinte 'airspeed:' teriam de voltar
                        //     a ser o MESMO valor (262) nas oito -- mudanca de
                        //     cenario, fora do escopo desta variante.
                        //   * ( CollisionDetect ) tem collisionRange: 100 m e
                        //     sendCrashEvents: false. 1000 ft = 305 m, entao a pilha nem
                        //     entra no alcance de deteccao -- e mesmo que entrasse, nao
                        //     ha CRASH_EVENT vindo dali.
                        //
                        // POR QUE PERNAS DE 14 km (lobos de 22,7 km de raio) -- MEDIDO
                        // RODANDO, e o mesmo limite que ja dimensionava a rota anterior.
                        // maxBankAngle/maxRateOfTurnDps do ( Autopilot ) acima sao
                        // INERTES com ( JSBSimModel ): os dois chegam a
                        // JSBSimModel::setCommandedHeadingD(h,,) como parametros SEM NOME
                        // e sao descartados (Autopilot.hpp:66-71 documenta a ressalva).
                        // Quem manda e o autopiloto do proprio airframe,
                        // data/jsbsim/aircraft/A4/a4ap.xml: erro de rumo limitado a +-30
                        // graus, ganho 1:1 de erro para inclinacao, e um nivelador de asa
                        // (-0.8*phi) sempre ligado que na pratica segura o banco em ~25
                        // graus. A 135 m/s isso da raio de curva de ~4,8 km e uma
                        // REVERSAO de banco que leva ~30 s. Em circuito apertado a
                        // aeronave passa do rumo da perna seguinte em 40 a 100 graus,
                        // oscila com periodo de ~200 s e termina orbitando um steerpoint
                        // que caiu dentro do proprio circulo de curva -- para de
                        // sequenciar e nunca fecha a volta. Medido na rota anterior:
                        // R = 12 km travava em 8 dos 10 pontos; perna de 14,8 km fechava
                        // volta atras de volta. Aqui a perna e de 14 km, ~2,9 vezes o
                        // raio de curva -- a mesma folga ja medida como suficiente.
                        //
                        // O PARAGRAFO ACIMA E SOBRE ( JSBSimModel ), a linha de base
                        // da familia -- aqui o dynamicsModel: e ( RacModel ), e a
                        // conta muda de dono: maxBankAngle/maxRateOfTurnDps
                        // continuam inertes, mas nao pelo motivo do JSBSim (o
                        // autopiloto do airframe); quem limita e a rampa de G do
                        // proprio RacModel. Com minSpeed: 100 e speedMaxG: 250 (m/s,
                        // ver a armadilha de unidade no cabecalho), a 135 m/s a
                        // rampa da gmax ~1,7 G, ou seja ~7 graus/s e raio de curva de
                        // ~1,1 km -- CALCULADO pela formula de updateRAC(), nao
                        // medido em voo. E cerca de um quarto dos ~4,8 km do JSBSim,
                        // entao a perna de 14 km dimensionada para o caso mais
                        // folgado continua com margem de sobra; a antecipacao de
                        // 2 NM abaixo passa a cortar mais canto do que o necessario,
                        // sem prejuizo para o sequenciamento.
                        //
                        // autoSeqDistance: 2.0 NM (3,7 km) e a antecipacao de curva --
                        // o dobro do r*tan(18 graus) = 1,6 km que a geometria pediria,
                        // dobrado para cobrir o atraso de rolagem acima. A aeronave corta
                        // o canto de cada vertice: comportamento normal de ponto de
                        // passagem (fly-by), nao de sobrevoo.
                        //
                        // NAO HA LANCAMENTO DE ARMA NENHUM nesta rota -- ver a nota no
                        // cabecalho do arquivo. Sobraram tres Action: decoy no piso do
                        // perfil (wp5), imageamento SAR (wp9) e troca de camuflagem
                        // (wp15).
                        //
                        // 'airspeed:' de cada steerpoint e um comando de VOO de verdade
                        // -- ( Navigate ) le Steerpoint::getCmdAirspeedKts() e manda para
                        // o Autopilot via velocityHoldMode. Diferente de built-in_mixr_1
                        // (onde a arvore de PRODUCAO pilota via patrolSpeed:350 e este
                        // campo do steerpoint nunca e lido para voar -- so serve de
                        // metadado), aqui o valor tem efeito. Piso pratico ja medido, e
                        // que continua valendo: comandar 160 kt faz a aeronave nao
                        // conseguir manter altitude E velocidade ao mesmo tempo -- as
                        // duas caem continuamente por ~200 s simulados ate colidir com o
                        // terreno, com rumo FIXO (nada a ver com guiagem/curva --
                        // confirmado isolando a variavel).
                        //
                        // CAMPOS NATIVOS ADICIONAIS por steerpoint -- sca/magvar/pta.
                        // Vocabulario extra que mixr::models::Steerpoint ja aceita
                        // (Steerpoint.hpp) alem de xPos/yPos/altitude/airspeed/description/
                        // action, sem mudar NENHUM comportamento de voo: os tres sao
                        // recalculados TODO frame por Steerpoint::compute()
                        // (Steerpoint.cpp), mas nenhum consumidor deste repositorio
                        // (FlightState.cpp/NavigateAction.cpp/libs/xmsg) le o resultado.
                        // Ficam aqui por completude do vocabulario EDL, nao por efeito
                        // medido -- confirmado lendo o fonte antes de escrever:
                        //   sca (Safe Clearance Altitude, pes): piso de referencia 1000 ft
                        //     abaixo da altitude comandada de cada ponto. Steerpoint::
                        //     compute() calcula 'scaWarn = altitudeAtualFt < sca' TODO
                        //     frame, mas Steerpoint::isWarnSCA() nao e lido por getter
                        //     nenhum neste repositorio.
                        //   magvar (declinacao magnetica, graus): -21.5, ordem de grandeza
                        //     real para a regiao do Rio de Janeiro/SE do Brasil nesta
                        //     decada (nao deriva de um modelo geomagnetico exato -- so
                        //     evita o caso DEGENERADO magvar=0, que faz
                        //     getMagBrgDeg()==getTrueBrgDeg() sempre). NavigateAction so
                        //     consome o bearing VERDADEIRO (navTrueBrgDeg), entao isto nao
                        //     muda a rota voada.
                        //   pta (Planned Time of Arrival, segundos): distancia acumulada
                        //     em linha reta desde a posicao inicial, dividida pela
                        //     velocidade VERDADEIRA de cruzeiro (135 m/s) -- 30 s em wp1,
                        //     2045 s em wp20. E um limite INFERIOR, nao previsao fina: a
                        //     aeronave serpenteia em torno da perna ideal e percorre mais
                        //     que a linha reta. wrap:true faz o ETA crescer sem o PTA
                        //     acompanhar, entao elt (Early/Late Time) fica "atrasado" nas
                        //     voltas seguintes -- esperado, nao um defeito.
                        //
                        // stptType cobre 6 dos 7 valores do enum nativo
                        // (Steerpoint.hpp: enum StptType { DEST, MARK, FIX, OAP, IP,
                        // TGT, TGT_GRP }): os seis se repetem ao longo dos 20 pontos. O
                        // setimo, TGT_GRP, NAO E ALCANCAVEL POR EDL -- existe no enum,
                        // mas Steerpoint::setSlotStptType() (Steerpoint.cpp:325-340) so
                        // reconhece as SEIS strings acima e recusa qualquer outra com
                        // "invalid steerpoint type"; escrever TGT_GRP no .edl derruba o
                        // slot, nao seleciona o tipo.
                        wp1: ( Steerpoint
                           stptType: DEST
                           xPos: ( Meters -15771 )
                           yPos: ( Meters 11326 )
                           altitude: ( Feet 14000 )
                           airspeed: 210.0
                           sca: ( Feet 13000 )
                           magvar: ( Degrees -21.5 )
                           pta: ( Seconds 30 )
                           description: "ponto 1 -- entrada do lobo LESTE (curvas a direita), inicio da descida"
                        )
                        wp2: ( Steerpoint
