                        maxTOF: ( Seconds 60 )  lethalRange: ( Meters 50 )
                     )
                     6: ( Chaff
                        id: 506  side: blue  type: "chaff"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 20 )  dragIndex: 0.02
                     )
                     7: ( Flare
                        id: 507  side: blue  type: "flare"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 20 )  dragIndex: 0.02
                     )
                     8: ( Decoy
                        id: 508  side: blue  type: "decoy"
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 30 )  dragIndex: 0.01
                     )
                     9: ( Gun
                        type: "M61A1"
                        rounds: 510
                        rate: 6000
                        burstRate: 10
                        position: [ 2.0 0.0 -0.3 ]
                        bulletType: ( Bullet
                           id: 509  side: blue  type: "20mm"
                           maxTOF: ( Seconds 6 )  lethalRange: ( Meters 3 )
                        )
                     )
                     10: ( FuelTank
                        type: "tanque-ventral"
                        jettisonable: true
