build*
dist
.claude/settings.local.json

# tile SRTM: versiona-se o .gz (12 MB); o .hgt descomprimido (25 MB) e
# artefato gerado na primeira execucao -- ver app/TerrainData.
shared/data/terrain/srtm/*.hgt

# deposito de plugins de terceiros (.so pre-compilado, externo a este
# repositorio) -- ver models/plugins/README.md. 'make models' copia
# qualquer .so encontrado aqui pra dist/lib/mixr-plugins/.
models/plugins/*.so

# gravacoes Tacview e logs: artefatos de CADA execucao, um por poc (ver
# shared/xtacview, shared/xlog) -- so o .gitkeep de cada data/recordings/
# e data/logs/ e versionado, nunca o conteudo gerado. 'app/' (o dashboard)
# mora fora de 'src/', por isso o padrao repete pros dois prefixos.
src/*/data/recordings/*.acmi
src/*/data/logs/*.log*
app/data/recordings/*.acmi
app/data/logs/*.log*

# saida do shared/xmsg (mensagens configuraveis)
src/*/data/messages/*.jsonl
app/data/messages/*.jsonl
