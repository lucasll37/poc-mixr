//
// Subprojeto 09 - chaff-flare
//
// Mesmas features das pocs anteriores (6-DOF via JSBSimModel/F4N da
// poc/04, Tacview das pocs 04/05/07/08) -- a novidade e o lancamento de
// chaff/flare, usando o mecanismo NATIVO do MIXR: Chaff/Flare
// (mixr::models::player::effect, subclasses de Effect/AbstractWeapon,
// "podem ser jettisoned/released e virar players independentes" -- ver
// doc do proprio Effect.hpp) armazenados num StoresMgr comum (mesmo
// padrao de estoque de armas usado em poc/03 com AamMissile, so trocando
// o tipo de store), liberados via StoresMgr::releaseOneChaff()/
// releaseOneFlare() (main.cpp).
//
// Sem radar/Antenna nesta poc -- por isso sem #include (gainPattern.epp
// so e necessario quando ha um componente Antenna) e sem o passo de
// preprocessador C das pocs 05-08.
//

( Station

  tcPriority: 0.5
  // Exportacao pela cadeia nativa: o hunter (REID_PLAYER_DATA) e os
  // chaff/flare liberados (REID_WEAPON_RELEASED / REID_PLAYER_REMOVED)
  // viram linhas ACMI sem o main.cpp rastrear nada.
  dataRecorder: ( DataRecorder
     eventName: "poc-09-chaff-flare"
     enabledList: [ 43 42 ]
     outputHandler: ( RecorderOutputHandler
        components: {
           ( TacviewOutput
              port: 1234
              callsign: "poc-mixr/chaff-flare"
              fileName: "./poc/09-chaff-flare/data/recordings/mission.acmi"
              typeMap:  { hunter: "Air+FixedWing"
                          Chaff:  "Misc+Decoy+Chaff"
                          Flare:  "Misc+Decoy+Flare" }
              colorMap: { hunter: "Blue"  Chaff: "Blue"  Flare: "Red" }
           )
        }
     )
  )


  ownship: hunter
  simulation: ( WorldModel

     latitude:  37.0
     longitude: -116.0

     players: {

        hunter: ( Aircraft

           id: 201
           side: blue
           type: "F4N"
           signature: ( SigSphere radius: 2.0 )

           initXPos:     ( NauticalMiles 0 )
           initYPos:     ( NauticalMiles 0 )
           initAlt:      ( Feet 15000 )
           initHeading:  ( Degrees 0 )
           initVelocity: 350

           // 10 Hz -- nasce ZERO; sem este slot nao emite REID_PLAYER_DATA
           dataLogTime: ( Seconds 0.1 )

           components: {

              // JSBSimModel: mesma aeronave/dados da poc/04 (6-DOF real).
              dynamicsModel: ( JSBSimModel
                 rootDir: "./poc/04-jsbsim-6dof/data/jsbsim/"
                 model: "F4N"
                 debugLevel: 0
              )

              // Estoque de chaff/flare -- mesmo StoresMgr/padrao de
              // "components: { N: (Tipo ...) }" usado pra mísseis na
              // poc/03, so que com Chaff/Flare no lugar de AamMissile.
              // Sem signature/irSignature: nao ha radar/seeker nesta poc
              // pra ser efetivamente enganado, o objetivo aqui e so
              // demonstrar o lancamento e a visualizacao no Tacview.
              sms: ( StoresMgr
                 numStations: 16
                 stores: {
                    1: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    2: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    3: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    4: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    5: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    6: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    7: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    8: ( Chaff type: "Chaff" dataLogTime: ( Seconds 0.1 ) )
                    9: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    10: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    11: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    12: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    13: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    14: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    15: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                    16: ( Flare type: "Flare" dataLogTime: ( Seconds 0.1 ) )
                 }
              )

           } // components

        ) // hunter

     } // players

  ) // simulation

) // station
