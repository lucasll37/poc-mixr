//
// multi-thread
//
// O single-thread INTEIRO, com UMA unica diferenca: o agente do UBF e um
// AgentTC proprio (xnative::FlightAgentTC), que decide na FASE 3 do frame
// de tempo critico, no lugar do ( SimAgent ) nativo, que decide em
// updateData() (thread de background).
//
// Todo o resto e identico ao single-thread -- mesma pilha nativa, mesmos
// numeros, mesma arvore de comportamento:
//
//   peca            single-thread               multi-thread
//   --------------  --------------------------  --------------------------
//   player          ( Aircraft )                igual
//   dinamica 6-DOF  ( JSBSimModel )             igual
//   controle        ( Autopilot )               igual
//   sensor          ( Gimbal/Antenna+Tws+       igual
//                     AirTrkMgr )
//   interacao       ( AlertDatalink )           igual
//   arbitro         ( UbfArbiter )              igual
//   percepcao/      FlightState/BtBehavior/     igual
//   decisao/acao    AltitudeSafetyBehavior/
//                   FlightAction
//   agente UBF      ( SimAgent ), na STATION,   ( FlightAgentTC ), DENTRO
//                   ator por nome, decide em    do player, ator = container,
//                   updateData()                decide na fase 3
//
// AERONAVE: c310 (Cessna 310). O motivo e concreto: o JSBSimModel nativo
// comanda a aeronave escrevendo em 'ap/heading_hold', 'ap/altitude_hold' e
// 'ap/airspeed_hold' (confirmado com `strings libmixr_models.so`),
// propriedades que so existem se o MODELO JSBSim tiver um autopilot
// proprio. O c310 tem (<autopilot file="c310ap">), entao a cadeia Autopilot
// -> JSBSimModel -> superficies funciona sem uma linha de lei de controle
// propria.
//
// 4 e substituido pelo main.cpp antes do parse.
//

( ClockStation

   tcPriority: 0.5

   ownship: falcon1

   // --------------------------------------------------------------------
   // A DIFERENCA DO single-thread ESTA AQUI: esta Station NAO tem AGENTE
   // nenhum em 'components:'.
   //
   // No single-thread os quatro ( SimAgent ) moram neste ponto e amarram o
   // ator por nome (slot 'actorPlayerName'), porque e assim que o SimAgent
   // nativo funciona -- e, por ser um ubf::Agent, decidem em updateData().
   //
   // Aqui cada agente e um ( FlightAgentTC ) DENTRO da aeronave, no fim da
   // lista de componentes do player. Duas consequencias diretas:
   //   * o ator e o proprio container, entao nao ha nome a amarrar;
   //   * a decisao roda na fase 3 do frame de tempo critico, na thread do
   //     pool que estiver processando aquele player.
   //
   // O 'components:' abaixo existe so para o ( MsgFeed ), que e identico ao
   // da gemea: mensageria nao e decisao, e roda fora do frame T/C nas duas.
   // --------------------------------------------------------------------

   components: {

      // ------------------------------------------------------------------
      // O MODELO DESTA POC, CARREGADO EM TEMPO DE EXECUCAO (dlopen).
      //
      // domain/, bt/, ubf/ e xnative/ NAO estao dentro do executavel: sao um
      // shared_module compilado a parte, contra o contrato de
      // shared/xplugin/PluginAbi.hpp. O executavel e so o host -- o laco, o
      // cenario, a Station, a exportacao e o dump.
      //
      // Depois desta linha, os nomes de fabrica que a .so responde
      // ( FlightState, BtBehavior, AltitudeSafetyBehavior, FlightAction,
      // AlertDatalink, TacticalAlert, FlightAgentTC )
      // valem no resto DESTE arquivo, como se fossem do framework.
      //
      // ESTE BLOCO TEM DE VIR ANTES DO PRIMEIRO USO -- por isso e a primeira
      // entrada de 'components:'. O motivo e mecanico: a producao 'arglist'
      // do edl_parser e RECURSIVA A ESQUERDA (edl_parser.y:143-165), entao
      // formas irmas sao construidas na ordem do TEXTO, e parse() chama
      // factory + setSlotByName + isValid() no fecha-parenteses de cada uma.
      // A carga acontece no isValid() do ( PluginLoader ), portanto antes de
      // qualquer coisa escrita abaixo -- inclusive o ( FlightState ) do
      // agente, logo aqui embaixo.
      //
      // Fora de ordem, mixrFactory aborta explicando isso. Nao ha silencio
      // nem SIGSEGV.
      //
      // 'provides' e uma ASSERCAO: se a .so nao entregar exatamente esses
      // nomes, o processo morre dizendo o que ela entrega.
      // ------------------------------------------------------------------
      plugins: ( PluginLoader
         searchPaths: {
            "./dist/lib/mixr-plugins/"
         }
         modules: {
            ( PluginModule
               file:     "libflight_tc.so"
               provides: { AlertDatalink TacticalAlert FlightAgentTC FlightState
                           BtBehavior AltitudeSafetyBehavior RLBridgeBehavior
                           FlightAction }
            )
         }
      )

      // ------------------------------------------------------------------
      // Mensagens configuraveis (shared/xmsg). Escolher O QUE sai da
      // simulacao e QUANDO sai passa a ser configuracao, nao recompilacao.
      //
      // Roda em updateData(), na thread do laco -- nao ha uma linha deste
      // subsistema dentro do frame de tempo critico.
      // ------------------------------------------------------------------
      msgFeed: ( MsgFeed

         trackManager: twsTrkMgr        // nome do TrackManager (grupo TRACK)
         maxPlayers:   64
         healthEvery:  ( Seconds 10 )

         sinks: {
            ( MsgFileSink
               fileName: "./build/tests-messages/multi-thread-intruder.jsonl"
               flushEvery: ( Seconds 2 ) )
         }

         messages: {

            // "posicao/velocidade/altitude a cada instante". Sem 'when:' sai
            // todo ciclo, limitada por 'every:'. players vazio = todos,
            // inclusive o bandit1 que so existe na rede.
            ( MsgReport name: telemetria  players: { }
               labels: { player side mode }
               fields: { latDeg lonDeg altMslM altAglM hdgDeg speedKts
                         machNum climbMps fuelFrac }
               every: ( Seconds 1.0 ) )

            // "mudanca de altitude": deadband medido contra o ultimo valor
            // EMITIDO -- uma subida lenta da um evento por degrau de 100 m,
            // nao um por ciclo.
            ( MsgReport name: mudanca-altitude
               players: { falcon1 falcon2 falcon3 falcon4 }
               labels: { player }
               fields: { altMslM altAglM climbMps hdgDeg }
               when: { ( MsgChanged field: altMslM by: ( Meters 100 ) ) } )

            // "falha no motor". engThrustAsymFrac = (max-min)/max entre os
            // motores: 0 simetrico, ~1 um motor morto. E adimensional, entao
            // NAO precisa de calibracao por aeronave -- ao contrario de
            // engRpmRaw, cuja unidade depende do tipo de motor (o c310 e
            // pistao: ~2500, nao ~95).
            //
            // 'clear' e obrigatorio; 'hold' descarta o transiente dos
            // primeiros segundos (JSBSimModel::reset() nao roda FGTrim).
            // Player sem dynamicsModel (o fantasma que chega por DIS) tem o
            // grupo de motor invalido e NAO avalia -- sem isso, alarme
            // permanente no intruso.
            ( MsgReport name: falha-motor  players: { }
               labels: { player }
               fields: { engCount engWorstIndex engThrustAsymFrac
                         engThrustMinLb eng1ThrustLb eng2ThrustLb
                         eng1RpmRaw eng2RpmRaw engFuelFlowTotalPph
                         engOilPsiMin fuelFrac altAglM }
               when: { ( MsgThreshold field: engThrustAsymFrac
                           above: 0.5  clear: 0.3  hold: ( Seconds 1.0 ) ) }
               every: ( Seconds 5.0 ) )

            // Filtro composto: baixo E descendo rapido.
            ( MsgReport name: baixo-e-descendo
               players: { falcon1 falcon2 falcon3 falcon4 }
               labels: { player }
               fields: { altAglM terrainElevM climbMps hdgDeg speedKts }
               match: all
               when: {
                  ( MsgThreshold field: altAglM
                       below: ( Meters 500 )  clear: ( Meters 700 ) )
                  ( MsgRate field: altMslM  below: -10.0
                       window: ( Seconds 1.0 ) )
               }
               every: ( Seconds 5.0 ) )
         }
      )

   } // components (mensageria)

   // --------------------------------------------------------------------
   // bandit1 (o intruso) mora no processo proprio src/poc/bandit-dis, pilotado
   // por joystick fisico ou pelo Autopilot scripted de fallback, que emite
   // seu estado via DIS NATIVO do MIXR (mixr::dis -- namespace real da lib,
   // apesar do caminho do header ser mixr/interop/dis/; factory names
   // 'DisNetIO'/'DisNtm').
   //
   // BIDIRECIONAL: esta Station RECEBE o bandit1 (inputEntityTypes:) e
   // TAMBEM EMITE falcon1..4 (outputEntityTypes:) -- o bandit-dis recebe
   // de volta e mostra as falcons no proprio Tacview dele (porta 1235).
   // Sem 'enableOutput: false', o output volta ao default nativo (true).
   //
   // O 'template:' do DisNtm de entrada basta para o radar
   // (Antenna/Tws/AirTrkMgr) detectar o fantasma exatamente como detectava
   // o bandit1 nativo: interop::NetIO::createIPlayer() clona o template
   // POR INTEIRO -- signature, dataLogTime -- e poe o clone na MESMA lista
   // que Simulation::getPlayers() devolve, a mesma que o radar ja varria.
   // 'dynamicsModel'/'pilot' NAO precisam ser reproduzidos aqui: a posicao
   // do fantasma e 100% dead reckoning a partir dos PDUs recebidos, nunca
   // simulacao local -- 'side:' tambem e irrelevante, quem manda e o Force
   // ID do proprio PDU. O template de SAIDA (outputEntityTypes:) so precisa
   // casar CLASSE + 'type:' (o que o Ntm usa pra achar qual player local
   // publicar) -- falcon1..4 e bandit1 sao a MESMA classe/type
   // ("Aircraft"/"C310"), entao o mesmo disEntityType serve pros dois
   // sentidos sem ambiguidade: cada lado so ouve trafego de quem so emite
   // UMA coisa (bandit-dis so emite bandit1; esta Station so emite
   // falcon1..4).
   //
   // Esquema de portas (ver o comentario irmao em
   // src/poc/bandit-dis/configs/scenario.epp): todo mundo escuta em 3000;
   // bandit-dis emite da 3001, single-thread da 3002, esta Station da 3003.
   //
   // disEntityType TEM que ser identico dos dois lados -- e como o Ntm casa
   // o PDU recebido com o template. Nao e enumeracao SISO-REF-010 real, so
   // um codigo interno consistente.
   // --------------------------------------------------------------------
   

   // ExposedDataRecorder = DataRecorder nativo, so com getOutputHandler()
   // publico -- e o que deixa app/StationBuilder.cpp achar o TacviewOutput
   // daqui de fora, pra alimentar a varredura de radar (ver
   // shared/xtacview/ExposedDataRecorder.hpp). Roda identico ao DataRecorder.
   dataRecorder: ( ExposedDataRecorder
      eventName: "multi-thread"

      // O gravador NATIVO ESTOURA (SEGV, via __dynamic_cast em
      // DataRecorder::recordNewTrack()) ao gravar a primeira pista que o
      // radar nativo cria -- mesma familia do REID_WEAPON_RELEASED
      // (armadilha 4 do CLAUDE.md). Contorno: habilitar SO os tokens que o
      // TacviewOutput usa, ja que isDataEnabled() e testado ANTES de
      // chamar o handler quebrado.
      //
      //   43 = REID_PLAYER_DATA     42 = REID_PLAYER_REMOVED
      enabledList: [ 43 42 ]
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 12341
               callsign: "poc-mixr/multi-thread"
               fileName: "./build/tests-recordings/multi-thread-intruder.acmi"

               // Name= e o MODELO que o Tacview procura na sua base de dados
               // para escolher o icone/modelo 3D (o nome do player vai em
               // CallSign/Pilot -- ver shared/xtacview).
               //
               // NOTA: a DINAMICA aqui e a de um Cessna 310 (a unica com
               // autopilot 'ap/*' entre as aeronaves distribuidas com o
               // JSBSim -- ver o comentario no topo). "F-16C" e portanto uma
               // escolha de APRESENTACAO: o replay desenha um caca, mas as
               // velocidades e as taxas de curva continuam sendo as do c310.
               // Para trocar o icone basta editar esta linha; para trocar a
               // aeronave de verdade seria preciso um modelo JSBSim com
               // autopilot proprio (o f16 distribuido nao tem).
               modelMap: { falcon1: "F-16C"  falcon2: "F-16C"  falcon3: "F-16C"
                           falcon4: "F-16C"  bandit1: "F-16C" }
               typeMap:  { falcon1: "Air+FixedWing"  falcon2: "Air+FixedWing"
                           falcon3: "Air+FixedWing"  falcon4: "Air+FixedWing"
                           bandit1: "Air+FixedWing" }
               colorMap: { falcon1: "Blue"  falcon2: "Blue"  falcon3: "Blue"
                           falcon4: "Blue"  bandit1: "Red" }
            )
         }
      )
   )

   simulation: ( WorldModel

      numTcThreads: 4

      // Serra do Mar / regiao de Nova Friburgo (RJ). A referencia esta no
      // MIOLO da celula S23W043 (lat -23..-22, lon -43..-42): com os players
      // espalhados +-12 NM, a borda mais proxima do tile fica a 4,8 km. Isso
      // nao e detalhe -- FORA da celula o Player::updateElevation() nativo
      // grava elevacao 0.0 com o flag de validade LIGADO (ele ignora o
      // retorno de getElevation()), e a decisao passa a raciocinar sobre um
      // mundo ao nivel do mar sem nenhum aviso. Ver CLAUDE.md.
      latitude:  -22.25
      longitude: -42.48

      // Banco de elevacao. Os slots sao 'path' e 'file' -- NAO 'pathname'/
      // 'filename', que e como se chamam os setters. Nome errado da
      // "slot not found" e o tile simplesmente nao carrega.
      //
      // O .hgt e artefato gerado: o que fica versionado e o .hgt.gz, que o
      // app/TerrainData descomprime na primeira execucao (o SrtmHgtFile abre
      // um ifstream cru, nao entende .gz).
      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         // ------------------------------------------------------------
         // 4 avioes azuis -- TODOS os componentes sao classes do
         // framework, com a unica excecao do datalink (que herda de
         // models::Datalink so para decidir o que fazer com a mensagem).
         // ------------------------------------------------------------

         falcon1: ( Aircraft
            id: 101
            side: blue
            type: "C310"

            // RCS: e dela que o radar dos OUTROS calcula a deteccao
            signature: ( SigSphere radius: 3.0 )

            initXPos:     ( NauticalMiles 5.0 )
            initYPos:     ( NauticalMiles 0.0 )
            // REGRA DAS ALTITUDES: pico do proprio circuito de patrulha + 300 m,
            // arredondado para cima em 50 m. Nao e estetica -- e o que mantem a
            // aeronave fora do CRASH_EVENT nativo (Player.cpp:2811 dispara com
            // AGL < 0 e crashNotification() poe o player em CRASHED, congelando-o).
            // Antes do terreno isso era letra morta, porque tElev era sempre 0.
            // falcon1: pico 1435 m -> 1750 m (AGL tipico ~940 m).
            initAlt:      ( Meters 1750.0 )
            initHeading:  ( Degrees 90 )
            initVelocity: 82.0                   // ~160 kts

            dataLogTime: ( Seconds 0.1 )

            // Interpolacao bilinear entre os posts de 30 m do SRTM1 -- sem
            // isso a elevacao vem em degraus e o piso anti-CFIT tambem.
            // NAO declarar 'terrainElevReq': com ele em true o
            // updateElevation() PULA a consulta ao banco e fica esperando um
            // gerador de imagem externo empurrar o valor.
            interpolateTerrain: true

            components: {

               // 6-DOF nativo: JSBSim pelo adaptador do framework.
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"
                  model:   "c310"
                  debugLevel: 0
               )

               // Piloto automatico NATIVO: leis de controle, limites e
               // conversao para as superficies, tudo do framework.
               pilot: ( Autopilot
                  navMode: false
                  headingHoldMode:  true
                  altitudeHoldMode: true
                  velocityHoldMode: true
                  maxRateOfTurnDps: 3.0
                  maxBankAngle:    30.0
                  maxPitchAngle:   10.0
                  maxClimbRateMps:  8.0
                  maxAcceleration:  2.0
               )

               // Datalink NATIVO (subclasse minima): transporte, alcance,
               // fila de entrada e evento vem todos da classe base.
               datalink: ( AlertDatalink
                  holdTime: ( Seconds 25 )
               )

               // Radar de busca 100% nativo -- mesma cadeia das pocs 06/07.
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal
                        gain: ( dB 42 )

                        // Padrao de ganho embutido (nas pocs 06/07 vinha de
                        // um #include, que exige passo de preprocessador C).
                        gainPattern:
                        ( Func1
                           table: ( Table1
                              x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                              data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ]
                           )
                        )
                        gainPatternDeg: false

                        initPosition: [ 0 0 ]
                        maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth:   ( Degrees 60 )
                        commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]
                        searchVolume: [ 1.0472 0.05 ]
                        numBars: 2

                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )
                  }
               )

               sensors: ( SensorMgr
                  components: {
                     ( Tws
                        trackManagerName: twsTrkMgr
                        antennaName: radar
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 2.0 )
                        PRF:        ( Hertz 500.0 )
                        pulseWidth: ( MilliSeconds 0.01 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 80 ]
                        initRangeIdx: 2
                     )
                  }
               )

               obc: ( OnboardComputer
                  components: {
                     twsTrkMgr: ( AirTrkMgr
                        maxTracks: 20
                        alpha: 1.0
                        beta:  0.5
                        gamma: 0.0
                        positionGate: 1500
                        rangeGate:     500
                        velocityGate:   10
                        firstTrackId: 1000
                     )
                  }
               )

               // ------------------------------------------------------
               // O AGENTE -- a diferenca deste subprojeto.
               //
               // Mesmo conteudo do ( SimAgent ) do single-thread (mesmo state,
               // mesmo arbitro, mesmos numeros); muda a CLASSE e o LUGAR.
               //
               // POR QUE E O ULTIMO DA LISTA: a lista de componentes e
               // percorrida na ordem declarada, e tres coisas rodam na
               // fase 3 -- Autopilot::process(), AirTrkMgr::process() e a
               // decisao. Declarado por ultimo, o agente ja enxerga as
               // pistas ATUALIZADAS deste frame; o comando que ele grava
               // no Autopilot vale a partir do frame seguinte. E a mesma
               // disciplina do resto da poc: escreve numa fase, publica
               // na fronteira, le na fase seguinte.
               // ------------------------------------------------------
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior
                           vote: 90
                           // DOIS PISOS. O absoluto (minAltitude) nao sabe onde
                           // esta o chao: sobre esta serra, 1200 m MSL fica
                           // DENTRO da montanha. Ele fica so como rede para
                           // quando nao ha elevacao; quem manda aqui e o piso
                           // AGL abaixo.
                           minAltitude:      ( Meters 1200 )
                           recoverAltitude:  ( Meters 1750 )
                           recoverSpeed:     160.0
                           // minClearance TEM de ficar abaixo do
                           // terrainClearance do BtBehavior (800), senao este
                           // comportamento (voto 90) briga com o piso de
                           // evasao da arvore (voto 50).
                           minClearance:     ( Meters 400 )
                           recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior
                           vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading:  ( Degrees 90 )
                           legTime:        ( Seconds 5 )
                           legTurn:        ( Degrees 90 )
                           patrolAltitude: ( Meters 1750 )
                           patrolSpeed:    160.0
                           rtbAltitude:    ( Meters 2050 )
                           rtbSpeed:       170.0
                           arrivalRadius:  ( NauticalMiles 2.0 )
                           fuelReserve:    0.35
                           breakTurn:      ( Degrees 110 )
                           evadeClimb:     ( Meters 700 )
                           evadeSpeed:     185.0
                           supportSpeed:   180.0
                           // Histerese da evasao: por quanto tempo a manobra continua
                           // valendo DEPOIS de a pista sumir. Precisa cobrir o intervalo
                           // entre perder o contato (a propria quebra tira o intruso do
                           // setor do radar) e o ramo de apoio querer assumir -- sem
                           // isso os dois alternam e a aeronave voa "batendo asa".
                           evadeHold:      ( Seconds 30 )
                           // PISO ANTI-CFIT. O desconflito vertical da evasao
                           // desce 700 m a partir da altitude atual; com ~940 m
                           // de AGL de cruzeiro isso levaria a aeronave para
                           // ~240 m do chao. O alvo e entao levantado para
                           // terreno+800. 0 desliga a camada de terreno e
                           // devolve o piso absoluto de 200 m -- e o controle
                           // negativo, sem recompilar.
                           terrainClearance: ( Meters 800 )
                           // Jitter de rumo na patrulha (opcional, ver CLAUDE.md
                           // secao shared/xrandom): mesma patrolMasterSeed nos 4
                           // falcons -- cada um deriva a propria sequencia do
                           // proprio NOME, nunca de ordem de descoberta/thread.
                           patrolJitterHeading: ( Degrees 6 )
                           patrolMasterSeed:    20260903
                        )
                     }
                  )
               )
            }
         )

         falcon2: ( Aircraft
            id: 102
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 0.0 )
            initYPos:     ( NauticalMiles 5.0 )
            initAlt:      ( Meters 1850.0 )     // pico do circuito 1529 m + 300
            initHeading:  ( Degrees 180 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
