//
// src/poc/dis/bandit
//
// O bandit1 (o intruso), num processo proprio: mesma dinamica JSBSim A-4 +
// Autopilot, mesmos valores iniciais dos players single-thread/multi-thread,
// mais duas coisas:
//
//    ioHandler: ( JoystickIoHandler ... )   -- pilotagem manual por
//       joystick fisico (shared/xjoystick), com fallback automatico para o
//       Autopilot scripted quando nao ha hardware conectado (ver o
//       comentario de JoystickIoHandler.hpp sobre hasRealJoystick()).
//
//    networks: ( DisNetIO ... )             -- emite o estado do bandit1
//       via DIS nativo do MIXR. single-thread/multi-thread nao declaram
//       nenhum bandit1 LOCAL: recebem este aqui so pela rede (ver o bloco
//       'networks:' nos scenario.edl.in delas, com o MESMO disEntityType
//       usado abaixo).
//
// Sem @NUM_TC_THREADS@/.edl.in: nao ha CLI aqui (nada de -threads), entao o
// numero de threads T/C fica fixo no proprio arquivo.
//
// Sem -deterministic/make check-*: joystick e rede sao nao-deterministicos
// por natureza -- nao ha o que comparar aqui.
//

( Station

   tcPriority: 0.5
   ownship: bandit1

   // ----------------------------------------------------------------------
   // Joystick fisico -- mecanismo NATIVO do MIXR (mixr::linkage), mesmo
   // desenho do shared/xjoystick documentado no CLAUDE.md. 'channel:'
   // confirmado com tools/joystick_mapper.py contra um Logitech Extreme 3D
   // (6 eixos/12 botoes, deviceIndex 0): 0=aileron 1=profundor 2=leme
   // (twist) 3=manete (slider). SEM joystick conectado, o UsbJoystick so
   // loga um aviso -- e o JoystickIoHandler agora detecta essa ausencia
   // (hasRealJoystick()) e deixa o Autopilot abaixo no controle, sem tocar
   // em nada.
   // ----------------------------------------------------------------------
   ioHandler: ( JoystickIoHandler
      player: "bandit1"
      deviceIndex: 0
      inputData: ( IoData numAI: 4 )
      devices: {
         ( UsbJoystick
            deviceIndex: 0
            adapters: {
               ( AnalogInput ai: 1  channel: 0 )                          // ROLL_AI     <- aileron
               ( AnalogInput ai: 2  channel: 1 )                          // PITCH_AI    <- profundor
               ( AnalogInput ai: 3  channel: 2 )                          // RUDDER_AI   <- leme
               ( AnalogInput ai: 4  channel: 3  offset: 1.0  gain: -0.5 ) // THROTTLE_AI <- manete
            }
         )
      }
   )

   // ----------------------------------------------------------------------
   // DIS nativo (mixr::dis -- namespace real da lib, apesar do diretorio
   // 'interop/dis'; factory names 'DisNetIO'/'DisNtm'). Emite o bandit1 sem
   // nenhuma linha de C++ propria -- DisNetIO/DisNtm sao construtiveis
   // direto em EDL (ao contrario do linkage::IoHandler, que exigiu o
   // JoystickIoHandler).
   //
   // Esquema de portas (mesma receita do exemplo do proprio MIXR --
   // MIXR-PATTERN-CONTEXT.md secao 6.7 -- estendida para 3 processos no
   // mesmo host): todo mundo ESCUTA em 3000; cada processo EMITE de uma
   // porta local diferente e ignora essa mesma porta como origem (assim
   // ninguem ouve o proprio eco). bandit: 3001. single-thread: 3002.
   // multi-thread: 3003.
   //
   // disEntityType e inventado (nao e enumeracao SISO-REF-010 real) -- so
   // precisa ser o MESMO valor usado no 'inputEntityTypes:' das duas pocs
   // que recebem o bandit1.
   // ----------------------------------------------------------------------
   networks: {
      ( DisNetIO
         siteID: 1  applicationID: 1  exerciseID: 1
         netInput:  ( UdpBroadcastHandler localIpAddress: localhost networkMask: "255.0.0.0"
                      port: 3000  ignoreSourcePort: 3001  shared: true )
         netOutput: ( UdpBroadcastHandler localIpAddress: localhost networkMask: "255.0.0.0"
                      port: 3000  localPort: 3001          shared: true )
         outputEntityTypes: {
            ( DisNtm
               template: ( Aircraft type: "A4" )
               disEntityType: [ 1 2 225 1 99 0 0 ]
            )
         }
         // Recebe as falcon1..4 (emitidas por single-thread/multi-thread, ver o
         // 'outputEntityTypes:' delas). Mesmo disEntityType do bandit1: nao ha
         // colisao porque cada lado so ouve de quem emite UMA coisa (aqui, so
         // chega trafego de falcon; o proprio bandit1 e filtrado pelo
         // ignoreSourcePort acima). Template minimo -- so o suficiente pra
         // aparecer no Tacview; sem dynamicsModel/pilot: a posicao do fantasma
         // e so dead reckoning, nunca simulacao local (mesmo raciocinio do
         // 'inputEntityTypes:' das duas pocs gemeas).
         inputEntityTypes: {
            ( DisNtm
               template: ( Aircraft type: "A4"
                  signature: ( SigSphere radius: 3.0 )
                  dataLogTime: ( Seconds 0.1 )
               )
               disEntityType: [ 1 2 225 1 99 0 0 ]
            )
         }
      )
   }

   dataRecorder: ( ExposedDataRecorder
      eventName: "poc-bandit"

      // Mesma armadilha documentada no CLAUDE.md para as duas pocs gemeas
      // (REID_NEW_TRACK/REID_WEAPON_RELEASED derrubam o gravador nativo) --
      // aqui nao ha radar nem armas, mas manter a lista restrita nao custa
      // nada e evita redescobrir o problema se o cenario crescer.
      enabledList: [ 43 42 ]
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 1235
               callsign: "poc-mixr/bandit"
               fileName: "./src/poc/dis/bandit/data/recordings/mission.acmi"
               modelMap: { bandit1: "A-4E"  falcon1: "A-4E"  falcon2: "A-4E"
                           falcon3: "A-4E"  falcon4: "A-4E" }
               typeMap:  { bandit1: "Air+FixedWing"  falcon1: "Air+FixedWing"
                           falcon2: "Air+FixedWing"  falcon3: "Air+FixedWing"
                           falcon4: "Air+FixedWing" }
               colorMap: { bandit1: "Red"  falcon1: "Blue"  falcon2: "Blue"
                           falcon3: "Blue"  falcon4: "Blue" }
            )
         }
      )
   )

   simulation: ( WorldModel

      numTcThreads: 2

      // Mesma referencia das duas pocs gemeas -- Serra do Mar / regiao de
      // Nova Friburgo (RJ). Ver o comentario completo no scenario.edl.in
      // delas: o piloto humano agora pode voar contra a serra de verdade.
      latitude:  -22.25
      longitude: -42.48

      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         bandit1: ( Aircraft
            id: 201
            side: red
            type: "A4"
            signature: ( SigSphere radius: 4.0 )
            initXPos:     ( NauticalMiles 12.0 )
            initYPos:     ( NauticalMiles 12.0 )
            initAlt:      ( Meters 2400.0 )
            initHeading:  ( Degrees 225 )
            initVelocity: 195.0                   // ~380 kts
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "A4"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 6.0  maxBankAngle: 45.0
                  maxPitchAngle: 20.0  maxClimbRateMps: 40.0  maxAcceleration: 6.0
               )
            }
         )

      } // players

   ) // simulation

) // station
