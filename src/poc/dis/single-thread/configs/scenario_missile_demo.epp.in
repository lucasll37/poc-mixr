//
// single-thread -- DEMO do missil guiado
//
// Cenario de demo, DERIVADO manualmente de scenario.epp.in (nao gerado por
// script, ao contrario das fixtures de tests/scenario/make_fixture.py: este
// arquivo e para RODAR, nao para um teste automatizado regenerar). Roda no
// binario single-thread ja existente, sem tocar em nenhum host:
//
//    ./build/src/poc/dis/single-thread/src/single-thread \
//       -f src/poc/dis/single-thread/configs/scenario_missile_demo.epp.in
//
// O QUE MUDA em relacao a producao (ver o comentario de cada bloco abaixo):
//
//   1) 'networks:' SAI -- cenario hermetico, mesmo motivo do
//      tests/scenario/make_fixture.py (nao competir por porta com uma
//      sessao real, nao deixar um bandit de outra sessao mudar o
//      resultado).
//   2) bandit1 volta a ser LOCAL (mesmo bloco da fixture 'intruder') --
//      sem 'networks:' o intruso so chegaria daqui.
//   3) falcon1 ganha 'stores:' com UM ( GuidedMissile ), e a arvore dele
//      (so a dele -- falcon2/3/4 continuam na de producao) passa a ser
//      flight_tree_missile_demo.xml, que tenta lancar antes de evadir.
//   4) UM SEGUNDO ( PluginModule ), carregando libmissile.so --
//      so publica "GuidedMissile". libflight.so continua publicando
//      exatamente os mesmos 6 nomes de sempre; nenhum cenario de PRODUCAO
//      precisa mudar 'provides:' por causa disto (ver o "porque" no
//      CLAUDE.md, secao do missil).
//   5) msgFeed ganha um MsgReport do ciclo de vida do missil (mode do
//      player, via shared/xmsg) -- a forma mais barata e confiavel de ver
//      lancamento/detonacao/destruicao no NDJSON, sem depender do
//      REID_WEAPON_RELEASED/REID_WEAPON_DETONATION nativos (que abortam o
//      processo -- mesma familia do bug ja documentado no CLAUDE.md; por
//      isso NAO entram em dataRecorder.enabledList).
//
// O missil ainda aparece no Tacview -- e um Player normal com dataLogTime
// setado, sai por REID_PLAYER_DATA (43) como qualquer aviao. So nao da para
// pre-mapear o nome dele em typeMap/colorMap/modelMap: o nome e sintetico
// ("W%05d", atribuido por AbstractWeapon::release() a partir do proximo ID
// de arma liberada), e nao vale a pena adivinhar so por estetica de icone --
// ele aparece com o icone padrao do Tacview, o que basta para a demo.
//

( ClockStation

   tcPriority: 0.5

   ownship: falcon1

   components: {

      // ------------------------------------------------------------------
      // DOIS modelos, carregados em tempo de execucao. O bloco tem de vir
      // ANTES do primeiro uso -- mesma regra mecanica de producao (a
      // producao 'arglist' do edl_parser e recursiva a esquerda).
      // ------------------------------------------------------------------
      plugins: ( PluginLoader
         searchPaths: {
            "./dist/lib/mixr-plugins/"
         }
         modules: {
            ( PluginModule
               file:     "libflight.so"
               provides: { AlertDatalink TacticalAlert FlightState
                           BtBehavior AltitudeSafetyBehavior RLBridgeBehavior
                           FlightAction }
            )
            ( PluginModule
               file:     "libmissile.so"
               provides: { GuidedMissile }
            )
         }
      )

      agent1: ( SimAgent
         actorPlayerName: falcon1
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior
                  vote: 90
                  minAltitude:      ( Meters 1200 )
                  recoverAltitude:  ( Meters 1750 )
                  recoverSpeed:     160.0
                  minClearance:     ( Meters 400 )
                  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior
                  vote: 50
                  // A UNICA diferenca de producao neste bloco: a arvore de
                  // DEMO (tenta lancar antes de evadir) e os 3 slots do
                  // envelope de lancamento. O resto e identico ao falcon1
                  // de scenario.epp.in.
                  treeFile: "./models/player/flight/configs/flight_tree_missile_demo.xml"
                  patrolHeading:  ( Degrees 90 )
                  legTime:        ( Seconds 60 )
                  legTurn:        ( Degrees 90 )
                  patrolAltitude: ( Meters 1750 )
                  patrolSpeed:    160.0
                  rtbAltitude:    ( Meters 2050 )
                  rtbSpeed:       170.0
                  arrivalRadius:  ( NauticalMiles 2.0 )
                  fuelReserve:    0.35
                  breakTurn:      ( Degrees 110 )
                  evadeClimb:     ( Meters 700 )
                  evadeSpeed:     185.0
                  terrainClearance: ( Meters 800 )
                  evadeHold:      ( Seconds 30 )
                  supportSpeed:   180.0
                  // Envelope de lancamento (domain::LaunchPolicy).
                  //
                  // ARMADILHA CONFIRMADA RODANDO: o primeiro contato nesta
                  // geometria acontece a ~13.6 NM (medido no dump:
                  // trackRange=25205 m ja no primeiro frame com contato) --
                  // o mesmo valor usado em tests/tree/test_flight_tree.cpp.
                  // Um launchMaxRange MENOR que isso nunca lanca: o
                  // Fallback tenta o lancamento ANTES de ReportAndEvade,
                  // mas ReportAndEvade FOGE do contato (breakTurn), entao o
                  // alcance so CRESCE depois do primeiro tick -- a janela
                  // de lancamento e o PRIMEIRO frame com contato, ou nunca.
                  // Por isso o maximo aqui e bem folgado (20 NM), para
                  // cobrir o primeiro contato com margem.
                  launchMinRange: ( NauticalMiles 0.8 )
                  launchMaxRange: ( NauticalMiles 20.0 )
                  launchCone:     ( Degrees 60 )
               )
            }
         )
      )

      agent2: ( SimAgent
         actorPlayerName: falcon2
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior vote: 90
                  minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 1850 )
                  recoverSpeed: 160.0
                  minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior vote: 50
                  treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                  patrolHeading: ( Degrees 180 )  legTime: ( Seconds 60 )
                  legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 1850 )
                  patrolSpeed: 160.0  rtbAltitude: ( Meters 2100 )  rtbSpeed: 170.0
                  arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                  breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                  evadeSpeed: 185.0  supportSpeed: 180.0
                  evadeHold: ( Seconds 30 )
                  terrainClearance: ( Meters 800 )
               )
            }
         )
      )

      agent3: ( SimAgent
         actorPlayerName: falcon3
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior vote: 90
                  minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2050 )
                  recoverSpeed: 160.0
                  minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior vote: 50
                  treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                  patrolHeading: ( Degrees 270 )  legTime: ( Seconds 45 )
                  legTurn: ( Degrees 120 )  patrolAltitude: ( Meters 2050 )
                  patrolSpeed: 165.0  rtbAltitude: ( Meters 2150 )  rtbSpeed: 170.0
                  arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                  breakTurn: ( Degrees 130 )  evadeClimb: ( Meters 750 )
                  evadeSpeed: 190.0  supportSpeed: 185.0
                  evadeHold: ( Seconds 30 )
                  terrainClearance: ( Meters 800 )
               )
            }
         )
      )

      agent4: ( SimAgent
         actorPlayerName: falcon4
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior vote: 90
                  minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2100 )
                  recoverSpeed: 160.0
                  minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior vote: 50
                  treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                  patrolHeading: ( Degrees 0 )  legTime: ( Seconds 60 )
                  legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 2100 )
                  patrolSpeed: 160.0  rtbAltitude: ( Meters 2200 )  rtbSpeed: 170.0
                  arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                  breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                  evadeSpeed: 185.0  supportSpeed: 180.0
                  evadeHold: ( Seconds 30 )
                  terrainClearance: ( Meters 800 )
               )
            }
         )
      )

      msgFeed: ( MsgFeed

         trackManager: twsTrkMgr
         maxPlayers:   64
         healthEvery:  ( Seconds 10 )

         sinks: {
            ( MsgFileSink
               fileName: "./src/poc/dis/single-thread/data/messages/mission-missile-demo.jsonl"
               flushEvery: ( Seconds 2 ) )
         }

         messages: {

            ( MsgReport name: telemetria  players: { }
               labels: { player side mode }
               fields: { latDeg lonDeg altMslM altAglM hdgDeg speedKts
                         machNum climbMps fuelFrac rollDeg pitchDeg }
               every: ( Seconds 1.0 ) )

            // O ciclo de vida do missil (e do bandit1, para ver o impacto):
            // toda vez que o MODO do player muda -- ACTIVE -> DETONATED ->
            // DELETE_REQUEST para o missil; ACTIVE -> KILLED para o alvo se
            // acertado -- sai uma linha aqui. players vazio = todos, entao
            // cobre o missil mesmo sem saber o nome sintetico dele de
            // antemao (ver o comentario no topo do arquivo).
            ( MsgReport name: ciclo-de-vida
               players: { }
               labels: { player side }
               fields: { modeNum latDeg lonDeg altMslM }
               when: { ( MsgChanged field: modeNum ) } )
         }
      )

   } // components (agentes)

   // bandit1 LOCAL -- sem 'networks:', e a UNICA forma de ter um alvo para
   // o missil perseguir neste processo. Mesmo bloco da fixture 'intruder'
   // (tests/scenario/make_fixture.py) e do src/poc/dis/bandit/configs/scenario.epp.

   // dataRecorder identico ao de producao -- ver a nota no topo do arquivo
   // sobre REID_WEAPON_RELEASED/REID_WEAPON_DETONATION ficarem de fora.
   dataRecorder: ( ExposedDataRecorder
      eventName: "single-thread-missile-demo"
      enabledList: [ 43 42 ]
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 1234
               callsign: "poc-mixr/single-thread-missile-demo"
               fileName: "./src/poc/dis/single-thread/data/recordings/mission-missile-demo.acmi"
               modelMap: { falcon1: "F-16C"  falcon2: "F-16C"  falcon3: "F-16C"
                           falcon4: "F-16C"  bandit1: "F-16C" }
               typeMap:  { falcon1: "Air+FixedWing"  falcon2: "Air+FixedWing"
                           falcon3: "Air+FixedWing"  falcon4: "Air+FixedWing"
                           bandit1: "Air+FixedWing" }
               colorMap: { falcon1: "Blue"  falcon2: "Blue"  falcon3: "Blue"
                           falcon4: "Blue"  bandit1: "Red" }
            )
         }
      )
   )

   simulation: ( WorldModel

      numTcThreads: @NUM_TC_THREADS@

      latitude:  -22.25
      longitude: -42.48

      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         falcon1: ( Aircraft
            id: 101
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 5.0 )
            initYPos:     ( NauticalMiles 0.0 )
            initAlt:      ( Meters 1750.0 )
            initHeading:  ( Degrees 90 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true

            components: {

               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"
                  model:   "c310"
                  debugLevel: 0
               )

               pilot: ( Autopilot
                  navMode: false
                  headingHoldMode:  true
                  altitudeHoldMode: true
                  velocityHoldMode: true
                  maxRateOfTurnDps: 3.0
                  maxBankAngle:    30.0
                  maxPitchAngle:   10.0
                  maxClimbRateMps:  8.0
                  maxAcceleration:  2.0
               )

               datalink: ( AlertDatalink
                  holdTime: ( Seconds 25 )
               )

               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal
                        gain: ( dB 42 )
                        gainPattern:
                        ( Func1
                           table: ( Table1
                              x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                              data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ]
                           )
                        )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]
                        maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth:   ( Degrees 60 )
                        commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]
                        searchVolume: [ 1.0472 0.05 ]
                        numBars: 2
                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )
                  }
               )

               sensors: ( SensorMgr
                  components: {
                     ( Tws
                        trackManagerName: twsTrkMgr
                        antennaName: radar
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 2.0 )
                        PRF:        ( Hertz 500.0 )
                        pulseWidth: ( MilliSeconds 0.01 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 80 ]
                        initRangeIdx: 2
                     )
                  }
               )

               obc: ( OnboardComputer
                  components: {
                     twsTrkMgr: ( AirTrkMgr
                        maxTracks: 20
                        alpha: 1.0
                        beta:  0.5
                        gamma: 0.0
                        positionGate: 1500
                        rangeGate:     500
                        velocityGate:   10
                        firstTrackId: 1000
                     )
                  }
               )

               // ---------------------------------------------------------
               // O MISSIL. UM so, na unica estacao deste StoresMgr -- o
               // ponto da demo e ver UM engajamento completo (lancamento,
               // detonacao, destruicao), nao um carrossel de reload.
               //
               // GuidedMissile vem do SEGUNDO plugin (libmissile.so,
               // ver plugins: acima). SimpleStoresMgr e Missile/AbstractWeapon
               // sao NATIVOS do MIXR -- ja registrados em mixr::models::factory,
               // encadeada no mixr_factory.cpp do host: nenhuma linha de
               // factory precisou mudar para eles.
               //
               // lethalRange/maxBurstRng dimensionados para o SigSphere do
               // bandit1 (radius: 4.0): lethalRange > raio garante o
               // KILL_EVENT nativo (Player::processDetonation()) num
               // impacto direto.
               //
               // ARMADILHA: o nome de fabrica de SimpleStoresMgr e
               // "StoresMgr", nao "SimpleStoresMgr" -- confirmado rodando
               // ("nome de fabrica desconhecido no cenario:
               // 'SimpleStoresMgr'"). O header documenta isso
               // (SimpleStoresMgr.hpp: "Factory name: StoresMgr"); a classe
               // ABSTRATA StoresMgr nao e construivel via EDL nenhuma.
               // ---------------------------------------------------------
               stores: ( StoresMgr
                  numStations: 1
                  stores: {
                     1: ( GuidedMissile
                        id: 501
                        side: blue
                        type: "AIM1"
                        signature: ( SigSphere radius: 0.3 )
                        dataLogTime: ( Seconds 0.1 )
                        maxTOF: ( Seconds 45 )
                        lethalRange: ( Meters 30 )
                        maxBurstRng: ( Meters 150 )
                        components: {
                           dynamicsModel: ( JSBSimModel
                              rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"
                              model:   "aim1"
                              debugLevel: 0
                           )
                        }
                     )
                  }
               )
            }
         )

         falcon2: ( Aircraft
            id: 102
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 0.0 )
            initYPos:     ( NauticalMiles 5.0 )
            initAlt:      ( Meters 1850.0 )
            initHeading:  ( Degrees 180 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
            }
         )

         falcon3: ( Aircraft
            id: 103
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles -5.0 )
            initYPos:     ( NauticalMiles  0.0 )
            initAlt:      ( Meters 2050.0 )
            initHeading:  ( Degrees 270 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.5  maxBankAngle: 33.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
            }
         )

         falcon4: ( Aircraft
            id: 104
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles  0.0 )
            initYPos:     ( NauticalMiles -5.0 )
            initAlt:      ( Meters 2100.0 )
            initHeading:  ( Degrees 0 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
            }
         )

         // ------------------------------------------------------------------
         // bandit1 -- LOCAL nesta demo (ver o comentario no topo do arquivo).
         // Mesmos valores iniciais do bandit/da fixture 'intruder'.
         // ------------------------------------------------------------------
         bandit1: ( Aircraft
            id: 201
            side: red
            type: "C310"
            signature: ( SigSphere radius: 4.0 )
            initXPos:     ( NauticalMiles 12.0 )
            initYPos:     ( NauticalMiles 12.0 )
            initAlt:      ( Meters 2400.0 )
            initHeading:  ( Degrees 225 )
            initVelocity: 92.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
            }
         )

      } // players

   ) // simulation

) // station
