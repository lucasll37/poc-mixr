//
// Subprojeto 12 - jsbsim-ubf
//
// Continuacao da poc/11 (todos os players sao classes proprias), agora com:
//
//   * 6-DOF DE VERDADE, sem herdar dinamica do MIXR: ( JsbsimFlightModel )
//     e um models::System que fala direto com a JSBSim::FGFDMExec. Nao ha
//     'dynamicsModel:' em player nenhum deste cenario.
//   * UBF + BehaviorTree: ( FlightAgent ) e um agente do UBF nativo cujo
//     comportamento e um ( UbfArbiter ) do framework, arbitrando por VOTO
//     entre ( AltitudeSafetyBehavior ) (regra dura) e ( BtBehavior ) (a
//     arvore do BehaviorTree.CPP).
//   * INTERACAO ENTRE AVIOES: ( AlertRadio ) transmite um TacticalAlert
//     por evento nativo para os outros cacas; quem recebe muda de
//     comportamento (ramo SupportAlert da arvore).
//   * Tacview: 'modelMap' faz cada objeto sair com Name=F-4E, que e o que
//     leva o Tacview a desenhar uma aeronave de verdade (o nome do player
//     vai em CallSign/Pilot, nao em Name).
//
// @NUM_TC_THREADS@ e substituido pelo main.cpp antes do parse.
//

( Station

   tcPriority: 0.5

   ownship: falcon1

   dataRecorder: ( DataRecorder
      eventName: "poc-12-jsbsim-ubf"
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 1234
               callsign: "poc-mixr/jsbsim-ubf"
               fileName: "./poc/12-jsbsim-ubf/data/recordings/mission.acmi"

               // Name= no ACMI e o MODELO (notacao ICAO/OTAN), nao o nome do
               // player: e por ele que o Tacview acha a aeronave na sua base
               // e desenha o modelo/icone certo. O F4N do JSBSim e um
               // F-4 Phantom II -- "F-4E" e a designacao mais comum na base.
               modelMap: { falcon1: "F-4E"  falcon2: "F-4E"  falcon3: "F-4E"
                           falcon4: "F-4E"  bandit1: "F-4E" }

               typeMap:  { falcon1: "Air+FixedWing"  falcon2: "Air+FixedWing"
                           falcon3: "Air+FixedWing"  falcon4: "Air+FixedWing"
                           bandit1: "Air+FixedWing" }
               colorMap: { falcon1: "Blue"  falcon2: "Blue"  falcon3: "Blue"
                           falcon4: "Blue"  bandit1: "Red" }
            )
         }
      )
   )

   simulation: ( WorldModel

      // Slot de simulation::Simulation, nao da Station (armadilha do CLAUDE.md)
      numTcThreads: @NUM_TC_THREADS@

      latitude:  36.00
      longitude: -115.00

      players: {

         // ------------------------------------------------------------
         // 4 cacas azuis. Pilha completa:
         //   autopilot   FlightDirector      (fase 0, ANTES do modelo)
         //   flightModel JsbsimFlightModel   (fase 0, 6-DOF via JSBSim)
         //   sensor      ProximitySensor     (fase 2)
         //   radio       AlertRadio          (fase 1 transmite / fase 2 recebe)
         //   pilot       FlightAgent         (fase 3, UBF + arvore)
         //
         // A ORDEM de 'autopilot' antes de 'flightModel' importa: os dois
         // rodam na fase 0 e a lista de componentes e percorrida na ordem
         // declarada, entao as deflexoes deste frame ja entram na
         // integracao deste frame.
         // ------------------------------------------------------------

         falcon1: ( Airplane
            id: 101
            side: blue
            type: "F4N"

            initXPos:     ( NauticalMiles 10.0 )
            initYPos:     ( NauticalMiles  0.0 )
            initAlt:      ( Meters 4000.0 )
            initHeading:  ( Degrees 90 )
            initVelocity: 180.0                  // ~350 kts em m/s

            dataLogTime: ( Seconds 0.1 )         // 10 Hz -- nasce ZERO

            components: {

               autopilot: ( FlightDirector
                  maxBank:       ( Degrees 55 )
                  maxPitch:      ( Degrees 12 )
                  bankPerDegErr: 2.0
                  pitchPerMeter: 0.01
                  rollGain:      0.020
                  rollRateGain:  0.060
                  pitchGain:     0.040
                  pitchRateGain: 0.150
                  throttleGain:  0.020
               )

               flightModel: ( JsbsimFlightModel
                  rootDir: "./poc/04-jsbsim-6dof/data/jsbsim/"
                  model:   "F4N"
                  trimOnReset: 1
                  subSteps: 4
                  debugLevel: 0
               )

               sensor: ( ProximitySensor
                  maxRange:     ( NauticalMiles 15.0 )
                  fieldOfView:  ( Degrees 60 )
                  scanInterval: ( Seconds 0.5 )
                  holdTime:     ( Seconds 8 )
                  hostileOnly:  1
               )

               radio: ( AlertRadio
                  range:    ( NauticalMiles 80.0 )
                  holdTime: ( Seconds 20 )
               )

               pilot: ( FlightAgent
                  state: ( FlightState )

                  // UbfArbiter e do FRAMEWORK: escolhe a acao de maior voto
                  // entre os comportamentos filhos.
                  behavior: ( UbfArbiter
                     behaviors: {

                        ( AltitudeSafetyBehavior
                           vote: 90
                           minAltitude:     ( Meters 2500 )
                           recoverAltitude: ( Meters 4000 )
                           recoverSpeed:    380.0
                        )

                        ( BtBehavior
                           vote: 50
                           treeFile: "./poc/12-jsbsim-ubf/configs/flight_tree.xml"
                           patrolHeading:  ( Degrees 90 )
                           legTime:        ( Seconds 60 )
                           legTurn:        ( Degrees 90 )
                           patrolAltitude: ( Meters 4000 )
                           patrolSpeed:    350.0
                           rtbAltitude:    ( Meters 3000 )
                           rtbSpeed:       400.0
                           arrivalRadius:  ( NauticalMiles 3.0 )
                           fuelReserve:    0.35
                           breakTurn:      ( Degrees 110 )
                           evadeClimb:     ( Meters 600 )
                           evadeSpeed:     450.0
                           supportSpeed:   420.0
                        )
                     }
                  )
               )
            }
         )

         falcon2: ( Airplane
            id: 102
            side: blue
            type: "F4N"
            initXPos:     ( NauticalMiles  0.0 )
            initYPos:     ( NauticalMiles 10.0 )
            initAlt:      ( Meters 4600.0 )
            initHeading:  ( Degrees 180 )
            initVelocity: 180.0
            dataLogTime: ( Seconds 0.1 )
            components: {
               autopilot: ( FlightDirector
                  maxBank: ( Degrees 55 )  maxPitch: ( Degrees 12 )
                  bankPerDegErr: 2.0  pitchPerMeter: 0.01
                  rollGain: 0.020  rollRateGain: 0.060
                  pitchGain: 0.040  pitchRateGain: 0.150  throttleGain: 0.020
               )
               flightModel: ( JsbsimFlightModel
                  rootDir: "./poc/04-jsbsim-6dof/data/jsbsim/"
                  model: "F4N"  trimOnReset: 1  subSteps: 4  debugLevel: 0
               )
               sensor: ( ProximitySensor
                  maxRange: ( NauticalMiles 15.0 )  fieldOfView: ( Degrees 60 )
                  scanInterval: ( Seconds 0.5 )  holdTime: ( Seconds 8 )  hostileOnly: 1
               )
               radio: ( AlertRadio range: ( NauticalMiles 80.0 )  holdTime: ( Seconds 20 ) )
               pilot: ( FlightAgent
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 2500 )  recoverAltitude: ( Meters 4600 )
                           recoverSpeed: 380.0
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./poc/12-jsbsim-ubf/configs/flight_tree.xml"
                           patrolHeading: ( Degrees 180 )  legTime: ( Seconds 60 )
                           legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 4600 )
                           patrolSpeed: 350.0  rtbAltitude: ( Meters 3200 )  rtbSpeed: 400.0
                           arrivalRadius: ( NauticalMiles 3.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 600 )
                           evadeSpeed: 450.0  supportSpeed: 420.0
                        )
                     }
                  )
               )
            }
         )

         falcon3: ( Airplane
            id: 103
            side: blue
            type: "F4N"
            initXPos:     ( NauticalMiles -10.0 )
            initYPos:     ( NauticalMiles   0.0 )
            initAlt:      ( Meters 5200.0 )
            initHeading:  ( Degrees 270 )
            initVelocity: 180.0
            dataLogTime: ( Seconds 0.1 )
            components: {
               autopilot: ( FlightDirector
                  maxBank: ( Degrees 55 )  maxPitch: ( Degrees 12 )
                  bankPerDegErr: 2.0  pitchPerMeter: 0.01
                  rollGain: 0.020  rollRateGain: 0.060
                  pitchGain: 0.040  pitchRateGain: 0.150  throttleGain: 0.020
               )
               flightModel: ( JsbsimFlightModel
                  rootDir: "./poc/04-jsbsim-6dof/data/jsbsim/"
                  model: "F4N"  trimOnReset: 1  subSteps: 4  debugLevel: 0
               )
               sensor: ( ProximitySensor
                  maxRange: ( NauticalMiles 15.0 )  fieldOfView: ( Degrees 60 )
                  scanInterval: ( Seconds 0.5 )  holdTime: ( Seconds 8 )  hostileOnly: 1
               )
               radio: ( AlertRadio range: ( NauticalMiles 80.0 )  holdTime: ( Seconds 20 ) )
               pilot: ( FlightAgent
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 2500 )  recoverAltitude: ( Meters 5200 )
                           recoverSpeed: 380.0
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./poc/12-jsbsim-ubf/configs/flight_tree.xml"
                           patrolHeading: ( Degrees 270 )  legTime: ( Seconds 45 )
                           legTurn: ( Degrees 120 )  patrolAltitude: ( Meters 5200 )
                           patrolSpeed: 360.0  rtbAltitude: ( Meters 3400 )  rtbSpeed: 400.0
                           arrivalRadius: ( NauticalMiles 3.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 130 )  evadeClimb: ( Meters 700 )
                           evadeSpeed: 460.0  supportSpeed: 430.0
                        )
                     }
                  )
               )
            }
         )

         falcon4: ( Airplane
            id: 104
            side: blue
            type: "F4N"
            initXPos:     ( NauticalMiles  0.0 )
            initYPos:     ( NauticalMiles -10.0 )
            initAlt:      ( Meters 5800.0 )
            initHeading:  ( Degrees 0 )
            initVelocity: 180.0
            dataLogTime: ( Seconds 0.1 )
            components: {
               autopilot: ( FlightDirector
                  maxBank: ( Degrees 55 )  maxPitch: ( Degrees 12 )
                  bankPerDegErr: 2.0  pitchPerMeter: 0.01
                  rollGain: 0.020  rollRateGain: 0.060
                  pitchGain: 0.040  pitchRateGain: 0.150  throttleGain: 0.020
               )
               flightModel: ( JsbsimFlightModel
                  rootDir: "./poc/04-jsbsim-6dof/data/jsbsim/"
                  model: "F4N"  trimOnReset: 1  subSteps: 4  debugLevel: 0
               )
               sensor: ( ProximitySensor
                  maxRange: ( NauticalMiles 15.0 )  fieldOfView: ( Degrees 60 )
                  scanInterval: ( Seconds 0.5 )  holdTime: ( Seconds 8 )  hostileOnly: 1
               )
               radio: ( AlertRadio range: ( NauticalMiles 80.0 )  holdTime: ( Seconds 20 ) )
               pilot: ( FlightAgent
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 2500 )  recoverAltitude: ( Meters 5800 )
                           recoverSpeed: 380.0
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./poc/12-jsbsim-ubf/configs/flight_tree.xml"
                           patrolHeading: ( Degrees 0 )  legTime: ( Seconds 60 )
                           legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 5800 )
                           patrolSpeed: 350.0  rtbAltitude: ( Meters 3600 )  rtbSpeed: 400.0
                           arrivalRadius: ( NauticalMiles 3.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 600 )
                           evadeSpeed: 450.0  supportSpeed: 420.0
                        )
                     }
                  )
               )
            }
         )

         // ------------------------------------------------------------
         // Intruso: MESMA classe e MESMO 6-DOF, sem sensor, sem radio e
         // sem agente. Sem comando da UBF, o FlightDirector mantem o
         // estado inicial (rumo/altitude/velocidade do .epp) -- ou seja,
         // voa reto e nivelado. Serve para mostrar que os subsistemas sao
         // opcionais e para dar aos cacas algo que detectar.
         // ------------------------------------------------------------
         bandit1: ( Airplane
            id: 201
            side: red
            type: "F4N"
            initXPos:     ( NauticalMiles 18.0 )
            initYPos:     ( NauticalMiles 18.0 )
            initAlt:      ( Meters 4300.0 )
            initHeading:  ( Degrees 225 )
            initVelocity: 231.0                  // ~450 kts
            dataLogTime: ( Seconds 0.1 )
            components: {
               autopilot: ( FlightDirector
                  maxBank: ( Degrees 45 )  maxPitch: ( Degrees 10 )
                  bankPerDegErr: 1.5  pitchPerMeter: 0.01
                  rollGain: 0.020  rollRateGain: 0.060
                  pitchGain: 0.040  pitchRateGain: 0.150  throttleGain: 0.020
               )
               flightModel: ( JsbsimFlightModel
                  rootDir: "./poc/04-jsbsim-6dof/data/jsbsim/"
                  model: "F4N"  trimOnReset: 1  subSteps: 4  debugLevel: 0
               )
            }
         )

      } // players

   ) // simulation

) // station
