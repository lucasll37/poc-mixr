//
// Subprojeto 13 - single-thread
//
// MESMO cenario da poc/12 (4 avioes patrulhando + 1 intruso; quem detecta
// avisa os outros, que vao apoiar), mas com a regra invertida: aqui se
// HERDA/REAPROVEITA o maximo possivel do MIXR. Compare os dois .epp lado a
// lado -- e a forma mais rapida de ver o que o framework ja entrega:
//
//   peca            poc/12 (do zero)                 poc/single-thread (nativo)
//   --------------  -------------------------------  ----------------------------
//   player          xair::Airplane   : Player        ( Aircraft )
//   dinamica 6-DOF  xair::JsbsimFlightModel : System ( JSBSimModel )
//   controle        xair::FlightDirector : System    ( Autopilot )
//   sensor          xair::ProximitySensor : System   ( Gimbal/Antenna + Tws + AirTrkMgr )
//   interacao       xair::AlertRadio : System        ( AlertDatalink : models::Datalink )
//   agente UBF      xair::FlightAgent : AgentTC      ( SimAgent )
//   arbitro         ( UbfArbiter )                   ( UbfArbiter )      [igual]
//   percepcao/      xair::FlightState/FlightAction/  idem (o UBF nao tem State/
//   decisao/acao    BtBehavior                       Behavior/Action prontos)
//
// AERONAVE: c310 (Cessna 310), e NAO o F4N das pocs 04/12. O motivo e
// concreto: o JSBSimModel nativo comanda a aeronave escrevendo em
// 'ap/heading_hold', 'ap/altitude_hold' e 'ap/airspeed_hold' (confirmado
// com `strings libmixr_models.so`), propriedades que so existem se o
// MODELO JSBSim tiver um autopilot proprio. O F4N nao tem -- e por isso
// que as pocs 04/05/12 precisaram de controle escrito a mao. O c310 tem
// (<autopilot file="c310ap">), entao a cadeia Autopilot -> JSBSimModel ->
// superficies funciona sem uma linha de lei de controle nossa.
//
// @NUM_TC_THREADS@ e substituido pelo main.cpp antes do parse.
//

( ClockStation

   tcPriority: 0.5

   ownship: falcon1

   // --------------------------------------------------------------------
   // Agentes do UBF: aqui eles moram na STATION e amarram o ator por NOME
   // (actorPlayerName), que e como o models::SimAgent nativo funciona.
   // Na poc/12 o agente era um componente DENTRO do player (porque era o
   // nosso AgentTC). Consequencia real desta escolha: SimAgent deriva de
   // ubf::Agent, cujo ciclo roda em updateData() -- ou seja, a decisao
   // acontece na thread de BACKGROUND, na taxa do laco do main.cpp, e nao
   // na fase 3 do frame de tempo critico.
   // --------------------------------------------------------------------
   components: {

      agent1: ( SimAgent
         actorPlayerName: falcon1
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior
                  vote: 90
                  // DOIS PISOS. O absoluto (minAltitude) nao sabe onde esta
                  // o chao: sobre esta serra, 1200 m MSL fica DENTRO da
                  // montanha. Ele fica so como rede para quando nao ha
                  // elevacao; quem manda aqui e o piso AGL abaixo.
                  minAltitude:      ( Meters 1200 )
                  recoverAltitude:  ( Meters 1750 )
                  recoverSpeed:     160.0
                  // minClearance TEM de ficar abaixo do terrainClearance do
                  // BtBehavior (800), senao este comportamento (voto 90)
                  // briga com o piso de evasao da arvore (voto 50).
                  minClearance:     ( Meters 400 )
                  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior
                  vote: 50
                  treeFile: "./src/single-thread/configs/flight_tree.xml"
                  patrolHeading:  ( Degrees 90 )
                  legTime:        ( Seconds 60 )
                  legTurn:        ( Degrees 90 )
                  patrolAltitude: ( Meters 1750 )
                  patrolSpeed:    160.0
                  rtbAltitude:    ( Meters 2050 )
                  rtbSpeed:       170.0
                  arrivalRadius:  ( NauticalMiles 2.0 )
                  fuelReserve:    0.35
                  breakTurn:      ( Degrees 110 )
                  evadeClimb:     ( Meters 700 )
                  evadeSpeed:     185.0
                  // PISO ANTI-CFIT. O desconflito vertical da evasao desce
                  // 700 m a partir da altitude atual; com ~940 m de AGL de
                  // cruzeiro isso levaria a aeronave para ~240 m do chao. O
                  // alvo e entao levantado para terreno+800. 0 desliga a
                  // camada de terreno e devolve o piso absoluto de 200 m --
                  // e o controle negativo, sem recompilar.
                  terrainClearance: ( Meters 800 )
                  // Histerese da evasao: por quanto tempo a manobra continua
                  // valendo DEPOIS de a pista sumir. Precisa cobrir o intervalo
                  // entre perder o contato (a propria quebra tira o intruso do
                  // setor do radar) e o ramo de apoio querer assumir -- sem
                  // isso os dois alternam e a aeronave voa "batendo asa".
                  evadeHold:      ( Seconds 30 )
                  supportSpeed:   180.0
               )
            }
         )
      )

      agent2: ( SimAgent
         actorPlayerName: falcon2
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior vote: 90
                  minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 1850 )
                  recoverSpeed: 160.0
                  minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior vote: 50
                  treeFile: "./src/single-thread/configs/flight_tree.xml"
                  patrolHeading: ( Degrees 180 )  legTime: ( Seconds 60 )
                  legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 1850 )
                  patrolSpeed: 160.0  rtbAltitude: ( Meters 2100 )  rtbSpeed: 170.0
                  arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                  breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                  evadeSpeed: 185.0  supportSpeed: 180.0
                  evadeHold: ( Seconds 30 )
                  terrainClearance: ( Meters 800 )
               )
            }
         )
      )

      agent3: ( SimAgent
         actorPlayerName: falcon3
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior vote: 90
                  minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2050 )
                  recoverSpeed: 160.0
                  minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior vote: 50
                  treeFile: "./src/single-thread/configs/flight_tree.xml"
                  patrolHeading: ( Degrees 270 )  legTime: ( Seconds 45 )
                  legTurn: ( Degrees 120 )  patrolAltitude: ( Meters 2050 )
                  patrolSpeed: 165.0  rtbAltitude: ( Meters 2150 )  rtbSpeed: 170.0
                  arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                  breakTurn: ( Degrees 130 )  evadeClimb: ( Meters 750 )
                  evadeSpeed: 190.0  supportSpeed: 185.0
                  evadeHold: ( Seconds 30 )
                  terrainClearance: ( Meters 800 )
               )
            }
         )
      )

      agent4: ( SimAgent
         actorPlayerName: falcon4
         state: ( FlightState )
         behavior: ( UbfArbiter
            behaviors: {
               ( AltitudeSafetyBehavior vote: 90
                  minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2100 )
                  recoverSpeed: 160.0
                  minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
               )
               ( BtBehavior vote: 50
                  treeFile: "./src/single-thread/configs/flight_tree.xml"
                  patrolHeading: ( Degrees 0 )  legTime: ( Seconds 60 )
                  legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 2100 )
                  patrolSpeed: 160.0  rtbAltitude: ( Meters 2200 )  rtbSpeed: 170.0
                  arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                  breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                  evadeSpeed: 185.0  supportSpeed: 180.0
                  evadeHold: ( Seconds 30 )
                  terrainClearance: ( Meters 800 )
               )
            }
         )
      )

   } // components (agentes)

   // --------------------------------------------------------------------
   // bandit1 (o intruso) NAO mora mais aqui -- ele virou um processo
   // proprio (src/bandit-dis), pilotado por joystick fisico ou pelo
   // Autopilot scripted de fallback, que emite seu estado via DIS NATIVO
   // do MIXR (mixr::dis -- namespace real da lib, apesar do caminho do
   // header ser mixr/interop/dis/; factory names 'DisNetIO'/'DisNtm').
   // Esta Station so RECEBE -- 'enableOutput: false' -- mas 'netOutput:'
   // continua obrigatorio mesmo assim (initNetwork() inicializa os dois
   // handlers incondicionalmente, testado rodando).
   //
   // O 'template:' do DisNtm abaixo basta para o radar
   // (Antenna/Tws/AirTrkMgr) detectar o fantasma exatamente como detectava
   // o bandit1 nativo: interop::NetIO::createIPlayer() clona o template
   // POR INTEIRO -- signature, dataLogTime -- (confirmado lendo
   // NetIO.cpp:639-711 e Player::copyData()/Component::copyData(),
   // Player.cpp:273-404) e poe o clone na MESMA lista que
   // Simulation::getPlayers() devolve -- a mesma que o radar ja varria.
   // 'dynamicsModel'/'pilot' NAO precisam ser reproduzidos aqui: a posicao
   // do fantasma e 100% dead reckoning a partir dos PDUs recebidos, nunca
   // simulacao local -- 'side:' tambem e irrelevante, quem manda e o Force
   // ID do proprio PDU.
   //
   // Esquema de portas (ver o comentario irmao em
   // src/bandit-dis/configs/scenario.epp): todo mundo escuta em 3000;
   // bandit-dis emite da 3001, esta Station da 3002 (so pra manter o
   // padrao -- nao emite nada de verdade, sem outputEntityTypes:),
   // multi-thread da 3003.
   //
   // disEntityType TEM que ser identico ao 'outputEntityTypes:' do
   // bandit-dis -- e como o Ntm casa o PDU recebido com este template.
   // Nao e enumeracao SISO-REF-010 real, so um codigo interno consistente.
   // --------------------------------------------------------------------
   networks: {
      ( DisNetIO
         siteID: 2  applicationID: 1  exerciseID: 1
         enableOutput: false
         netInput:  ( UdpBroadcastHandler localIpAddress: localhost networkMask: "255.0.0.0"
                      port: 3000  ignoreSourcePort: 3002  shared: true )
         netOutput: ( UdpBroadcastHandler localIpAddress: localhost networkMask: "255.0.0.0"
                      port: 3000  localPort: 3002          shared: true )
         inputEntityTypes: {
            ( DisNtm
               template: ( Aircraft type: "C310"
                  signature: ( SigSphere radius: 4.0 )
                  dataLogTime: ( Seconds 0.1 )
               )
               disEntityType: [ 1 2 225 1 99 0 0 ]
            )
         }
      )
   }

   dataRecorder: ( DataRecorder
      eventName: "poc-single-thread"

      // ARMADILHA CONFIRMADA COM AddressSanitizer -- o gravador NATIVO
      // ESTOURA ao gravar uma pista nova:
      //
      //   AirTrkMgr::processTrackList()  (AirTrkMgr.cpp:351)
      //     -> AbstractDataRecorder::recordData(REID_NEW_TRACK)
      //       -> DataRecorder::recordNewTrack()  (DataRecorder.cpp:654)
      //         -> __dynamic_cast  => SEGV
      //
      // Nao e bug desta poc: acontece assim que o radar nativo cria a
      // primeira pista, com o cenario inteiro em classes do framework. E a
      // mesma familia do REID_WEAPON_RELEASED (armadilha 4 do CLAUDE.md), e
      // o contorno e o mesmo da poc/09: habilitar SO os tokens que o
      // TacviewOutput usa, ja que isDataEnabled() e testado ANTES de
      // chamar o handler quebrado.
      //
      //   43 = REID_PLAYER_DATA     42 = REID_PLAYER_REMOVED
      enabledList: [ 43 42 ]
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 1234
               callsign: "poc-mixr/single-thread"
               fileName: "./src/single-thread/data/recordings/mission.acmi"

               // Name= e o MODELO que o Tacview procura na sua base de dados
               // para escolher o icone/modelo 3D (o nome do player vai em
               // CallSign/Pilot -- ver shared/xtacview).
               //
               // NOTA: a DINAMICA aqui e a de um Cessna 310 (a unica com
               // autopilot 'ap/*' entre as aeronaves distribuidas com o
               // JSBSim -- ver o comentario no topo). "F-16C" e portanto uma
               // escolha de APRESENTACAO: o replay desenha um caca, mas as
               // velocidades e as taxas de curva continuam sendo as do c310.
               // Para trocar o icone basta editar esta linha; para trocar a
               // aeronave de verdade seria preciso um modelo JSBSim com
               // autopilot proprio (o f16 distribuido nao tem).
               modelMap: { falcon1: "F-16C"  falcon2: "F-16C"  falcon3: "F-16C"
                           falcon4: "F-16C"  bandit1: "F-16C" }
               typeMap:  { falcon1: "Air+FixedWing"  falcon2: "Air+FixedWing"
                           falcon3: "Air+FixedWing"  falcon4: "Air+FixedWing"
                           bandit1: "Air+FixedWing" }
               colorMap: { falcon1: "Blue"  falcon2: "Blue"  falcon3: "Blue"
                           falcon4: "Blue"  bandit1: "Red" }
            )
         }
      )
   )

   simulation: ( WorldModel

      numTcThreads: @NUM_TC_THREADS@

      // Serra do Mar / regiao de Nova Friburgo (RJ). A referencia esta no
      // MIOLO da celula S23W043 (lat -23..-22, lon -43..-42): com os players
      // espalhados +-12 NM, a borda mais proxima do tile fica a 4,8 km. Isso
      // nao e detalhe -- FORA da celula o Player::updateElevation() nativo
      // grava elevacao 0.0 com o flag de validade LIGADO (ele ignora o
      // retorno de getElevation()), e a decisao passa a raciocinar sobre um
      // mundo ao nivel do mar sem nenhum aviso. Ver CLAUDE.md.
      latitude:  -22.25
      longitude: -42.48

      // Banco de elevacao. Os slots sao 'path' e 'file' -- NAO 'pathname'/
      // 'filename', que e como se chamam os setters. Nome errado da
      // "slot not found" e o tile simplesmente nao carrega.
      //
      // O .hgt e artefato gerado: o que fica versionado e o .hgt.gz, que o
      // app/TerrainData descomprime na primeira execucao (o SrtmHgtFile abre
      // um ifstream cru, nao entende .gz).
      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         // ------------------------------------------------------------
         // 4 avioes azuis -- TODOS os componentes sao classes do
         // framework, com a unica excecao do datalink (que herda de
         // models::Datalink so para decidir o que fazer com a mensagem).
         // ------------------------------------------------------------

         falcon1: ( Aircraft
            id: 101
            side: blue
            type: "C310"

            // RCS: e dela que o radar dos OUTROS calcula a deteccao
            signature: ( SigSphere radius: 3.0 )

            initXPos:     ( NauticalMiles 5.0 )
            initYPos:     ( NauticalMiles 0.0 )
            // REGRA DAS ALTITUDES: pico do proprio circuito de patrulha + 300 m,
            // arredondado para cima em 50 m. Nao e estetica -- e o que mantem a
            // aeronave fora do CRASH_EVENT nativo (Player.cpp:2811 dispara com
            // AGL < 0 e crashNotification() poe o player em CRASHED, congelando-o).
            // Antes do terreno isso era letra morta, porque tElev era sempre 0.
            // falcon1: pico 1435 m -> 1750 m (AGL tipico ~940 m).
            initAlt:      ( Meters 1750.0 )
            initHeading:  ( Degrees 90 )
            initVelocity: 82.0                   // ~160 kts

            dataLogTime: ( Seconds 0.1 )

            // Interpolacao bilinear entre os posts de 30 m do SRTM1 -- sem
            // isso a elevacao vem em degraus e o piso anti-CFIT tambem.
            // NAO declarar 'terrainElevReq': com ele em true o
            // updateElevation() PULA a consulta ao banco e fica esperando um
            // gerador de imagem externo empurrar o valor.
            interpolateTerrain: true

            components: {

               // 6-DOF nativo: o mesmo JSBSim, agora pelo adaptador do
               // framework (compare com xair::JsbsimFlightModel da poc/12).
               dynamicsModel: ( JSBSimModel
                  rootDir: "./src/single-thread/data/jsbsim/"
                  model:   "c310"
                  debugLevel: 0
               )

               // Piloto automatico NATIVO: substitui inteiramente o
               // xair::FlightDirector (leis de controle, limites e
               // conversao para as superficies).
               pilot: ( Autopilot
                  navMode: false
                  headingHoldMode:  true
                  altitudeHoldMode: true
                  velocityHoldMode: true
                  maxRateOfTurnDps: 3.0
                  maxBankAngle:    30.0
                  maxPitchAngle:   10.0
                  maxClimbRateMps:  8.0
                  maxAcceleration:  2.0
               )

               // Datalink NATIVO (subclasse minima): transporte, alcance,
               // fila de entrada e evento vem todos da classe base.
               datalink: ( AlertDatalink
                  holdTime: ( Seconds 25 )
               )

               // Radar de busca 100% nativo -- mesma cadeia das pocs 06/07.
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal
                        gain: ( dB 42 )

                        // Padrao de ganho embutido (nas pocs 06/07 vinha de
                        // um #include, que exige passo de preprocessador C).
                        gainPattern:
                        ( Func1
                           table: ( Table1
                              x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                              data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ]
                           )
                        )
                        gainPatternDeg: false

                        initPosition: [ 0 0 ]
                        maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth:   ( Degrees 60 )
                        commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]
                        searchVolume: [ 1.0472 0.05 ]
                        numBars: 2

                        maxPlayersOfInterest: 8
                        playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false
                        useWorldCoordinates: false
                     )
                  }
               )

               sensors: ( SensorMgr
                  components: {
                     ( Tws
                        trackManagerName: twsTrkMgr
                        antennaName: radar
                        powerPeak:  ( KiloWatts 200.0 )
                        frequency:  ( GigaHertz 3.0 )
                        bandwidth:  ( GigaHertz 2.0 )
                        PRF:        ( Hertz 500.0 )
                        pulseWidth: ( MilliSeconds 0.01 )
                        threshold:  ( dB 0.0 )
                        igain: ( dB 0 )
                        ranges:     [ 10 20 40 80 ]
                        initRangeIdx: 2
                     )
                  }
               )

               obc: ( OnboardComputer
                  components: {
                     twsTrkMgr: ( AirTrkMgr
                        maxTracks: 20
                        alpha: 1.0
                        beta:  0.5
                        gamma: 0.0
                        positionGate: 1500
                        rangeGate:     500
                        velocityGate:   10
                        firstTrackId: 1000
                     )
                  }
               )
            }
         )

         falcon2: ( Aircraft
            id: 102
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 0.0 )
            initYPos:     ( NauticalMiles 5.0 )
            initAlt:      ( Meters 1850.0 )     // pico do circuito 1529 m + 300
            initHeading:  ( Degrees 180 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./src/single-thread/data/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
            }
         )

         falcon3: ( Aircraft
            id: 103
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles -5.0 )
            initYPos:     ( NauticalMiles  0.0 )
            initAlt:      ( Meters 2050.0 )     // pico do circuito 1738 m + 300
            initHeading:  ( Degrees 270 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./src/single-thread/data/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.5  maxBankAngle: 33.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
            }
         )

         falcon4: ( Aircraft
            id: 104
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles  0.0 )
            initYPos:     ( NauticalMiles -5.0 )
            initAlt:      ( Meters 2100.0 )     // pico do circuito 1709 m + 300
            initHeading:  ( Degrees 0 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./src/single-thread/data/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
            }
         )

         // Intruso: nao mora mais aqui -- virou o processo src/bandit-dis,
         // recebido so pela rede via 'networks:' (ver o comentario logo
         // acima de 'dataRecorder:'). Mesma aeronave, mesmos valores
         // iniciais -- so mudou ONDE ele roda.

      } // players

   ) // simulation

) // station
