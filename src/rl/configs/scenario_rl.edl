//
// rl -- cenario para o wrapper Gymnasium (src/rl/python/mixr_gym).
//
// Derivado de app/configs/scenario_patrol.edl.in (mesma pilha 100% nativa:
// Aircraft/JSBSimModel/Autopilot/radar/AlertDatalink/FlightAgentTC, o mesmo
// plugin libflight_tc.so), com o delta:
//
//   1) falcon1 troca ( BtBehavior ... ) por ( RLBridgeBehavior vote: 50 )
//      dentro do MESMO UbfArbiter -- o piso de seguranca nativo
//      ( AltitudeSafetyBehavior, vote: 90 ) continua protegendo mesmo
//      quando o agente RL manda um comando ruim (ver CLAUDE.md, secao
//      AltitudeSafetyBehavior).
//   2) falcon2..4 continuam com BtBehavior nativo -- trafego/companheiros
//      de cenario, nao controlados pelo agente RL (ver "Escopo" do plano
//      de implementacao: v1 e single-agent).
//   3) ( Station ) no lugar de ( ClockStation ) -- este host nunca roda em
//      tempo real, NativeSimulation::step() chama tcFrame()/updateData()
//      direto, sem pool de tempo critico com pacing nem teclado.
//   4) SEM 'networks:' -- hermetico, mesmo motivo de
//      tests/scenario/make_fixture.py (nao competir por porta/trafego com
//      outra sessao).
//   5) Porta de Tacview PROPRIA (1237) e dataRecorder/data/ apontando pra
//      ./src/rl/, pra poder rodar ao lado de single-thread/multi-thread/app
//      (portas 1234/1236) sem colidir -- opcional, so para acompanhar
//      visualmente um episodio; NativeSimulation nunca le o TacviewOutput
//      de volta.
//   6) numTcThreads FIXO em 1 -- nao ha argv aqui (chamado de Python via
//      pybind11, nao por linha de comando), e um agente RL nao precisa do
//      pool de threads para ir rapido; so precisa ser DETERMINISTICO.
//
( Station

   ownship: falcon1

   components: {

      plugins: ( PluginLoader
         searchPaths: {
            "./dist/lib/mixr-plugins/"
         }
         modules: {
            ( PluginModule
               file:     "libflight_tc.so"
               provides: { AlertDatalink TacticalAlert FlightAgentTC FlightState
                           BtBehavior AltitudeSafetyBehavior RLBridgeBehavior
                           FlightAction }
            )
         }
      )

   } // components (plugins)

   dataRecorder: ( ExposedDataRecorder
      eventName: "rl"
      enabledList: [ 43 42 ]
      outputHandler: ( RecorderOutputHandler
         components: {
            ( TacviewOutput
               port: 1237
               callsign: "poc-mixr/rl"
               fileName: "./src/rl/data/recordings/mission.acmi"
               modelMap: { falcon1: "F-16C"  falcon2: "F-16C"
                           falcon3: "F-16C"  falcon4: "F-16C" }
               typeMap:  { falcon1: "Air+FixedWing"  falcon2: "Air+FixedWing"
                           falcon3: "Air+FixedWing"  falcon4: "Air+FixedWing" }
               colorMap: { falcon1: "Blue"  falcon2: "Blue"
                           falcon3: "Blue"  falcon4: "Blue" }
            )
         }
      )
   )

   simulation: ( WorldModel

      numTcThreads: 1

      // Serra do Mar / regiao de Nova Friburgo (RJ) -- mesma referencia das
      // demais pocs, ver CLAUDE.md.
      latitude:  -22.25
      longitude: -42.48

      terrain: ( SrtmHgtFile
         path: "./shared/data/terrain/srtm/"
         file: "S23W043.hgt"
      )

      players: {

         falcon1: ( Aircraft
            id: 101
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 5.0 )
            initYPos:     ( NauticalMiles 0.0 )
            initAlt:      ( Meters 1750.0 )
            initHeading:  ( Degrees 90 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior
                           vote: 90
                           minAltitude:      ( Meters 1200 )
                           recoverAltitude:  ( Meters 1750 )
                           recoverSpeed:     160.0
                           minClearance:     ( Meters 400 )
                           recoverClearance: ( Meters 800 )
                        )
                        // Decisao vem de fora (Python), via shared/xrlbridge --
                        // ver models/flight/include/ubf/RLBridgeBehavior.hpp.
                        ( RLBridgeBehavior vote: 50 )
                     }
                  )
               )
            }
         )

         falcon2: ( Aircraft
            id: 102
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles 0.0 )
            initYPos:     ( NauticalMiles 5.0 )
            initAlt:      ( Meters 1850.0 )
            initHeading:  ( Degrees 180 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 1850 )
                           recoverSpeed: 160.0
                           minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading: ( Degrees 180 )  legTime: ( Seconds 60 )
                           legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 1850 )
                           patrolSpeed: 160.0  rtbAltitude: ( Meters 2100 )  rtbSpeed: 170.0
                           arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                           evadeSpeed: 185.0  supportSpeed: 180.0
                           evadeHold: ( Seconds 30 )
                           terrainClearance: ( Meters 800 )
                        )
                     }
                  )
               )
            }
         )

         falcon3: ( Aircraft
            id: 103
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles -5.0 )
            initYPos:     ( NauticalMiles  0.0 )
            initAlt:      ( Meters 2050.0 )
            initHeading:  ( Degrees 270 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.5  maxBankAngle: 33.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2050 )
                           recoverSpeed: 160.0
                           minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading: ( Degrees 270 )  legTime: ( Seconds 45 )
                           legTurn: ( Degrees 120 )  patrolAltitude: ( Meters 2050 )
                           patrolSpeed: 165.0  rtbAltitude: ( Meters 2150 )  rtbSpeed: 170.0
                           arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 130 )  evadeClimb: ( Meters 750 )
                           evadeSpeed: 190.0  supportSpeed: 185.0
                           evadeHold: ( Seconds 30 )
                           terrainClearance: ( Meters 800 )
                        )
                     }
                  )
               )
            }
         )

         falcon4: ( Aircraft
            id: 104
            side: blue
            type: "C310"
            signature: ( SigSphere radius: 3.0 )
            initXPos:     ( NauticalMiles  0.0 )
            initYPos:     ( NauticalMiles -5.0 )
            initAlt:      ( Meters 2100.0 )
            initHeading:  ( Degrees 0 )
            initVelocity: 82.0
            dataLogTime: ( Seconds 0.1 )
            interpolateTerrain: true
            components: {
               dynamicsModel: ( JSBSimModel
                  rootDir: "./dist/share/mixr-plugins/flight/jsbsim/"  model: "c310"  debugLevel: 0
               )
               pilot: ( Autopilot
                  navMode: false  headingHoldMode: true  altitudeHoldMode: true
                  velocityHoldMode: true  maxRateOfTurnDps: 3.0  maxBankAngle: 30.0
                  maxPitchAngle: 10.0  maxClimbRateMps: 8.0  maxAcceleration: 2.0
               )
               datalink: ( AlertDatalink holdTime: ( Seconds 25 ) )
               antennas: ( Gimbal
                  components: {
                     radar: ( Antenna
                        polarization: horizontal  gain: ( dB 42 )
                        gainPattern: ( Func1 table: ( Table1
                           x:    [ 0.0   0.01745  0.02618   0.04363   0.05236   0.061087  0.06981   0.07854 ]
                           data: [ 0.0  -3.0    -10.0     -30.0     -20.0     -14.0     -25.0     -80.0 ] ) )
                        gainPatternDeg: false
                        initPosition: [ 0 0 ]  maxRates: [ 0.8727 0.8727 ]
                        commandRateAzimuth: ( Degrees 60 )  commandRateElevation: ( Degrees 60 )
                        reference: [ 0 0 ]  searchVolume: [ 1.0472 0.05 ]  numBars: 2
                        maxPlayersOfInterest: 8  playerOfInterestTypes: { air }
                        maxRange2PlayersOfInterest: ( NauticalMiles 40.0 )
                        maxAngle2PlayersOfInterest: ( Degrees 60.0 )
                        localPlayersOfInterestOnly: false  useWorldCoordinates: false
                     )
                  }
               )
               sensors: ( SensorMgr components: { ( Tws
                  trackManagerName: twsTrkMgr  antennaName: radar
                  powerPeak: ( KiloWatts 200.0 )  frequency: ( GigaHertz 3.0 )
                  bandwidth: ( GigaHertz 2.0 )  PRF: ( Hertz 500.0 )
                  pulseWidth: ( MilliSeconds 0.01 )  threshold: ( dB 0.0 )  igain: ( dB 0 )
                  ranges: [ 10 20 40 80 ]  initRangeIdx: 2 ) } )
               obc: ( OnboardComputer components: { twsTrkMgr: ( AirTrkMgr
                  maxTracks: 20  alpha: 1.0  beta: 0.5  gamma: 0.0
                  positionGate: 1500  rangeGate: 500  velocityGate: 10  firstTrackId: 1000 ) } )
               agent: ( FlightAgentTC
                  state: ( FlightState )
                  behavior: ( UbfArbiter
                     behaviors: {
                        ( AltitudeSafetyBehavior vote: 90
                           minAltitude: ( Meters 1200 )  recoverAltitude: ( Meters 2100 )
                           recoverSpeed: 160.0
                           minClearance: ( Meters 400 )  recoverClearance: ( Meters 800 )
                        )
                        ( BtBehavior vote: 50
                           treeFile: "./dist/share/mixr-plugins/flight/flight_tree.xml"
                           patrolHeading: ( Degrees 0 )  legTime: ( Seconds 60 )
                           legTurn: ( Degrees 90 )  patrolAltitude: ( Meters 2100 )
                           patrolSpeed: 160.0  rtbAltitude: ( Meters 2200 )  rtbSpeed: 170.0
                           arrivalRadius: ( NauticalMiles 2.0 )  fuelReserve: 0.35
                           breakTurn: ( Degrees 110 )  evadeClimb: ( Meters 700 )
                           evadeSpeed: 185.0  supportSpeed: 180.0
                           evadeHold: ( Seconds 30 )
                           terrainClearance: ( Meters 800 )
                        )
                     }
                  )
               )
            }
         )

      } // players

   ) // simulation

) // station
